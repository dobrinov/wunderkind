<%# Starting a league: a name, and which friends to bring in. Anybody else
    joins later with the code shown on the league's page. %>
<div class="mx-auto flex max-w-xl flex-col gap-5">
  <div class="flex items-center gap-2">
    <%= link_to leaderboard_path(anchor: "leagues"), class: "button button-quiet button-icon", title: t("leagues.back") do %>
      <%= render "shared/icon", name: :back, size: 22, label: t("leagues.back") %>
    <% end %>
    <h1 class="min-w-0 truncate text-page font-black tracking-[-.02em] max-sm:text-2xl"><%= t("leagues.new") %></h1>
  </div>

  <%= form_with model: @league, url: leagues_path, class: "flex flex-col gap-5" do |f| %>
    <% if @league.errors.any? %>
      <div class="alert-danger"><div><div><p><%= @league.errors.full_messages.join(", ") %></p></div></div></div>
    <% end %>

    <div class="card">
      <section class="flex flex-col gap-2">
        <%= f.label :name, t("leagues.name"), class: "text-ui font-black" %>
        <%# The global field rule — 16px and 44px — rather than a size of its
            own: under 16px Safari zooms the page on the tap. %>
        <%= f.text_field :name, maxlength: League::NAME_LENGTH, required: true, placeholder: t("leagues.name_placeholder") %>
      </section>
    </div>

    <div class="card">
      <header class="text-ui font-black"><%= t("leagues.add_friends") %></header>
      <section>
        <% if @friends.empty? %>
          <p class="text-sm font-bold text-ink-600"><%= t("leagues.no_friends") %></p>
        <% else %>
          <ul class="flex flex-col">
            <% @friends.each do |friend| %>
              <li class="flex min-h-12 items-center gap-3 border-t border-ink-100 py-1 first:border-t-0">
                <% if friend.may_join_leagues? %>
                  <%= check_box_tag "league[friend_ids][]", friend.id, true, id: "friend_#{friend.id}", class: "size-5 accent-primary-600" %>
                  <%# The label is the hit area: a whole row for a finger, not the 20px box. %>
                  <%= label_tag "friend_#{friend.id}", friend.short_name, class: "flex min-h-11 flex-1 cursor-pointer items-center text-ui font-black" %>
                <% else %>
                  <span class="size-5"></span>
                  <span class="flex-1">
                    <span class="block text-ui font-black text-ink-400"><%= friend.short_name %></span>
                    <span class="block text-meta font-bold text-ink-500"><%= t("leagues.friend_not_allowed") %></span>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>
    </div>

    <p class="text-sm font-bold text-ink-600"><%= t("leagues.code_later") %></p>
    <%= f.submit t("leagues.create"), class: "button button-primary button-large" %>
  <% end %>
</div>

<%# One league's week: who is ahead of you, everybody's points, and the code
    for bringing somebody in. Only members can open it. See Leagues.

    Leaving and deleting sit at the bottom, apart and drawn as what they are:
    „Напусни" an ordinary alternative, „Изтрий" the one destructive outline —
    it used to be a line of grey text, the same weight as „Смени кода". %>
<div class="flex w-full max-w-3xl flex-col gap-5" data-trace-mask>
  <div class="flex items-center gap-2">
    <%= link_to leaderboard_path(anchor: "leagues"), class: "button button-quiet button-icon", title: t("leagues.back") do %>
      <%= render "shared/icon", name: :back, size: 22, label: t("leagues.back") %>
    <% end %>
    <div class="min-w-0">
      <h1 class="truncate text-2xl font-black tracking-[-.02em]"><%= @league.name %></h1>
      <div class="text-meta font-bold text-ink-500">
        <%= t("leagues.members", count: @standings.size) %> · <%= t("leaderboard_page.resets") %>
      </div>
    </div>
  </div>

  <% if @ahead && @me %>
    <div class="rounded-[14px] bg-primary-50 px-4 py-3 text-ui font-bold text-primary-900 ring-1 ring-primary-100">
      <%= t("leagues.chase", points: @ahead.points - @me.points + 1, name: @ahead.user.short_name) %>
    </div>
  <% elsif @me&.rank == 1 && @standings.count(&:rank) > 1 %>
    <div class="rounded-[14px] bg-reward-50 px-4 py-3 text-ui font-bold text-reward-800 ring-1 ring-reward-200">
      <%= t("leagues.leading") %>
    </div>
  <% end %>

  <p class="-mt-2 text-meta font-bold text-ink-600"><%= t("leagues.how") %></p>

  <ol class="duel-list overflow-hidden">
    <%= render partial: "row", collection: @standings, as: :standing, locals: { league: @league } %>
  </ol>

  <section class="rounded-[20px] bg-white p-5 ring-1 ring-ink-150">
    <h2 class="text-lead font-black"><%= t("leagues.invite") %></h2>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <span class="rounded-[14px] bg-primary-50 px-4 py-2 text-page font-black tracking-[.2em] text-primary-900"><%= @league.code %></span>
      <% if @league.owned_by?(current_user) %>
        <%= button_to t("leagues.rotate"), rotate_code_league_path(@league), method: :patch,
                      class: "button button-quiet", data: { turbo_confirm: t("leagues.rotate_confirm") } %>
      <% end %>
    </div>
    <p class="mt-3 text-sm font-bold text-ink-600"><%= t("leagues.invite_hint") %></p>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= button_to t("leagues.leave"), leave_league_path(@league), method: :delete,
                  class: "button button-secondary", data: { turbo_confirm: t("leagues.leave_confirm") } %>
    <% if @league.owned_by?(current_user) %>
      <%= button_to t("leagues.delete"), league_path(@league), method: :delete,
                    class: "button button-danger", data: { turbo_confirm: t("leagues.delete_confirm") } %>
    <% end %>
  </div>

  <p class="text-meta font-bold text-ink-500"><%= t("leagues.privacy") %></p>
</div>

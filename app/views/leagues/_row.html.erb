<%# One member of a league. Ranked if they have points this week; otherwise
    listed without a number, as not having practised yet — see Leagues. %>
<% place = { 1 => "bg-reward-400 text-reward-800", 2 => "bg-ink-200 text-ink-700", 3 => "bg-[#e8b77a] text-[#6b3d10]" }[standing.rank] %>
<% me = standing.user == current_user %>
<li class="flex items-center gap-3 border-t border-ink-100 px-5 py-3 <%= "bg-primary-50" if me %>">
  <span class="grid size-8 shrink-0 place-items-center rounded-full text-[13px] font-black tabular-nums <%= place || "text-ink-500" %>">
    <%= standing.rank || "·" %>
  </span>
  <span class="min-w-0 flex-1">
    <span class="block truncate text-[14.5px] font-black text-ink-900">
      <%= standing.user.short_name %>
      <% if me %><span class="ml-1.5 rounded-full bg-primary-600 px-2 py-0.5 text-[11px] font-black text-white"><%= t("leaderboard_page.you") %></span><% end %>
      <% if league.owned_by?(standing.user) %><span class="ml-1 text-[11.5px] font-bold text-muted"><%= t("leagues.owner") %></span><% end %>
    </span>
    <% unless standing.rank %>
      <span class="block text-[12.5px] font-bold text-muted"><%= t("leagues.not_yet") %></span>
    <% end %>
  </span>
  <% if standing.rank %>
    <span class="shrink-0 text-[14.5px] font-black tabular-nums text-reward-800">⭐ <%= standing.xp %></span>
  <% end %>
  <% if league.owned_by?(current_user) && !me %>
    <%= button_to t("leagues.remove"), remove_member_league_path(league, user_id: standing.user.id), method: :delete,
                  form_class: "shrink-0", class: "text-[12.5px] font-extrabold text-ink-500 hover:underline",
                  data: { turbo_confirm: t("leagues.remove_confirm", name: standing.user.short_name) } %>
  <% end %>
</li>

<%# One member of a league on its own page. Ranked if they have points this
    week; otherwise listed without a number, as not having practised yet —
    see Leagues. The same row as the ranking tab's (leaderboards/_row), plus
    the owner's „Извади", which is a quiet key at the end of the row: it is
    the owner's tool, asked before it acts, and never the row's point. %>
<% place = { 1 => "bg-reward-400 text-reward-800", 2 => "bg-ink-200 text-ink-700", 3 => "bg-[#e8b77a] text-[#6b3d10]" }[standing.rank] %>
<% me = standing.user == current_user %>
<li class="flex min-h-14 items-center gap-3 border-t border-ink-100 py-2 pr-2 pl-4 first:border-t-0 <%= "bg-primary-50" if me %>">
  <span class="grid size-8 shrink-0 place-items-center rounded-full text-sm font-black tabular-nums <%= place || "text-ink-500" %>">
    <%= standing.rank || "·" %>
  </span>
  <span class="min-w-0 flex-1">
    <span class="block truncate text-ui font-extrabold <%= me ? "text-primary-900" : "text-ink-900" %>">
      <%= standing.user.short_name %>
      <% if me %><span class="ml-1 text-meta font-black text-primary-700">(<%= t("leaderboard_page.you") %>)</span><% end %>
      <% if league.owned_by?(standing.user) %><span class="ml-1 text-meta font-bold text-ink-500"><%= t("leagues.owner") %></span><% end %>
    </span>
    <span class="block truncate text-meta font-bold text-ink-500"><%= league_note(standing) %></span>
  </span>
  <% if standing.rank %>
    <span class="shrink-0 pr-2 text-ui font-black tabular-nums text-ink-800"><%= standing.points %> <span class="text-caption font-extrabold text-ink-500"><%= t("leagues.points_unit") %></span></span>
  <% end %>
  <% if league.owned_by?(current_user) && !me %>
    <%= button_to t("leagues.remove"), remove_member_league_path(league, user_id: standing.user.id), method: :delete,
                  form_class: "shrink-0", class: "button button-quiet",
                  data: { turbo_confirm: t("leagues.remove_confirm", name: standing.user.short_name) } %>
  <% end %>
</li>

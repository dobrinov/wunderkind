<div class="page">
  <header>
    <h1>🏆 <%= t("leaderboard_page.title") %></h1>
  </header>

  <main>
    <div class="flex flex-col gap-4 max-w-xl">
      <% if current_user.student? && current_user.nickname.blank? %>
        <div class="alert-info">
          <div><div><p><%= t("leaderboard_page.set_nickname") %> <%= link_to t("nav.profile"), profile_path, class: "font-semibold underline" %></p></div></div>
        </div>
      <% end %>

      <% if @entries.empty? %>
        <div class="alert-info"><div><div><p><%= t("leaderboard_page.empty") %></p></div></div></div>
      <% else %>
        <div class="card">
          <section>
            <ol class="space-y-1.5">
              <% @entries.each do |entry| %>
                <li class="flex items-center gap-3 rounded-lg px-3 py-2 <%= 'bg-primary-50 font-semibold' if entry.user == current_user %>">
                  <span class="w-8 text-right font-extrabold <%= entry.rank <= 3 ? 'text-reward-500 text-lg' : 'text-gray-400' %>">
                    <%= entry.rank <= 3 ? %w[🥇 🥈 🥉][entry.rank - 1] : entry.rank %>
                  </span>
                  <span class="flex-1"><%= entry.user.nickname %><%= " (#{t('leaderboard_page.you')})" if entry.user == current_user %></span>
                  <span class="xp-pill">⭐ <%= entry.xp %></span>
                </li>
              <% end %>
            </ol>
          </section>
        </div>

        <% if @my_entry && @my_entry.rank > @entries.size %>
          <div class="card">
            <section>
              <div class="flex items-center gap-3 rounded-lg px-3 py-2 bg-primary-50 font-semibold">
                <span class="w-8 text-right font-extrabold text-gray-400"><%= @my_entry.rank %></span>
                <span class="flex-1"><%= current_user.nickname %> (<%= t("leaderboard_page.you") %>)</span>
                <span class="xp-pill">⭐ <%= @my_entry.xp %></span>
              </div>
            </section>
          </div>
        <% end %>
      <% end %>
    </div>
  </main>
</div>

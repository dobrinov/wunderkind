<%# The weekly board, as the duel's third tab — see challenges/_tabs. A
    parent or admin can still open it by URL; only a student has the tabs. %>
<div class="mx-auto flex max-w-3xl flex-col gap-5" data-trace-mask>
  <div class="flex flex-wrap items-baseline gap-2.5">
    <h1 class="text-2xl font-black tracking-[-.02em]">
      <%= current_user.student? ? "⚔️ #{t("challenges.title")}" : "🏆 #{t("leaderboard_page.title")}" %>
    </h1>
  </div>

  <% if current_user.student? %>
    <%= render "challenges/tabs", active: :leaderboard %>
    <%= render "scope", active: :all %>
  <% end %>

  <% if current_user.student? && current_user.nickname.blank? %>
    <div class="flex flex-wrap items-center gap-3 rounded-[14px] bg-primary-50 px-4 py-3 ring-1 ring-primary-100">
      <span class="min-w-0 flex-1 text-[13.5px] font-bold text-primary-900"><%= t("leaderboard_page.set_nickname") %></span>
      <%= link_to t("nav.settings"), settings_path, class: "button-edge button-edge-primary px-4 py-2 text-[13.5px]" %>
    </div>
  <% end %>

  <%# Same chrome as the duel's rooms and friends: one card, one row per
      player, nickname only. The top three get a metal disc for the place
      rather than a medal emoji, so the column of numbers stays one column. %>
  <div class="card">
    <header class="flex flex-wrap items-baseline gap-2.5">
      <span class="text-[15px] font-black"><%= t("leaderboard_page.title") %></span>
      <span class="ml-auto text-[13px] font-bold text-muted"><%= t("leaderboard_page.resets") %></span>
    </header>

    <% if @entries.empty? %>
      <section>
        <div class="card-quiet text-center text-sm font-bold text-muted"><%= t("leaderboard_page.empty") %></div>
      </section>
    <% else %>
      <ol>
        <% @entries.each do |entry| %>
          <%= render "row", rank: entry.rank, user: entry.user, xp: entry.xp, me: entry.user == current_user %>
        <% end %>
      </ol>

      <% if @my_entry && @my_entry.rank > @entries.size %>
        <div class="border-t-2 border-dashed border-ink-150">
          <%= render "row", rank: @my_entry.rank, user: current_user, xp: @my_entry.xp, me: true %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

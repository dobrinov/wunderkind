<%# The weekly board, as the duel's third tab — see challenges/_tabs. A
    parent or admin can still open it by URL; only a student has the tabs.

    The board shows its top ten and your own row, with the rest one tap away:
    the leagues below are the part of this tab a child has friends in, and
    fifty strangers' nicknames in front of them put them a long scroll down.
    Nickname only. %>
<% top = 10 %>
<% shown = params[:all].present? ? @entries : @entries.first(top) %>
<div class="mx-auto flex max-w-3xl flex-col gap-5" data-trace-mask>
  <% if current_user.student? %>
    <%= render "challenges/tabs", active: :leaderboard %>
  <% else %>
    <h1 class="text-page font-black tracking-[-.02em]"><%= t("leaderboard_page.title") %></h1>
  <% end %>

  <% if current_user.student? && current_user.nickname.blank? %>
    <div class="flex flex-wrap items-center gap-3 rounded-[14px] bg-primary-50 px-4 py-3 ring-1 ring-primary-100">
      <span class="min-w-0 flex-1 text-sm font-bold text-primary-900"><%= t("leaderboard_page.set_nickname") %></span>
      <%= link_to t("nav.settings"), settings_path, class: "button button-secondary" %>
    </div>
  <% end %>

  <section>
    <div class="duel-section-head">
      <h2><%= t("leaderboard_page.title") %></h2>
      <span><%= t("leaderboard_page.resets") %></span>
    </div>

    <div class="duel-list overflow-hidden">
      <% if @entries.empty? %>
        <p class="px-4 py-6 text-center text-sm font-bold text-ink-600"><%= t("leaderboard_page.empty") %></p>
      <% else %>
        <ol>
          <% shown.each do |entry| %>
            <%= render "row", rank: entry.rank, name: entry.user.nickname, xp: entry.xp, me: entry.user == current_user %>
          <% end %>
        </ol>

        <% if @my_entry && @my_entry.rank > shown.size %>
          <ol class="border-t-2 border-dashed border-ink-150">
            <%= render "row", rank: @my_entry.rank, name: current_user.nickname, xp: @my_entry.xp, me: true %>
          </ol>
        <% end %>

        <% if shown.size < @entries.size %>
          <div class="border-t border-ink-100 text-center">
            <%= link_to t("leaderboard_page.see_all"), leaderboard_path(all: 1), class: "link-cta" %>
          </div>
        <% end %>
      <% end %>

      <%# Not on the board until they score — see LeaderboardsController. %>
      <% if current_user.student? && current_user.nickname.present? && @my_entry.nil? %>
        <div class="border-t-2 border-dashed border-ink-150 px-4 py-3 text-sm font-bold text-ink-600">
          <%= t("leaderboard_page.no_points") %>
        </div>
      <% end %>
    </div>
  </section>

  <%= render "leagues/section", leagues: @leagues, places: @places, standings: @standings if @leagues %>
</div>

<%# Where you are starting.

    The one screen the old calibration never had. A child answered twelve
    ordinary questions and was told nothing; this names the band, shows it on
    the same scale the home page uses, and then gets out of the way.

    The band leads and the number follows it, which is the rule everywhere a
    rating is shown to a student: „Уверен" means something to a nine-year-old
    and „1180" does not. %>
<% content_for :bare, true %>

<div class="practice-shell">
  <div class="practice-column">
    <div class="animate-rise overflow-hidden rounded-[24px] border border-primary-100 bg-white"
         style="box-shadow: var(--shadow-card-v2)">
      <div class="border-b-2 border-primary-100 bg-primary-50 px-8 py-8 text-center max-sm:px-5">
        <div class="text-[12px] font-black uppercase tracking-[.1em] text-primary-700">
          <%= t("placement.kicker") %>
        </div>
        <h1 class="mt-2 text-[40px] font-black leading-[1.1] tracking-[-.03em] text-primary-900 max-sm:text-3xl">
          <%= @result.band.name %>
        </h1>
        <p class="mx-auto mt-2.5 max-w-sm text-[15px] font-bold text-ink-600">
          <%= t("placement.explained", correct: @result.correct, total: @result.total) %>
        </p>
      </div>

      <div class="px-8 py-6 max-sm:px-5">
        <%= render "shared/rating_band_card", band: @result.band %>

        <p class="mt-5 text-center text-[13.5px] font-bold leading-[1.55] text-ink-500">
          <%= t("placement.moves", count: (Dispatcher::TARGET_SUCCESS_RATE * 100).round) %>
        </p>

        <%= button_to t("placement.start_practising"), daily_assignment_path,
                      class: "button-edge button-edge-primary mt-5 w-full min-h-14 text-[17px]" %>
        <%= link_to t("placement.later"), calendar_path,
                    class: "mt-3 block text-center text-[13.5px] font-extrabold text-ink-500 hover:underline" %>
      </div>
    </div>
  </div>
</div>

<%# Where you are starting.

    The one screen the old calibration never had. A child answered twelve
    ordinary questions and was told nothing; this says that a starting point
    has been found — never a band or a number, because a child is told where
    they start and not where they rank on a scale that runs to the матура —
    shows the eight answers as a strip, pays out the XP the session earned,
    and gets out of the way.

    The way on is „Днес", not straight into a session: the first-run tour runs
    there and points at the button that starts one. The line saying so is only
    true for a child who has not had the tour yet. %>
<% content_for :bare, true %>
<% answers = Placement.rows(@assignment).filter_map(&:user_answer) %>
<% skipped = answers.count(&:skipped?) %>
<% xp = @assignment.xp_earned %>

<div class="practice-shell">
  <div class="practice-column flex flex-1 flex-col gap-6 sm:justify-center">
    <div class="animate-rise flex flex-col gap-6">
      <div class="flex flex-col gap-2.5">
        <span class="text-meta font-black uppercase tracking-[.06em] text-primary-700"><%= t("placement.kicker") %></span>
        <h1 class="text-[32px] font-black leading-[1.15] tracking-[-.02em] text-ink-900">
          <%= t("placement.found_title") %>
        </h1>
        <p class="text-lead font-semibold leading-normal text-ink-700">
          <%= t("placement.explained", correct: @result.correct, total: @result.total) %>
          <%= t("placement.grows") %>
        </p>
      </div>

      <%# Right, wrong, not taught: one bar per question, in the order asked.
          Colour is not the only carrier — the strip is labelled in words. %>
      <div class="flex gap-1.5" role="img"
           aria-label="<%= t("placement.strip", correct: @result.correct, wrong: answers.size - @result.correct - skipped, skipped: skipped) %>">
        <% answers.each do |answer| %>
          <span class="h-3 flex-1 rounded-[4px] <%= answer.skipped? ? "bg-ink-200" : (answer.correct? ? "bg-green-600" : "bg-red-600") %>"></span>
        <% end %>
      </div>

      <% if xp.positive? %>
        <section class="flex items-center gap-3.5 rounded-[20px] bg-reward-50 p-4 ring-1 ring-reward-200">
          <span class="grid size-12 shrink-0 place-items-center rounded-[14px] bg-reward-500 text-white">
            <%= render "shared/icon", name: :star, size: 24 %>
          </span>
          <div class="flex flex-col gap-0.5">
            <strong class="text-lead font-black text-reward-800"><%= t("placement.xp_title", count: xp) %></strong>
            <span class="text-ui font-bold text-reward-800"><%= t("placement.xp_body") %></span>
          </div>
        </section>
      <% end %>
    </div>

    <div class="flex flex-col gap-2 max-sm:mt-auto">
      <%= link_to t("placement.next"), home_path, class: "button button-primary button-large" %>
      <% if current_user.toured_at.nil? %>
        <p class="text-center text-sm font-bold text-ink-500"><%= t("placement.next_hint") %></p>
      <% end %>
    </div>
  </div>
</div>

<div class="flex min-h-full flex-col justify-center py-12 px-6">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="text-center text-2xl/9 font-bold tracking-tight text-ink-900"><%= t("auth.sign_in") %></h2>
  </div>

  <div class="mt-5 sm:mx-auto sm:w-full sm:max-w-[480px]">
    <div class="bg-white px-6 py-12 shadow sm:rounded-lg sm:px-12">
      <%= form_with url: sign_in_path, class: "space-y-6" do |f| %>
        <div>
          <%= f.label :email, t("auth.email"), class: "block text-sm/6 font-medium text-ink-900" %>
          <div class="mt-2">
            <%= f.email_field :email, required: true, autocomplete: "email", class: "block w-full rounded-md bg-white px-4 py-2.5 text-base text-ink-900 outline outline-1 -outline-offset-1 outline-ink-300 placeholder:text-ink-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-primary-600 sm:text-lg" %>
          </div>
        </div>

        <div>
          <%= f.label :password, t("auth.password"), class: "block text-sm/6 font-medium text-ink-900" %>
          <div class="mt-2">
            <%= f.password_field :password, required: true, autocomplete: "current-password", class: "block w-full rounded-md bg-white px-4 py-2.5 text-base text-ink-900 outline outline-1 -outline-offset-1 outline-ink-300 placeholder:text-ink-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-primary-600 sm:text-lg" %>
          </div>
        </div>

        <div>
          <%= f.submit t("auth.sign_in"), class: "button button-primary button-large" %>
        </div>
      <% end %>
    </div>

    <%# Offered only when there is mail to carry the link — see Mailing. %>
    <% if Mailing.enabled? %>
      <p class="mt-3 text-center text-sm/6 text-ink-500">
        <%= link_to t("password_reset.forgot"), new_password_reset_path, class: "font-semibold text-primary-600 hover:text-primary-500" %>
      </p>
    <% end %>
    <p class="mt-1 text-center text-sm/6 text-ink-500">
      <%= t("auth.no_account") %>
      <%= link_to t("auth.register_link"), sign_up_path, class: "font-semibold text-primary-600 hover:text-primary-500" %>
    </p>
  </div>
</div>

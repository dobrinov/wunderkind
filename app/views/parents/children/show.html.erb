<%# The parent's whole view of one child, in three tabs — see
    Parents::ChildrenController#show. Owed rewards lead on all three, because
    „did she get it?" is the one thing here a parent has to do something about.
    „Напредък" is the same charts the child sees on „Аз", deliberately: a
    parent sitting down with their child should be looking at the same
    picture. %>
<div class="mx-auto flex max-w-5xl flex-col gap-5" data-trace-mask>
  <div class="flex flex-wrap items-center gap-3">
    <%= link_to parents_children_path, class: "text-[13px] font-extrabold text-primary-700 hover:underline" do %>
      ← <%= t("parents.children.title") %>
    <% end %>
    <h1 class="text-2xl font-black tracking-[-.02em]"><%= @child.name %></h1>
    <span class="text-sm font-semibold text-muted"><% if (grade = SchoolGrade.label(@child.estimated_grade)) %><%= grade %> · <% end %><%= @band.name %> · <%= t("profile.level_n", level: @child.level) %></span>

    <div class="ml-auto flex items-center gap-2">
      <%# The same order as the family card: for a child with no login of their
          own, switching in is how they practise at all. %>
      <% if @child.managed? %>
        <%= button_to t("parents.children.switch"), switch_child_path(@child), form_class: "inline", class: "button button-primary" %>
      <% end %>
      <%= link_to t("goals.new"), new_parents_child_goal_path(@child), class: "button #{@child.managed? ? "button-secondary" : "button-primary"}" %>
    </div>
  </div>

  <nav class="segmented" aria-label="<%= @child.name %>">
    <% Parents::ChildrenController::TABS.map { |key| [ key, t("parents.children.tabs.#{key}") ] }.each do |key, label| %>
      <%= link_to parents_child_path(@child, tab: key), class: ("is-active" if @tab == key), "aria-current": ("page" if @tab == key) do %>
        <%= label %>
        <% if key == "goals" && @standings.any? %>
          <span class="text-[12.5px] font-black text-ink-500"><%= @standings.size %></span>
        <% end %>
      <% end %>
    <% end %>
  </nav>

  <%= render "shared/verification_notice" %>

  <% unused, used = @awards.partition { |award| !award.used? } %>

  <%# Outstanding rewards first and on their own: this is the one thing on the
      page a parent has to *do* something about. %>
  <%# A focus finished with a reward attached is owed the same way a goal's
      period is, so it sits in the same box. %>
  <% if unused.any? || @owed_focuses.any? %>
    <div class="rounded-[14px] border border-reward-400/60 bg-reward-50 px-5 py-4">
      <div class="mb-3 text-[13px] font-black text-reward-800"><%= t("goals.owed", count: unused.size + @owed_focuses.size) %></div>
      <ul class="flex flex-col gap-2.5">
        <% @owed_focuses.each do |focus| %>
          <li class="flex flex-wrap items-center gap-x-3 gap-y-1.5 rounded-[12px] bg-white px-4 py-3">
            <span class="text-lg" aria-hidden="true">🎁</span>
            <div class="min-w-0 flex-1">
              <div class="text-[14.5px] font-black"><%= focus.reward %></div>
              <div class="text-[12px] font-bold text-muted">
                <%= t("practice_focus.reward_owed_line", topics: focus_topic_names(focus), date: l(focus.completed_at.to_date, format: :short)) %>
              </div>
            </div>
            <%= button_to t("goals.mark_used"), parents_focus_reward_path(focus), method: :patch,
                          form_class: "shrink-0", class: "button button-secondary" %>
          </li>
        <% end %>
        <% unused.each do |award| %>
          <li class="flex flex-wrap items-center gap-x-3 gap-y-1.5 rounded-[12px] bg-white px-4 py-3">
            <span class="text-lg" aria-hidden="true">🎁</span>
            <div class="min-w-0 flex-1">
              <div class="text-[14.5px] font-black"><%= award.reward %></div>
              <div class="text-[12px] font-bold text-muted">
                <%= goal_sentence(award.goal) %> · <%= goal_window([ award.period_start, award.period_end ]) %>
              </div>
            </div>
            <%= button_to t("goals.mark_used"), parents_reward_path(award), method: :patch,
                          form_class: "shrink-0", class: "button button-secondary" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @tab == "practice" %>
  <%= render "practice" %>
  <% elsif @tab == "goals" %>
  <div class="card">
    <header class="flex flex-wrap items-center gap-2.5">
      <span class="text-[15px] font-black"><%= t("goals.title") %></span>
      <span class="text-[13px] font-bold text-muted"><%= t("goals.subtitle") %></span>
    </header>

    <section>
      <% if @standings.any? %>
        <ul class="flex flex-col gap-3.5">
          <% @standings.each do |standing| %>
            <li class="goal-row">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                  <span class="text-[14.5px] font-black"><%= goal_sentence(standing.goal) %></span>
                  <span class="text-[12px] font-bold text-muted"><%= goal_period_sentence(standing.goal) %></span>
                </div>
                <div class="mt-0.5 text-[12.5px] font-bold text-muted">
                  🎁 <%= standing.goal.reward %> · <%= goal_window(standing.period) %>
                </div>
                <div class="mt-2 flex items-center gap-2.5">
                  <span class="goal-bar <%= "is-complete" if standing.progress.complete? %>">
                    <span style="width: <%= standing.progress.percent %>%"></span>
                  </span>
                  <span class="shrink-0 text-[12.5px] font-black tabular-nums">
                    <%= standing.progress.done %>/<%= standing.progress.target %>
                  </span>
                </div>
              </div>
              <%= button_to t("goals.archive"), parents_goal_path(standing.goal), method: :delete,
                            form_class: "shrink-0", class: "button button-secondary",
                            form: { data: { turbo_confirm: t("goals.archive_confirm") } } %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="card-quiet text-center text-sm font-bold text-muted"><%= t("goals.none") %></div>
      <% end %>
    </section>
  </div>

  <% if used.any? %>
    <div class="card">
      <header><span class="text-[15px] font-black"><%= t("goals.used_title") %></span></header>
      <section>
        <ul class="flex flex-col gap-1.5">
          <% used.each do |award| %>
            <li class="flex flex-wrap items-baseline gap-x-2.5 text-[13px] font-bold text-muted">
              <span class="text-gray-700"><%= award.reward %></span>
              <span><%= goal_window([ award.period_start, award.period_end ]) %></span>
              <span class="ml-auto"><%= t("goals.used_on", date: l(award.used_at.to_date, format: :short)) %></span>
            </li>
          <% end %>
        </ul>
      </section>
    </div>
  <% end %>

  <%# Friends' leaderboards show a child by first name, so for a child whose
      account the parent holds it is the parent's call — see Leagues. A child
      with a login of their own decides for themselves. %>
  <% if @child.managed? %>
    <div class="card" id="leagues">
      <header><span class="text-[15px] font-black"><%= t("leagues.parent.title") %></span></header>
      <section class="flex flex-col gap-3">
        <p class="text-[13.5px] font-bold text-muted"><%= t("leagues.parent.body", name: @child.name) %></p>
        <%= form_with url: parents_child_league_permission_path(@child), method: :patch do %>
          <%= hidden_field_tag :allowed, @child.leagues_allowed? ? "0" : "1" %>
          <%= submit_tag @child.leagues_allowed? ? t("leagues.parent.stop") : t("leagues.parent.allow"),
                         class: "button #{@child.leagues_allowed? ? "button-secondary" : "button-primary"}" %>
        <% end %>
      </section>
    </div>
  <% end %>
  <% else %>
  <%# The band is for the parent, with the school grades that make it readable;
      the child's own home page shows their progress instead. %>
  <%# Beside the chart once there is one; until two weeks carry a point the
      trend renders nothing and the band card would sit beside a hole. %>
  <% if @trend.enough? %>
    <div class="grid gap-5 lg:grid-cols-[1fr_336px]">
      <div class="min-w-0"><%= render "home/trend", trend: @trend, labelled: true %></div>
      <%= render "shared/rating_band_card", band: @band %>
    </div>
  <% else %>
    <div class="max-w-md"><%= render "shared/rating_band_card", band: @band %></div>
  <% end %>

  <%# Under an anchor, so switching the range lands back on the charts
      rather than at the top of the page. %>
  <div id="stats" class="scroll-mt-20">
    <%= render "shared/answer_stats", stats: @stats, always: true,
               goal_minutes: @child.daily_minutes_target.presence || DailyPractice::DEFAULT_MINUTES,
               range_path: ->(days) { parents_child_path(@child, tab: "progress", days: days, anchor: "stats") },
               day_path: ->(date) { stats_day_parents_child_path(@child, date: date.iso8601) } %>
  </div>
  <% end %>
</div>

<%# A parent opens this list to check how their child is doing — this week's
    practice and the goals with their bars, on the card (see ChildOverview) —
    and, for a managed child, to hand the device over: a child without an email
    has no login of their own, so switching into their profile is the only way
    they ever practise. That makes it the card's primary button, with „Нова
    цел" next to it; a child who signs in on their own gets „Нова цел" as the
    primary instead. The detail page is a plain link. %>
<div class="page" data-trace-mask>
  <header>
    <h1><%= t("parents.children.title") %></h1>
    <%= link_to t("parents.children.new"), new_parents_child_path, class: "button button-secondary" %>
  </header>

  <main>
    <%= render "shared/verification_notice" %>

    <% if @overviews.empty? %>
      <div class="alert-info"><div><div><p><%= t("parents.children.empty") %></p></div></div></div>
    <% else %>
      <div class="grid gap-4 lg:grid-cols-2">
        <% @overviews.each do |overview| %>
          <% child = overview.child %>
          <div class="card">
            <header class="flex flex-wrap items-center gap-3">
              <div class="avatar size-11 shrink-0 text-lg"><%= child.name.first %></div>
              <div class="min-w-0 flex-1">
                <%= link_to child.name, parents_child_path(child), class: "text-[17px] font-black hover:underline" %>
                <div class="text-[12.5px] font-bold text-muted">
                  <% if (grade = SchoolGrade.label(child.estimated_grade)) %><%= grade %> · <% end %>
                  <% days = overview.days_since_practice %>
                  <%= days.nil? ? t("parents.children.never_practised") : t("parents.children.last_practised", count: days) %>
                </div>
              </div>
              <div class="text-right">
                <div class="text-[13px] font-black text-primary-700"><%= overview.band.name %></div>
                <div class="text-[11.5px] font-bold text-muted"><%= overview.band.grades_label %></div>
              </div>
            </header>

            <section class="flex flex-col gap-4">
              <%# This week, Monday to Sunday — the same dots the child sees by
                  their streak. %>
              <div>
                <div class="mb-1.5 flex items-baseline justify-between text-[12.5px] font-extrabold">
                  <span class="text-ink-700"><%= t("parents.children.this_week") %></span>
                  <span class="text-muted <%= "invisible" if overview.streak.zero? %>">🔥 <%= t("parents.children.streak_days", count: overview.streak) %></span>
                </div>
                <div class="flex gap-1.5">
                  <% overview.week.each do |day| %>
                    <div class="flex-1 text-center">
                      <div class="grid h-7 place-items-center rounded-lg text-xs font-black
                                  <%= day.active? ? 'bg-reward-100 text-reward-800' : (day.future? ? 'bg-ink-50 text-ink-300' : 'bg-ink-100 text-ink-400') %>"
                           title="<%= t("parents.children.day_tip", count: day.count) %>">
                        <%= day.active? ? day.count : "·" %>
                      </div>
                      <div class="mt-1 text-[10.5px] font-extrabold <%= day.today? ? 'text-primary-700' : 'text-ink-400' %>">
                        <%= t("home.day_names")[day.date.cwday - 1] %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-2 text-center">
                <div class="rounded-[12px] bg-ink-50 px-2 py-2.5">
                  <div class="text-lg font-black tabular-nums"><%= overview.problems %></div>
                  <div class="text-[11.5px] font-bold text-muted"><%= t("parents.children.problems") %></div>
                </div>
                <div class="rounded-[12px] bg-ink-50 px-2 py-2.5">
                  <div class="text-lg font-black tabular-nums"><%= overview.accuracy ? "#{overview.accuracy}%" : "—" %></div>
                  <div class="text-[11.5px] font-bold text-muted"><%= t("parents.children.accuracy") %></div>
                </div>
                <div class="rounded-[12px] bg-ink-50 px-2 py-2.5">
                  <div class="text-lg font-black tabular-nums"><%= overview.minutes %></div>
                  <div class="text-[11.5px] font-bold text-muted"><%= t("parents.children.minutes") %></div>
                </div>
              </div>

              <% if overview.owed.positive? %>
                <%= link_to parents_child_path(child, tab: "goals"), class: "flex items-center gap-2 rounded-[12px] border border-reward-400/60 bg-reward-50 px-3.5 py-2.5 text-[13px] font-black text-reward-800" do %>
                  <span aria-hidden="true">🎁</span>
                  <span class="flex-1"><%= t("goals.owed", count: overview.owed) %></span>
                  <span aria-hidden="true">→</span>
                <% end %>
              <% end %>

              <div>
                <div class="mb-2 text-[12.5px] font-extrabold text-ink-700"><%= t("goals.title") %></div>
                <% if overview.standings.any? %>
                  <ul class="flex flex-col gap-3">
                    <% overview.standings.each do |standing| %>
                      <li>
                        <div class="flex flex-wrap items-baseline gap-x-2">
                          <span class="text-[13.5px] font-black"><%= goal_sentence(standing.goal) %></span>
                          <span class="text-[12px] font-bold text-muted">🎁 <%= standing.goal.reward %></span>
                        </div>
                        <div class="mt-1.5 flex items-center gap-2.5">
                          <span class="goal-bar <%= "is-complete" if standing.progress.complete? %>">
                            <span style="width: <%= standing.progress.percent %>%"></span>
                          </span>
                          <span class="shrink-0 text-[12px] font-black tabular-nums">
                            <%= standing.progress.done %>/<%= standing.progress.target %>
                          </span>
                        </div>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <p class="text-[13px] font-bold text-muted"><%= t("parents.children.no_goal") %></p>
                <% end %>
              </div>
            </section>

            <footer class="flex flex-wrap items-center gap-2">
              <% if child.managed? %>
                <%= button_to t("parents.children.switch"), switch_child_path(child), form_class: "inline", class: "button button-primary" %>
              <% end %>
              <%= link_to t("goals.new"), new_parents_child_goal_path(child, return_to: "children"),
                          class: "button #{child.managed? ? "button-secondary" : "button-primary"}" %>
              <%= link_to t("parents.children.open"), parents_child_path(child),
                          class: "ml-auto link-cta" %>
              <p class="basis-full text-[11.5px] font-bold text-muted">
                <%= child.managed? ? t("parents.children.switch_note") : t("parents.children.own_login_note") %>
              </p>
            </footer>
          </div>
        <% end %>
      </div>
    <% end %>
  </main>
</div>

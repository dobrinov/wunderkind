<div class="page">
  <header>
    <h1><%= t("parents.children.title") %></h1>
    <%= link_to t("parents.children.new"), new_parents_child_path, class: "button button-primary" %>
  </header>

  <main>
    <%= render "shared/verification_notice" %>

    <% if @children.empty? %>
      <div class="alert-info"><div><div><p><%= t("parents.children.empty") %></p></div></div></div>
    <% else %>
      <div class="grid gap-4 sm:grid-cols-2">
        <% @children.each do |child| %>
          <div class="card">
            <header class="flex flex-wrap justify-between items-center gap-2">
              <strong><%= child.name %></strong>
              <div class="flex items-center gap-2">
                <%# Handing the device to the child is the everyday action here,
                    so it leads; homework is the occasional one. %>
                <% if child.managed? %>
                  <%= button_to t("parents.children.switch"), switch_child_path(child), form_class: "inline", class: "button button-primary" %>
                <% end %>
                <%= link_to t("parents.children.assign_homework"), new_parents_homework_path(child_id: child.id), class: child.managed? ? "button button-secondary" : "button button-primary" %>
              </div>
            </header>
            <section>
              <div class="flex gap-3 flex-wrap">
                <div class="stat-tile stat-primary">
                  <div class="stat-value"><%= child.level %></div>
                  <div class="stat-label"><%= t("parents.children.level") %></div>
                </div>
                <div class="stat-tile stat-reward">
                  <div class="stat-value">🔥 <%= child.current_streak %></div>
                  <div class="stat-label"><%= t("parents.children.streak") %></div>
                </div>
                <div class="stat-tile stat-reward">
                  <div class="stat-value">⭐ <%= child.total_xp %></div>
                  <div class="stat-label"><%= t("parents.children.xp") %></div>
                </div>
                <div class="stat-tile">
                  <div class="stat-value"><%= child.elo %></div>
                  <div class="stat-label"><%= t("profile.rating") %></div>
                </div>
              </div>
              <p class="mt-3 text-xs text-gray-500">
                <%= child.managed? ? t("parents.children.switch_note") : t("parents.children.own_login_note") %>
              </p>
            </section>
          </div>
        <% end %>
      </div>
    <% end %>
  </main>
</div>

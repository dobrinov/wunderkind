<%# A parent opens this list to check how their child is doing — this week's
    practice and the goals with their bars, on the card (see ChildOverview) —
    and, for a managed child, to hand the device over: a child without an email
    has no login of their own, so switching into their profile is the only way
    they ever practise. That makes it the card's primary button, with „Нова
    цел" next to it; a child who signs in on their own gets „Нова цел" as the
    primary instead. The detail page is a plain link. %>
<div class="page" data-trace-mask>
  <header>
    <h1><%= t("parents.children.title") %></h1>
    <%= link_to t("parents.children.new"), new_parents_child_path, class: "button button-secondary" %>
  </header>

  <main>
    <%= render "shared/verification_notice" %>

    <% if @overviews.empty? %>
      <%# A new parent's first screen. It used to be one line — „Още нямаш
          свързани деца." — and a secondary button in the corner, with nothing
          about what happens next. Now it says the three steps and makes the
          first one the button. %>
      <div class="mx-auto flex max-w-xl flex-col gap-6 rounded-[24px] bg-white p-7 ring-1 ring-ink-150 max-sm:p-5">
        <div class="flex flex-col gap-2">
          <h2 class="text-page font-black leading-tight tracking-[-.02em]"><%= t("parents.welcome.title") %></h2>
          <p class="text-base font-semibold leading-relaxed text-ink-700"><%= t("parents.welcome.lead") %></p>
        </div>
        <ol class="flex flex-col gap-3">
          <% %w[add set hand].each_with_index do |step, index| %>
            <li class="flex items-start gap-3">
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-primary-50 text-ui font-black text-primary-700"><%= index + 1 %></span>
              <span class="pt-1 text-ui font-bold leading-snug text-ink-800"><%= t("parents.welcome.steps.#{step}") %></span>
            </li>
          <% end %>
        </ol>
        <div class="flex flex-col gap-2">
          <%= link_to t("parents.welcome.cta"), new_parents_child_path, class: "button button-primary button-large" %>
          <%= link_to t("parents.welcome.link_code"), new_parents_child_path(anchor: "link"), class: "button button-quiet" %>
        </div>
        <%# A second parent who signed up without the invitation link lands
            here with nothing — the code the other parent gave them is the way
            into the family they meant to join. %>
        <div id="join" class="border-t border-ink-150 pt-5">
          <div class="text-ui font-black"><%= t("family.join.empty_title") %></div>
          <p class="mt-1 text-meta font-bold text-muted"><%= t("family.join.empty_body") %></p>
          <%= render "join_form" %>
        </div>
      </div>
    <% else %>
      <div class="grid gap-4 lg:grid-cols-2">
        <% @overviews.each do |overview| %>
          <% child = overview.child %>
          <div class="card">
            <header class="flex flex-wrap items-center gap-3">
              <div class="avatar size-11 shrink-0 text-lg"><%= child.name.first %></div>
              <div class="min-w-0 flex-1">
                <%= link_to child.name, parents_child_path(child), class: "text-lead font-black hover:underline" %>
                <div class="text-caption font-bold text-muted">
                  <% if (grade = SchoolGrade.label(child.estimated_grade)) %><%= grade %> · <% end %>
                  <% days = overview.days_since_practice %>
                  <%= days.nil? ? t("parents.children.never_practised") : t("parents.children.last_practised", count: days) %>
                </div>
                <% if overview.parents.size > 1 %>
                  <div class="text-caption font-bold text-muted"><%= t("family.parents.of_child", names: overview.parents.map(&:name_for_children).join(", ")) %></div>
                <% end %>
              </div>
              <div class="text-right">
                <div class="text-meta font-black text-primary-700"><%= overview.band.name %></div>
                <div class="text-micro font-bold text-muted"><%= overview.band.grades_label %></div>
              </div>
            </header>

            <section class="flex flex-col gap-4">
              <%# An admin who is also a parent is the team their own child is
                  writing to: the ticket opens on the admin side, where it can
                  be answered. %>
              <% if current_user.admin? %>
                <% child.question_reports.awaiting_team.includes(:question).each do |ticket| %>
                  <%= link_to overseer_question_report_path(ticket), class: "list-row is-quiet !min-h-0 !bg-primary-50" do %>
                    <span class="min-w-0 flex-1">
                      <span class="list-row-title !text-ui"><%= t("parents.children.admin_ticket.#{ticket.kind}", name: child.name, question: ticket.question.body_text.truncate(40)) %></span>
                      <span class="list-row-sub"><%= t("parents.children.admin_ticket.hint") %></span>
                    </span>
                    <%= render "shared/icon", name: :chevron, size: 20, class: "list-row-chevron" %>
                  <% end %>
                <% end %>
              <% end %>
              <%# This week, Monday to Sunday — the same dots the child sees by
                  their streak. %>
              <div>
                <div class="mb-1.5 flex items-baseline justify-between text-caption font-extrabold">
                  <span class="text-ink-700"><%= t("parents.children.this_week") %></span>
                  <span class="text-muted <%= "invisible" if overview.streak.zero? %>">🔥 <%= t("parents.children.streak_days", count: overview.streak) %></span>
                </div>
                <div class="flex gap-1.5">
                  <% overview.week.each do |day| %>
                    <div class="flex-1 text-center">
                      <div class="grid h-7 place-items-center rounded-lg text-xs font-black
                                  <%= day.active? ? 'bg-reward-100 text-reward-800' : (day.future? ? 'bg-ink-50 text-ink-300' : 'bg-ink-100 text-ink-400') %>"
                           title="<%= t("parents.children.day_tip", count: day.count) %>">
                        <%= day.active? ? day.count : "·" %>
                      </div>
                      <div class="mt-1 text-micro font-extrabold <%= day.today? ? 'text-primary-700' : 'text-ink-400' %>">
                        <%= t("home.day_names")[day.date.cwday - 1] %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-2 text-center">
                <div class="rounded-[12px] bg-ink-50 px-2 py-2.5">
                  <div class="text-lg font-black tabular-nums"><%= overview.problems %></div>
                  <div class="text-micro font-bold text-muted"><%= t("parents.children.problems") %></div>
                </div>
                <div class="rounded-[12px] bg-ink-50 px-2 py-2.5">
                  <div class="text-lg font-black tabular-nums"><%= overview.accuracy ? "#{overview.accuracy}%" : "—" %></div>
                  <div class="text-micro font-bold text-muted"><%= t("parents.children.accuracy") %></div>
                </div>
                <div class="rounded-[12px] bg-ink-50 px-2 py-2.5">
                  <div class="text-lg font-black tabular-nums"><%= overview.minutes %></div>
                  <div class="text-micro font-bold text-muted"><%= t("parents.children.minutes") %></div>
                </div>
              </div>

              <% if overview.owed.positive? %>
                <%= link_to parents_child_path(child, tab: "goals"), class: "flex items-center gap-2 rounded-[12px] border border-reward-400/60 bg-reward-50 px-3.5 py-2.5 text-meta font-black text-reward-800" do %>
                  <span aria-hidden="true">🎁</span>
                  <span class="flex-1"><%= t("goals.owed", count: overview.owed) %></span>
                  <span aria-hidden="true">→</span>
                <% end %>
              <% end %>

              <%# What the sessions are about, when a parent has said: a focus in
                  play with its bar, or one just finished. Nothing at all for
                  general practice, which is what every child does unless
                  asked otherwise. %>
              <% if (focus = overview.focus) %>
                <%= link_to parents_child_path(child, tab: "practice"), class: "block rounded-[12px] px-3.5 py-2.5 #{focus.completed? ? "bg-green-50" : "bg-primary-50"}" do %>
                  <% if focus.completed? %>
                    <span class="text-meta font-black text-green-800"><%= t("practice_focus.family_done") %></span>
                    <span class="text-caption font-bold text-muted">· <%= focus_topic_names(focus) %></span>
                  <% else %>
                    <% progress = overview.focus_progress %>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-2">
                      <span class="inline-flex items-center gap-1.5 text-meta font-black text-primary-900"><%= render "shared/icon", name: :target, size: 16 %><%= t("practice_focus.family_line", topics: focus_topic_names(focus)) %></span>
                      <span class="text-caption font-bold text-muted"><%= t("practice_focus.targets.#{focus.target}") %></span>
                    </div>
                    <div class="mt-1.5 flex items-center">
                      <span class="goal-bar"><span style="width: <%= (progress.fraction * 100).round %>%"></span></span>
                    </div>
                  <% end %>
                <% end %>
              <% end %>

              <div>
                <div class="mb-2 text-caption font-extrabold text-ink-700"><%= t("goals.title") %></div>
                <% if overview.standings.any? %>
                  <ul class="flex flex-col gap-3">
                    <% overview.standings.each do |standing| %>
                      <li>
                        <div class="flex flex-wrap items-baseline gap-x-2">
                          <span class="text-meta font-black"><%= goal_sentence(standing.goal) %></span>
                          <span class="text-caption font-bold text-muted">🎁 <%= standing.goal.reward %></span>
                          <% if overview.parents.size > 1 %>
                            <span class="text-caption font-bold text-muted">· <%= t("family.credit.goal_from", name: standing.goal.parent.name_for_children) %></span>
                          <% end %>
                        </div>
                        <div class="mt-1.5 flex items-center gap-2.5">
                          <span class="goal-bar <%= "is-complete" if standing.progress.complete? %>">
                            <span style="width: <%= standing.progress.percent %>%"></span>
                          </span>
                          <span class="shrink-0 text-caption font-black tabular-nums">
                            <%= standing.progress.done %>/<%= standing.progress.target %>
                          </span>
                        </div>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <p class="text-meta font-bold text-muted"><%= t("parents.children.no_goal") %></p>
                <% end %>
              </div>
            </section>

            <footer class="flex flex-wrap items-center gap-2">
              <% if child.managed? %>
                <%= button_to t("parents.children.switch"), switch_child_path(child), form_class: "inline", class: "button button-primary" %>
              <% end %>
              <%= link_to t("goals.new"), new_parents_child_goal_path(child, return_to: "children"),
                          class: "button #{child.managed? ? "button-secondary" : "button-primary"}" %>
              <%= link_to t("parents.children.open"), parents_child_path(child),
                          class: "ml-auto link-cta" %>
              <p class="basis-full text-micro font-bold text-muted">
                <%= child.managed? ? t("parents.children.switch_note") : t("parents.children.own_login_note") %>
              </p>
            </footer>
          </div>
        <% end %>
      </div>

      <%= render "parents", class: "mt-6", family_parents: @family_parents, shared_children: @shared_children, invitations: @invitations,
                            child_count: @overviews.size, children_names: @overviews.map { |overview| overview.child.name }.to_sentence %>
    <% end %>
  </main>
</div>

<%# One form for the usual case — a child without an email, reached through
    the parent's account — and the two rarer ones folded under it. The child's
    own email and password used to sit open in the form, under the welcome
    screen's promise that no email is needed, and linking by code stood beside
    it as an equal second card, which some parents started as if a child
    needed a code first. A failed save renders this again with what was typed
    (ChildrenController#create) rather than redirecting to an empty form. %>
<% own_login_open = @email.present? %>
<% link_open = params[:link].present? || @link_code.present? %>
<div class="page">
  <header>
    <h1><%= t("parents.children.new") %></h1>
  </header>

  <main>
    <div class="flex max-w-xl flex-col gap-4">
      <div class="card">
        <header><strong><%= t("parents.children.create_title") %></strong></header>
        <section>
          <%= form_with url: parents_children_path, class: "flex flex-col gap-4" do |f| %>
            <div class="field">
              <%= label_tag :name, t("auth.name") %>
              <%= text_field_tag :name, @name, required: true, autocomplete: "off" %>
              <p class="field-hint"><%= t("parents.children.create_hint") %></p>
            </div>
            <%= render "shared/school_fields", scope: nil, birth_year: @birth_year, grade_offset: @grade_offset || 0 %>
            <details class="form-disclosure" <%= "open" if own_login_open %>>
              <summary>
                <span><%= t("parents.children.own_login_title") %></span>
                <%= render "shared/icon", name: :chevron, size: 20, class: "form-disclosure-chevron" %>
              </summary>
              <div class="form-disclosure-body">
                <p class="field-hint"><%= t("parents.children.own_login_hint") %></p>
                <div class="field">
                  <%= label_tag :email, t("auth.email") %>
                  <%= email_field_tag :email, @email, autocomplete: "off" %>
                </div>
                <div class="field">
                  <%= label_tag :password, t("auth.password") %>
                  <%= password_field_tag :password, "", autocomplete: "new-password" %>
                </div>
              </div>
            </details>
            <%= f.submit t("parents.children.create"), class: "button button-primary button-large" %>
          <% end %>
        </section>
      </div>

      <details id="link" class="form-disclosure card" <%= "open" if link_open %>>
        <summary>
          <span><%= t("parents.children.link_summary") %></span>
          <%= render "shared/icon", name: :chevron, size: 20, class: "form-disclosure-chevron" %>
        </summary>
        <div class="form-disclosure-body">
          <%# The one part of this page that waits for a confirmed address
              (Parents::BaseController): said here rather than as a banner
              over a form that no longer needs it. %>
          <% unless current_user.verified? %>
            <div class="flex flex-col gap-3 rounded-[12px] bg-amber-50 p-4 ring-1 ring-amber-200">
              <p class="text-meta font-bold leading-snug text-ink-700"><%= t("parents.children.link_verify", email: current_user.email) %></p>
              <%= button_to t("verification.resend"), email_verifications_path, class: "button button-secondary", form_class: "flex flex-col" %>
            </div>
          <% end %>
          <%= form_with url: parents_children_path, class: "flex flex-col gap-4" do |f| %>
            <div class="field">
              <%= label_tag :link_code, t("parents.children.link_code") %>
              <%= text_field_tag :link_code, @link_code, required: true, autocomplete: "off", class: "uppercase tracking-widest font-mono" %>
              <p class="field-hint"><%= t("parents.children.link_hint") %></p>
            </div>
            <%= f.submit t("parents.children.link"), class: "button button-secondary" %>
          <% end %>
        </div>
      </details>
    </div>
  </main>
</div>

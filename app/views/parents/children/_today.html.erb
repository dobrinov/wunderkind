<%# „Днес" for the whole family, above the cards: what a parent checking in
    wants first. With twelve children the cards were 8000px of numbers on a
    phone and nothing said who had practised, whose streak ends tonight or what
    is owed — the morning check looked the same as the evening one. Each name
    links to that child's page. %>
<% done = overviews.select(&:practised_today?) %>
<% waiting = overviews.reject(&:practised_today?).select { |overview| overview.child.student? } %>
<% at_risk = waiting.select(&:streak_at_risk?) %>
<% owed = overviews.sum(&:owed) %>
<section class="card mb-4" aria-labelledby="family-today">
  <header><h2 id="family-today" class="text-ui font-black"><%= t("parents.today.title") %></h2></header>
  <section class="flex flex-col gap-3">
    <% if done.any? %>
      <div>
        <div class="text-meta font-extrabold text-muted"><%= t("parents.today.practised", count: done.size) %></div>
        <%# Two to a row on a phone — twelve one-per-row chips were a screen
            and a half — and a wrapping row of pills from a tablet up. %>
        <div class="mt-1.5 grid grid-cols-2 gap-1.5 sm:flex sm:flex-wrap">
          <% done.each do |overview| %>
            <% minutes = overview.today.minutes %>
            <%= link_to parents_child_path(overview.child), class: "flex min-h-11 min-w-0 flex-col justify-center rounded-[12px] bg-green-50 px-3 py-1.5 text-sm font-extrabold leading-tight text-green-800 ring-1 ring-green-200 hover:bg-green-100 sm:flex-row sm:items-center sm:gap-2 sm:rounded-full sm:px-3.5" do %>
              <span class="truncate"><%= overview.child.name.split.first %></span>
              <span class="text-caption font-bold text-green-700 sm:text-sm"><%= t("parents.today.amount", problems: overview.today.count, minutes: minutes >= 1 ? minutes.round : "<1") %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if waiting.any? %>
      <div>
        <div class="text-meta font-extrabold text-muted"><%= t("parents.today.not_yet", count: waiting.size) %></div>
        <div class="mt-1.5 grid grid-cols-2 gap-1.5 sm:flex sm:flex-wrap">
          <% waiting.each do |overview| %>
            <%= link_to parents_child_path(overview.child), class: "flex min-h-11 min-w-0 items-center gap-2 rounded-[12px] bg-white px-3 text-sm font-extrabold text-ink-700 ring-1 ring-ink-200 hover:bg-ink-50 sm:rounded-full sm:px-3.5" do %>
              <span><%= overview.child.name.split.first %></span>
              <% if overview.streak_at_risk? %>
                <span class="inline-flex items-center gap-1 font-bold text-reward-700"><%= render "shared/icon", name: :flame, size: 14 %><%= overview.streak %></span>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <% if at_risk.any? %>
          <p class="mt-1.5 text-meta font-bold text-reward-700"><%= t("parents.today.streaks_end", names: at_risk.map { |overview| overview.child.name.split.first }.to_sentence) %></p>
        <% end %>
      </div>
    <% end %>

    <%# „Похвали днес": one line per child — who to praise and for what. It
        was one line per coin with the track's whole description, which for a
        big family on a good day was thirty lines saying the same few things;
        what each coin means is on the child's own collection. %>
    <% praise = overviews.filter_map { |overview| [ overview.child, overview.coins_today ] if overview.coins_today.any? } %>
    <% if praise.any? %>
      <div>
        <div class="text-meta font-extrabold text-muted"><%= t("parents.today.praise") %></div>
        <ul class="mt-1.5 flex flex-col gap-1.5">
          <% praise.each do |child, coins| %>
            <li class="flex items-center gap-2.5">
              <span class="flex shrink-0 -space-x-2">
                <% coins.first(3).each do |track, rung| %>
                  <%= render "shared/coin", symbol: track.symbol, material: track.material(rung), size: 28 %>
                <% end %>
              </span>
              <span class="min-w-0 flex-1 text-meta font-bold text-ink-800">
                <%= t("coins.praise", name: child.name.split.first,
                                      track: coins.map(&:first).tally.map { |track, count| count > 1 ? "#{coin_track_name(track)} ×#{count}" : coin_track_name(track) }.join(", ")) %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Whose: „see the child's card" sent a parent of twelve through every card. %>
    <% owing = overviews.select { |overview| overview.owed.positive? } %>
    <% if owing.any? %>
      <p class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-meta font-bold text-ink-700">
        <span aria-hidden="true">🎁</span><%= t("parents.today.owed_for", count: owed) %>
        <% owing.each_with_index do |overview, index| %>
          <%= link_to parents_child_path(overview.child, tab: "goals"), class: "font-black text-reward-800 underline" do %><%= overview.child.name.split.first %><% if overview.owed > 1 %> (<%= overview.owed %>)<% end %><% end %><%= "," if index < owing.size - 1 %>
        <% end %>
      </p>
    <% end %>
  </section>
</section>

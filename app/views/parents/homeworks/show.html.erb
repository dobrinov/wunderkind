<div class="page">
  <header>
    <h1><%= @homework.title %></h1>
    <%= link_to t("parents.children.title"), parents_children_path, class: "button button-secondary" %>
  </header>

  <main>
    <div class="flex flex-col gap-4 max-w-2xl">
      <p class="text-sm text-gray-500">
        <%= t("homework.due", date: l(@homework.due_at, format: :short)) %>
      </p>

      <div class="card">
        <header><strong><%= t("teachers.homeworks.results") %></strong></header>
        <section class="space-y-2">
          <% @students.each do |student| %>
            <% completion = @homework.completion_for(student) %>
            <div class="flex items-center gap-3">
              <span class="flex-1 font-semibold"><%= student.name %></span>
              <% if completion && completion[:completed] %>
                <span class="<%= completion[:on_time] ? 'text-green-600' : 'text-yellow-600' %> font-semibold">
                  ✓ <%= completion[:correct] %>/<%= completion[:total] %>
                </span>
              <% else %>
                <span class="text-gray-400"><%= t("teachers.homeworks.in_progress") %></span>
              <% end %>
            </div>
          <% end %>
        </section>
      </div>
    </div>
  </main>
</div>

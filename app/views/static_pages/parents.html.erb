<%# „За родители" (/za-roditeli): how the product works, at the length the
    landing page used to say it. The landing page was eleven sections and half
    its visitors never scrolled past the first; the long answer lives here, on
    a page of its own that a search can land on, and the landing page keeps
    one line of each. The same two rules hold as there: the artwork is the
    product (the real rating-band card, real duel chrome), and every figure is
    read off the constant that implements it. %>
<% demo = RatingBand.new(1356) %>

<section class="landing-section">
  <nav class="landing-eyebrow mb-3" aria-label="<%= t("curriculum.breadcrumb_label") %>">
    <%= link_to t("curriculum.home"), root_path, class: "hover:underline" %> ›
    <span><%= t("landing.nav.grownups") %></span>
  </nav>

  <h1 class="landing-h1 mb-4"><%= t("landing.for_parents.title") %></h1>
  <p class="landing-lede mb-6 max-w-[56ch]"><%= t("landing.for_parents.lede", minutes: DailyPractice::DEFAULT_MINUTES) %></p>

  <div class="flex flex-wrap gap-3 max-sm:flex-col">
    <%= link_to sign_up_path, class: "button button-primary button-hero" do %>
      <%= t("landing.sign_up") %> →
    <% end %>
    <%= link_to t("trial.try"), trial_path, class: "button button-secondary button-hero", data: { trace: "trial-open" } %>
  </div>
</section>

<%# --- How it works -------------------------------------------------------- %>
<section id="how" class="landing-section scroll-mt-20">
  <div class="mb-7 max-w-[60ch]">
    <div class="landing-eyebrow"><%= t("landing.how.eyebrow") %></div>
    <h2 class="landing-h2 mb-3"><%= t("landing.how.title", minutes: DailyPractice::DEFAULT_MINUTES) %></h2>
    <p class="landing-body"><%= t("landing.how.body") %></p>
  </div>

  <ol class="grid grid-cols-1 gap-5 lg:grid-cols-3">
    <% [
         [ t("landing.how.steps.find.title"), t("landing.how.steps.find.body", count: Placement::QUESTION_COUNT) ],
         [ t("landing.how.steps.daily.title"), t("landing.how.steps.daily.body", minutes: DailyPractice::DEFAULT_MINUTES) ],
         [ t("landing.how.steps.return.title"), t("landing.how.steps.return.body") ]
       ].each_with_index do |(title, body), index| %>
      <li class="landing-tile">
        <div class="landing-step-number" aria-hidden="true"><%= index + 1 %></div>
        <h3 class="mb-1.5 text-[17px] font-black tracking-[-.01em]"><%= title %></h3>
        <p class="text-[14.5px] font-semibold leading-relaxed text-ink-700"><%= body %></p>
      </li>
    <% end %>
  </ol>
</section>

<%# --- Adaptive difficulty ------------------------------------------------- %>
<section id="adaptive" class="landing-section scroll-mt-20">
  <div class="landing-panel grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12">
    <div class="min-w-0">
      <div class="landing-eyebrow"><%= t("landing.adaptive.eyebrow") %></div>
      <h2 class="landing-h2 mb-3.5"><%= t("landing.adaptive.title") %></h2>
      <p class="landing-body mb-5">
        <%= t("landing.adaptive.body", percent: (Dispatcher::TARGET_SUCCESS_RATE * 100).round) %>
      </p>

      <ul class="flex flex-col gap-3">
        <% [
             t("landing.adaptive.points.per_answer"),
             t("landing.adaptive.points.named_band", name: demo.name, rating: demo.rating),
             t("landing.adaptive.points.not_taught", days: AnswerSubmission::DEFERRAL_DAYS)
           ].each do |point| %>
          <li class="landing-check">
            <span aria-hidden="true">✓</span>
            <span><%= point %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <%# Not a mock-up of the card — the card. The page is read by parents, and this
        is the partial their own page renders for a child, so the promise cannot
        drift away from the product. %>
    <div class="min-w-0 text-ink-900">
      <%= render "shared/rating_band_card", band: demo %>
    </div>
  </div>
</section>

<%# --- The phone in the child's hands ------------------------------------
    The moment a parent actually decides: a phone handed over in the car or at
    a table. Every claim here is a feature — the managed child profile, the
    parent's goals and rewards, the session that ends, the sound toggle — and
    the minutes are read off DailyPractice like everywhere else on the page. %>
<section id="telefon" class="landing-section scroll-mt-20">
  <div class="mb-7 max-w-[60ch]">
    <div class="landing-eyebrow"><%= t("landing.phone.eyebrow") %></div>
    <h2 class="landing-h2 mb-3"><%= t("landing.phone.title") %></h2>
    <p class="landing-body"><%= t("landing.phone.body") %></p>
  </div>

  <ul class="mb-6 grid grid-cols-1 gap-5 lg:grid-cols-3">
    <% %w[car table first].each do |moment| %>
      <li class="landing-tile">
        <h3 class="mb-1.5 text-[17px] font-black tracking-[-.01em]"><%= t("landing.phone.moments.#{moment}.title") %></h3>
        <p class="text-[14.5px] font-semibold leading-relaxed text-ink-700">
          <%= t("landing.phone.moments.#{moment}.body", minutes: DailyPractice::DEFAULT_MINUTES) %>
        </p>
      </li>
    <% end %>
  </ul>

  <ul class="flex flex-col gap-2.5">
    <% t("landing.phone.points").each do |point| %>
      <li class="landing-check">
        <span aria-hidden="true">✓</span>
        <span><%= point %></span>
      </li>
    <% end %>
  </ul>
</section>

<%# --- Parents --------------------------------------------------------------- %>
<section id="grownups" class="landing-section scroll-mt-20">
  <div class="landing-tile p-6 sm:p-7">
    <div class="landing-eyebrow"><%= t("landing.grownups.parents.eyebrow") %></div>
    <h2 class="mb-2.5 text-xl font-black tracking-[-.02em] sm:text-2xl">
      <%= t("landing.grownups.parents.title") %>
    </h2>
    <p class="mb-4 text-[15px] font-semibold leading-relaxed text-ink-700">
      <%= t("landing.grownups.parents.body") %>
    </p>
    <ul class="flex flex-col gap-2.5">
      <% t("landing.grownups.parents.points").each do |point| %>
        <li class="landing-check">
          <span aria-hidden="true">✓</span>
          <span><%= point %></span>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<%# --- Duels --------------------------------------------------------------- %>
<section id="duel" class="landing-section scroll-mt-20">
  <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[.95fr_1.05fr] lg:gap-12">
    <div class="min-w-0">
      <span class="mb-3.5 inline-flex items-center rounded-full border border-reward-400/60 bg-reward-50 px-3 py-1 text-xs font-black text-reward-800">
        <%= t("landing.duel.tag_new") %>
      </span>

      <h2 class="landing-h2 mb-3.5"><%= t("landing.duel.title") %></h2>

      <p class="landing-body mb-5">
        <%= t("landing.duel.body",
               count: Challenge::QUESTION_COUNT,
               seconds: Challenge::SECONDS_PER_QUESTION,
               correct: ChallengeScoring::CORRECT_POINTS,
               speed: ChallengeScoring::SPEED_POINTS) %>
      </p>

      <ul class="flex flex-wrap gap-2">
        <% [
             t("landing.duel.tags.count", count: Challenge::QUESTION_COUNT),
             t("landing.duel.tags.seconds", count: Challenge::SECONDS_PER_QUESTION),
             t("landing.duel.tags.matched"),
             t("landing.duel.tags.no_effect")
           ].each do |tag| %>
          <li class="landing-tag"><%= tag %></li>
        <% end %>
      </ul>
    </div>

    <div class="landing-peek min-w-0" role="img" aria-label="<%= t("landing.duel.peek_alt") %>">
      <div class="mb-3 flex items-center justify-center gap-3.5 rounded-[14px] border border-ink-200 bg-white px-3.5 py-3">
        <div class="flex shrink-0 items-center gap-2">
          <span class="avatar size-6 text-[11px]" aria-hidden="true">В</span>
          <span class="text-lg font-black tabular-nums text-primary-900">312</span>
        </div>
        <span class="text-[11.5px] font-black text-muted"><%= t("landing.duel.versus") %></span>
        <div class="flex shrink-0 items-center gap-2">
          <span class="text-lg font-black tabular-nums text-ink-700">265</span>
          <span class="grid size-6 place-items-center rounded-full bg-ink-100 text-[11px] font-black text-ink-500" aria-hidden="true">Н</span>
        </div>
      </div>

      <div class="mb-3 flex items-center gap-2.5">
        <span class="duel-clock">12</span>
        <div class="level-progress flex-1"><div style="width: 60%"></div></div>
        <span class="whitespace-nowrap text-[12.5px] font-extrabold text-muted">
          <%= t("landing.duel.bonus", count: 36) %>
        </span>
      </div>

      <div class="practice-card p-5 text-center sm:p-6">
        <div class="question-body-large mb-4"><%= t("landing.duel.stem") %></div>
        <div class="flex justify-center gap-2.5">
          <% [ 56, 54, 63 ].each do |option| %>
            <%= tag.span option, class: "choice-button pointer-events-none grid size-12 place-items-center p-0 text-lg",
                         aria: { pressed: option == 56 } %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<%= render "curriculum/cta" %>

<%# A filled-in table shown back as the table, not as the string it is stored
    as. Given cells are grey as on the problem; an asked-for cell shows what the
    child typed — green when right, struck through in red with the right value
    under it when not. With no answer to show (a skip), the asked-for cells show
    the right values. The mark is in the text as well as the colour, for a
    screen reader and for anyone who cannot tell red from green. %>
<% params = question.grading["params"] || {} %>
<% cells = grid_fill_cells(question, answer) %>
<% rows = Array(params["rows"]) %>
<% column_headers = Array(params["column_headers"]) %>
<% row_headers = Array(params["row_headers"]) %>
<% showing_answer = answer.present? && !answer.skipped? %>
<% wide = (rows.map(&:size).max || 0) + (row_headers.any? ? 1 : 0) >= 7 %>
<% cell_class = wide ? "min-w-10 h-10 px-1 text-sm" : "min-w-12 h-12 px-1.5 text-lg" %>

<div class="grid gap-2">
  <% if showing_answer %>
    <% right = cells.count { |_, cell| cell[:right] } %>
    <p class="text-sm font-extrabold text-ink-700">
      <%= t("answers.grid_cells_right", right: right, total: cells.size) %>
    </p>
  <% end %>
  <% if params["layout"] == "pyramid" %>
    <%# An addition pyramid, the right way up: base row last, each cell between
        the two below it — as on the problem (widgets/grid_fill_controller). %>
    <div class="mx-auto flex w-max flex-col items-center gap-1.5">
      <% rows.each_with_index.reverse_each do |row, r| %>
        <div class="flex gap-1.5">
          <% Array(row).each_with_index do |value, c| %>
            <% next if value == "" %>
            <%= render "answers/grid_fill_review_cell", tag: :div, value: value, cell: cells["#{r},#{c}"] || {},
                       showing_answer: showing_answer, cell_class: "#{cell_class} grid place-items-center rounded-lg" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
  <div class="overflow-x-auto">
    <table class="mx-auto min-w-0 border-collapse text-center">
      <% if column_headers.any? %>
        <thead>
          <tr>
            <% if row_headers.any? %><th></th><% end %>
            <% column_headers.each do |header| %>
              <th class="<%= cell_class %> font-bold text-ink-500"><%= math_value(header.to_s) %></th>
            <% end %>
          </tr>
        </thead>
      <% end %>
      <tbody>
        <% rows.each_with_index do |row, r| %>
          <tr>
            <% if row_headers.any? %>
              <th class="<%= cell_class %> font-bold text-ink-500"><%= math_value(row_headers[r].to_s) %></th>
            <% end %>
            <% Array(row).each_with_index do |value, c| %>
              <% if value == "" %>
                <td></td>
              <% else %>
                <%= render "answers/grid_fill_review_cell", tag: :td, value: value, cell: cells["#{r},#{c}"] || {},
                           showing_answer: showing_answer, cell_class: cell_class %>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>
</div>

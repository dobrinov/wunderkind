<%# The answer to a numeric question: a drawn field and a keypad of our own
    (number_pad_controller). The value that is submitted is the plain string in
    the hidden field — "12", "0,75", "-3/4" — which is what ExactValue reads.
    Digits sit as on a phone's dial, or in two rows of five on a phone's
    narrow screen — the grid places each key by its param, so the order here
    is only the order a screen reader reads them in. %>
<% key_action = "pointerdown->number-pad#keepFocus touchend->number-pad#tap click->number-pad#press" %>
<div class="number-pad" data-controller="number-pad">
  <div class="number-pad-field" role="textbox" tabindex="0" aria-label="<%= t("number_pad.label") %>"
       aria-describedby="number-pad-message" data-autofocus
       data-number-pad-target="display"
       data-placeholder="<%= t("number_pad.placeholder") %>"
       data-action="keydown->number-pad#keydown paste->number-pad#paste click->number-pad#place"></div>
  <%= hidden_field_tag :value, "", data: { number_pad_target: "hidden" } %>
  <p id="number-pad-message" class="number-pad-message" data-number-pad-target="message" role="alert" hidden><%= t("number_pad.empty") %></p>

  <div class="number-pad-keys" role="group" aria-label="<%= t("number_pad.keys") %>">
    <% %w[7 8 9].each do |digit| %>
      <button type="button" class="number-pad-key" data-action="<%= key_action %>" data-number-pad-key-param="<%= digit %>"><%= digit %></button>
    <% end %>
    <button type="button" class="number-pad-key number-pad-key-quiet" data-action="<%= key_action %>" data-number-pad-key-param="backspace"
            aria-label="<%= t("number_pad.backspace") %>" title="<%= t("number_pad.backspace") %>"><%= render "shared/icon", name: :backspace, size: 24 %></button>

    <% %w[4 5 6].each do |digit| %>
      <button type="button" class="number-pad-key" data-action="<%= key_action %>" data-number-pad-key-param="<%= digit %>"><%= digit %></button>
    <% end %>
    <button type="button" class="number-pad-key number-pad-key-quiet" data-action="<%= key_action %>" data-number-pad-key-param="sign"
            aria-label="<%= t("number_pad.sign") %>" title="<%= t("number_pad.sign") %>">−</button>

    <% %w[1 2 3].each do |digit| %>
      <button type="button" class="number-pad-key" data-action="<%= key_action %>" data-number-pad-key-param="<%= digit %>"><%= digit %></button>
    <% end %>
    <button type="button" class="number-pad-key number-pad-key-quiet number-pad-key-fraction" data-action="<%= key_action %>" data-number-pad-key-param="fraction"
            aria-label="<%= t("number_pad.fraction") %>" title="<%= t("number_pad.fraction") %>">
      <span class="frac" aria-hidden="true"><span>&#9633;</span><span>&#9633;</span></span>
    </button>

    <button type="button" class="number-pad-key" data-action="<%= key_action %>" data-number-pad-key-param="0">0</button>
    <button type="button" class="number-pad-key" data-action="<%= key_action %>" data-number-pad-key-param=","
            aria-label="<%= t("number_pad.comma") %>" title="<%= t("number_pad.comma") %>">,</button>
  </div>
</div>

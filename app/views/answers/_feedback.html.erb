<%# The moment the XP and streak system is supposed to pay off, so it gets a
    banded card and a popped icon rather than a tinted strip with an icon in it.
    A wrong answer gets the same weight, split in two: the pair of chips is
    "what you missed", the panel below is "why" — one flat gray block could
    never say which was which.

    A skip is its own outcome, neither green nor red: the student did not get it
    right and did not get it wrong. %>
<% tone = answer.skipped? || answer.pending_review? ? "fb-neutral" : (answer.correct? ? "fb-correct" : "fb-wrong") %>
<% run = answer.correct? ? correct_run_length(assignment) : 0 %>

<div class="fb-card <%= tone %> animate-rise">
  <div class="fb-band">
    <span class="fb-icon" aria-hidden="true">
      <% if answer.skipped? %>
        🤷
      <% elsif answer.pending_review? %>
        ⏳
      <% elsif answer.correct? %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-8">
          <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.5 7.5a1 1 0 0 1-1.42-.005l-3.5-3.55a1 1 0 0 1 1.424-1.404l2.792 2.833 6.784-6.784a1 1 0 0 1 1.414-.005Z" clip-rule="evenodd" />
        </svg>
      <% else %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-7">
          <path fill-rule="evenodd" d="M5.293 5.293a1 1 0 0 1 1.414 0L10 8.586l3.293-3.293a1 1 0 1 1 1.414 1.414L11.414 10l3.293 3.293a1 1 0 0 1-1.414 1.414L10 11.414l-3.293 3.293a1 1 0 0 1-1.414-1.414L8.586 10 5.293 6.707a1 1 0 0 1 0-1.414Z" clip-rule="evenodd" />
        </svg>
      <% end %>
    </span>

    <div class="min-w-0 flex-1">
      <div class="fb-title">
        <% if answer.skipped? %>
          <%= t("answers.not_taught_recorded") %>
        <% elsif answer.pending_review? %>
          <%= t("free_text.pending") %>
        <% elsif answer.correct? %>
          <%= t("practice.correct_title") %>
        <% else %>
          <%= t("practice.wrong_title") %>
        <% end %>
      </div>
      <div class="fb-sub">
        <% if answer.skipped? %>
          <%= t("answers.not_taught_note") %>
        <% elsif answer.pending_review? %>
          <%= t("free_text.pending_note") %>
        <% elsif answer.correct? %>
          <%= run > 1 ? t("practice.correct_run", count: run) : t("practice.correct_sub") %>
        <% else %>
          <%= t("practice.wrong_sub") %>
        <% end %>
      </div>
    </div>

    <% if flash[:xp_earned].present? %>
      <span class="xp-pill animate-xpfly shrink-0 whitespace-nowrap px-3.5 py-2 text-[15px] font-black ring-1 ring-reward-400">
        ⭐ <%= t("summary.xp_earned", count: flash[:xp_earned]) %>
      </span>
    <% end %>
  </div>

  <div class="fb-body">
    <% if answer.pending_review? %>
      <div class="fb-chip fb-chip-quiet">
        <div class="fb-chip-label"><%= t("answers.your_answer") %></div>
        <div class="fb-chip-value text-lg"><%= answer.value %></div>
      </div>
    <% elsif !answer.skipped? && !answer.correct? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="fb-chip fb-chip-yours">
          <div class="fb-chip-label"><%= t("answers.your_answer") %></div>
          <div class="fb-chip-value <%= 'struck' unless fraction_value?(answer.value) %>">
            <%= math_value(answer.value) %>
          </div>
        </div>
        <div class="fb-chip fb-chip-correct">
          <div class="fb-chip-label"><%= t("answers.correct_answer") %></div>
          <div class="fb-chip-value"><%= math_value(Grading.correct_answer_display(question)) %></div>
        </div>
      </div>
    <% elsif answer.skipped? %>
      <div class="fb-chip fb-chip-quiet">
        <div class="fb-chip-label"><%= t("answers.correct_answer") %></div>
        <div class="fb-chip-value"><%= math_value(Grading.correct_answer_display(question)) %></div>
      </div>
    <% end %>

    <% if question.explanation.present? && !answer.correct? && !answer.pending_review? %>
      <div class="fb-why mt-3.5">
        <div class="mb-1.5 flex items-center gap-2">
          <span aria-hidden="true">💡</span>
          <span class="fb-why-label"><%= t("practice.why") %></span>
        </div>
        <div class="fb-why-text"><%= question.explanation %></div>
      </div>
    <% end %>

    <% Array(flash[:mastered_topics]).each do |topic_name| %>
      <div class="mt-3.5 rounded-[13px] border border-reward-400/60 bg-reward-50 px-4 py-3 text-sm font-black text-reward-800">
        🎓 <%= t("mastery.mastered", name: topic_name) %>
      </div>
    <% end %>

    <% if next_assignment_question.present? %>
      <%= link_to t("answers.next"), question_path(next_assignment_question, close_path: params[:close_path]),
                  class: "button button-primary button-large mt-4.5 rounded-[13px] py-4 text-base font-black", autofocus: true %>
    <% else %>
      <%= link_to t("summary.view_all"), assignment_summary_path(assignment),
                  class: "button button-primary button-large mt-4.5 rounded-[13px] py-4 text-base font-black", autofocus: true %>
    <% end %>
  </div>
</div>

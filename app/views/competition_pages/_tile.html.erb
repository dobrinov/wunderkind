<%# One competition or exam as a card: what it is, who it is for, when next. %>
<% round = event.next_round || event.rounds.last %>
<li>
  <%= link_to event_page_path(event), class: "landing-tile flex h-full flex-col gap-2.5 hover:border-primary-300" do %>
    <span class="flex items-start gap-3.5">
      <%= render "competitions/date", round: round %>
      <span class="min-w-0">
        <span class="block text-[16.5px] font-black leading-snug tracking-[-.01em] text-ink-900"><%= event.name %></span>
        <span class="block text-[13px] font-bold text-ink-500"><%= event_grades(event) %> · <%= t("competitions.styles.#{event.style}") %></span>
      </span>
    </span>
    <span class="text-[14px] font-semibold leading-relaxed text-ink-600 line-clamp-3"><%= event.description %></span>
    <span class="mt-auto text-[13px] font-extrabold <%= event.upcoming? ? "text-primary-700" : "text-ink-500" %>">
      <%= event.upcoming? ? "#{round.name} · #{days_until(round)}" : t("competitions.season_over_short") %>
    </span>
  <% end %>
</li>

<%# The parent's PIN, asked on the way out of a child's profile — see
    ChildSessionsController#require_pin. %>
<div class="mx-auto w-full max-w-sm py-10">
  <div class="card flex flex-col gap-4 p-6">
    <div class="flex flex-col gap-1.5">
      <h1 class="text-title font-black"><%= t("child_session.pin_title") %></h1>
      <p class="text-ui font-semibold text-ink-700"><%= t("child_session.pin_body") %></p>
    </div>
    <%= form_with url: @target, method: @method, class: "flex flex-col gap-3" do %>
      <%= password_field_tag :pin, nil, inputmode: "numeric", autocomplete: "off", maxlength: 6, autofocus: true,
                             aria: { label: t("child_session.pin_label") }, class: "text-center text-2xl tracking-[.4em]" %>
      <% if @wrong %>
        <p class="text-meta font-bold text-red-700" role="alert"><%= t("child_session.pin_wrong") %></p>
      <% end %>
      <%= submit_tag t("child_session.pin_submit"), class: "button button-primary button-large" %>
    <% end %>
    <%= link_to t("child_session.pin_stay"), home_path, class: "link-cta self-center" %>
  </div>
</div>

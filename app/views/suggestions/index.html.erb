<div class="page">
  <header>
    <h1><%= t("suggestions.title") %></h1>
    <%= link_to t("suggestions.new"), new_suggestion_path, class: "button button-primary" %>
  </header>

  <main>
    <p class="text-sm text-ink-500 mb-4"><%= t("suggestions.intro") %></p>

    <% if @suggestions.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("suggestions.problem") %></th>
            <th><%= t("suggestions.topic") %></th>
            <th><%= t("suggestions.status") %></th>
          </tr>
        </thead>
        <tbody>
          <%# Each row opens the suggestion's conversation with the team, where
              a question about it is asked and answered. %>
          <% @suggestions.each do |question| %>
            <% ticket = @tickets[question.id] %>
            <tr>
              <td class="max-w-md truncate">
                <%= ticket ? link_to(question.body_text.truncate(80), report_path(ticket), class: "font-semibold underline") : question.body_text.truncate(80) %>
              </td>
              <td><%= question.topics.first&.name %></td>
              <td>
                <%= t("suggestions.statuses.#{suggestion_status(question)}") %>
                <% if ticket&.in_progress? && ticket.messages.last&.from_team? %>
                  · <%= link_to t("suggestions.answer_team"), report_path(ticket), class: "font-bold text-primary-700 underline" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="alert-info"><div><div><p><%= t("suggestions.empty") %></p></div></div></div>
    <% end %>
  </main>
  <footer>
    <%= paginate @suggestions %>
  </footer>
</div>

<%# The suggestion form, new or changing one still in review. A new one ends
    with a note to the team — the first message of the suggestion's ticket;
    a change is recorded in that ticket as a new version, so it needs none.
    locals: url, method, submit, cancel_path %>
<div class="card max-w-2xl">
      <section>
        <%= form_with model: @suggestion, url: url, method: method, scope: :suggestion,
                      class: "space-y-6", data: { controller: "question-form" } do |f| %>
          <% if @suggestion.errors.any? %>
            <div class="alert-danger">
              <div>
                <div>
                  <p><%= @suggestion.errors.full_messages.join(", ") %></p>
                </div>
              </div>
            </div>
          <% end %>

          <%= render "shared/plain_editor", f: f, field: :text, value: @suggestion.text, label: t("suggestions.form.text") %>

          <div>
            <%= f.label :image, t("suggestions.form.image"), class: "block text-sm font-medium mb-1" %>
            <%= f.file_field :image, accept: Suggestion::IMAGE_TYPES.join(",") %>
            <p class="mt-1 text-xs text-ink-500"><%= t("suggestions.form.image_hint") %></p>
          </div>

          <div class="sm:max-w-xs">
            <%= f.label :answer_type, t("suggestions.form.answer_type"), class: "block text-sm font-medium mb-1" %>
            <%= f.select :answer_type,
                  Suggestion::ANSWER_TYPES.map { |type| [ t("suggestions.form.answer_types.#{type}"), type ] },
                  {}, data: { question_form_target: "typeSelect", action: "question-form#update" } %>
          </div>

          <div class="hidden" data-question-form-target="section" data-answer-type="exact_value">
            <%= f.label :answer, t("suggestions.form.answer"), class: "block text-sm font-medium mb-1" %>
            <%= f.text_field :answer, class: "max-w-48" %>
            <p class="mt-1 text-xs text-ink-500"><%= t("suggestions.form.answer_hint") %></p>
          </div>

          <div class="hidden space-y-3" data-question-form-target="section" data-answer-type="multiple_choice">
            <span class="block text-sm font-medium"><%= t("suggestions.form.options") %></span>
            <div class="space-y-2" data-question-form-target="optionsList">
              <% @suggestion.option_rows.each_with_index do |option, index| %>
                <div class="flex items-center gap-3" data-option-row>
                  <%= text_field_tag "suggestion[options][#{index}][value]", option[:value],
                                     id: nil, placeholder: t("suggestions.form.option_value") %>
                  <label class="flex items-center gap-1.5 text-sm whitespace-nowrap">
                    <%= check_box_tag "suggestion[options][#{index}][correct]", "1", option[:correct],
                                      id: nil, class: "size-4 accent-primary-600" %>
                    <%= t("suggestions.form.option_correct") %>
                  </label>
                  <button type="button" class="button button-secondary" data-action="question-form#removeOption"><%= t("suggestions.form.remove_option") %></button>
                </div>
              <% end %>
            </div>
            <template data-question-form-target="optionTemplate">
              <div class="flex items-center gap-3" data-option-row>
                <input type="text" name="suggestion[options][__INDEX__][value]" placeholder="<%= t('suggestions.form.option_value') %>">
                <label class="flex items-center gap-1.5 text-sm whitespace-nowrap">
                  <input type="checkbox" name="suggestion[options][__INDEX__][correct]" value="1" class="size-4 accent-primary-600">
                  <%= t("suggestions.form.option_correct") %>
                </label>
                <button type="button" class="button button-secondary" data-action="question-form#removeOption"><%= t("suggestions.form.remove_option") %></button>
              </div>
            </template>
            <button type="button" class="button button-secondary" data-action="question-form#addOption"><%= t("suggestions.form.add_option") %></button>
            <p class="text-xs text-ink-500"><%= t("suggestions.form.options_hint") %></p>
          </div>

          <div>
            <%= f.label :topic_id, t("suggestions.form.topic"), class: "block text-sm font-medium mb-1" %>
            <%= f.grouped_collection_select :topic_id, Topic.roots.ordered, -> (root) { root.children.ordered }, :name, :id, :name,
                                            { include_blank: t("suggestions.form.topic_prompt") } %>
          </div>

          <div>
            <%= f.label :explanation, t("suggestions.form.explanation"), class: "block text-sm font-medium mb-1" %>
            <%= f.text_area :explanation, rows: 3 %>
            <p class="mt-1 text-xs text-ink-500"><%= t("suggestions.form.explanation_hint") %></p>
          </div>

          <% unless @suggestion.existing %>
            <div>
              <%= f.label :note, t("suggestions.form.note"), class: "block text-sm font-medium mb-1" %>
              <%= f.text_area :note, rows: 2, maxlength: QuestionReport::NOTE_LIMIT %>
              <p class="mt-1 text-xs text-ink-500"><%= t("suggestions.form.note_hint") %></p>
            </div>
          <% end %>

          <div class="flex items-center gap-3">
            <%= f.submit submit, class: "button button-primary" %>
            <%= link_to t("suggestions.form.cancel"), cancel_path, class: "button button-secondary" %>
          </div>
        <% end %>
      </section>
</div>

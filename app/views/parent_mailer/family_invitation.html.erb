<p><%= t("mailers.family_invitation.body", name: @inviter.name, children: @children) %></p>
<%= email_button t("mailers.family_invitation.button"), @url %>
<p><%= t("mailers.family_invitation.code", code: @invitation.code) %></p>
<p><%= t("mailers.family_invitation.expiry", count: FamilyInvitation::LIFETIME.in_days.to_i) %></p>
<%= email_fallback @url %>
<% content_for :footer, t("mailers.family_invitation.why", name: @inviter.name) %>

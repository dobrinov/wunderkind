<% grey = "color:#5d5f78;" %>
<p style="margin:0 0 6px;"><%= t("mailers.greeting", name: @parent.name) %></p>
<p style="margin:0 0 20px;<%= grey %>">
  <%= t("mailers.weekly_report.intro", dates: @report.dates_label) %>
</p>

<% @report.children.each do |entry| %>
  <% child = entry.child %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;border-top:1px solid #ececf3;">
    <tr>
      <td style="padding:18px 0 10px;">
        <span style="font-size:18px;font-weight:900;"><%= child.name %></span>
        <% if (grade = SchoolGrade.label(child.estimated_grade)) %>
          <span style="font-size:13px;<%= grey %>"> · <%= grade %></span>
        <% end %>
      </td>
    </tr>
    <tr>
      <td>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
          <tr>
            <% [
                 [ entry.active_days, t("mailers.weekly_report.stats.days", count: entry.active_days) ],
                 [ entry.problems, t("mailers.weekly_report.stats.problems", count: entry.problems) ],
                 [ "#{entry.accuracy}%", t("mailers.weekly_report.stats.accuracy") ],
                 [ entry.minutes, t("mailers.weekly_report.stats.minutes", count: entry.minutes) ]
               ].each do |value, label| %>
              <td width="25%" align="center" style="background:#f3f3fe;border-radius:10px;padding:10px 4px;">
                <div style="font-size:20px;font-weight:900;color:#3730a3;"><%= value %></div>
                <div style="font-size:12px;<%= grey %>"><%= label %></div>
              </td>
              <td width="6" style="font-size:0;">&nbsp;</td>
            <% end %>
          </tr>
        </table>
      </td>
    </tr>
    <tr>
      <td style="padding-top:12px;">
        <ul style="margin:0;padding:0 0 0 18px;">
          <% entry_lines(entry).each do |line| %>
            <li style="margin:0 0 6px;"><%= line %></li>
          <% end %>
        </ul>
      </td>
    </tr>
    <tr>
      <td style="padding-top:10px;">
        <a href="<%= parents_child_url(child) %>" style="display:inline-block;background:#5048e5;color:#ffffff;text-decoration:none;font-weight:800;font-size:14px;padding:10px 16px;border-radius:10px;">
          <%= t("mailers.weekly_report.details", name: child.name) %>
        </a>
      </td>
    </tr>
  </table>
<% end %>

<% content_for :footer do %>
  <%= t("mailers.weekly_report.why") %>
  <a href="<%= @unsubscribe_url %>" style="color:#7a7c94;"><%= t("mailers.weekly_report.unsubscribe") %></a>
<% end %>

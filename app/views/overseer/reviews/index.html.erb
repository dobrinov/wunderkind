<div class="page">
  <header>
    <h1><%= t("overseer_reviews.title") %></h1>
  </header>

  <main>
    <% if @questions.any? %>
      <div class="space-y-4 max-w-3xl">
        <% @questions.each do |question| %>
          <div class="card">
            <header class="flex justify-between items-center gap-3">
              <span class="text-sm text-gray-500">
                <% if question.suggested_by %>
                  <span class="mr-1 inline-flex items-center rounded-full bg-primary-50 px-2 py-0.5 text-xs font-bold text-primary-700"><%= t("overseer_reviews.suggestion") %></span>
                <% end %>
                <%= t("overseer_reviews.author") %>: <%= question.author&.name %>
                · <%= t("overseer.questions.answer_types.#{question.answer_type}") %>
                <% if question.topics.any? %>· <%= question.topics.map(&:name).join(", ") %><% end %>
                · <%= t("overseer.questions.elo") %>: <%= question.elo %>
              </span>
              <div class="flex gap-2 items-center">
                <%# A suggestion often needs a touch before it can go live —
                    the difficulty is the suggester's own rating, a guess. %>
                <%= link_to t("overseer.questions.edit"), edit_overseer_question_path(question), class: "text-sm text-primary-600 hover:text-primary-800" %>
                <%= button_to t("overseer_reviews.approve"), approve_overseer_review_path(question), class: "button button-success" %>
                <%= button_to t("overseer_reviews.reject"), reject_overseer_review_path(question), class: "button button-secondary" %>
              </div>
            </header>
            <section>
              <%= question_body(question) %>
              <% if question.exact_value? || question.interactive? %>
                <p class="mt-3 text-sm text-gray-500">
                  <%= t("answers.correct_answer") %>: <strong><%= Grading.correct_answer_display(question) %></strong>
                </p>
              <% elsif question.multiple_choice? %>
                <ul class="mt-3 text-sm text-gray-600 space-y-1">
                  <% question.possible_answers.each do |option| %>
                    <li><%= option.correct? ? "✅" : "▫️" %> <%= option.value %></li>
                  <% end %>
                </ul>
              <% end %>
            </section>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="alert-info"><div><div><p><%= t("overseer_reviews.empty") %></p></div></div></div>
    <% end %>
  </main>
  <footer>
    <%= paginate @questions %>
  </footer>
</div>

<div class="page">
  <header>
    <h1><%= t("overseer_reviews.title") %></h1>
  </header>

  <main>
    <% if @questions.any? %>
      <div class="space-y-4 max-w-3xl">
        <% @questions.each do |question| %>
          <div class="card">
            <header class="flex justify-between items-center gap-3">
              <span class="text-sm text-gray-500">
                <%= t("overseer_reviews.author") %>: <%= question.author&.name %>
                · <%= t("overseer.questions.answer_types.#{question.answer_type}") %>
                <% if question.topics.any? %>· <%= question.topics.map(&:name).join(", ") %><% end %>
              </span>
              <div class="flex gap-2">
                <%= button_to t("ai_review.check"), precheck_overseer_review_path(question), class: "button button-secondary" %>
                <%= button_to t("overseer_reviews.approve"), approve_overseer_review_path(question), class: "button button-success" %>
                <%= button_to t("overseer_reviews.reject"), reject_overseer_review_path(question), class: "button button-secondary" %>
              </div>
            </header>
            <% if question.ai_review.present? %>
              <section class="bg-primary-50/50">
                <div class="flex flex-wrap gap-2 items-center text-sm">
                  <span class="font-semibold text-primary-700">✨ <%= t("ai_review.check") %>:</span>
                  <% { "correct" => t("ai_review.correct"), "clear" => t("ai_review.clear") }.each do |key, label| %>
                    <span class="chip <%= question.ai_review[key] ? 'text-green-700 bg-green-50' : 'text-red-700 bg-red-50' %> rounded-full px-2 py-0.5 text-xs font-semibold ring-1 ring-current/20">
                      <%= label %>: <%= question.ai_review[key] ? t("ai_review.ok") : t("ai_review.problem") %>
                    </span>
                  <% end %>
                  <% if question.ai_review["duplicate"] %>
                    <span class="rounded-full px-2 py-0.5 text-xs font-semibold text-yellow-700 bg-yellow-50 ring-1 ring-current/20">⚠ <%= t("ai_review.duplicate") %></span>
                  <% end %>
                </div>
                <p class="mt-1 text-sm text-gray-600"><%= question.ai_review["notes"] %></p>
              </section>
            <% end %>
            <section>
              <%= question_body(question) %>
              <% if question.exact_value? || question.interactive? %>
                <p class="mt-3 text-sm text-gray-500">
                  <%= t("answers.correct_answer") %>: <strong><%= Grading.correct_answer_display(question) %></strong>
                </p>
              <% elsif question.multiple_choice? %>
                <ul class="mt-3 text-sm text-gray-600 space-y-1">
                  <% question.possible_answers.each do |option| %>
                    <li><%= option.correct? ? "✅" : "▫️" %> <%= option.value %></li>
                  <% end %>
                </ul>
              <% end %>
            </section>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="alert-info"><div><div><p><%= t("overseer_reviews.empty") %></p></div></div></div>
    <% end %>
  </main>
  <footer>
    <%= paginate @questions %>
  </footer>
</div>

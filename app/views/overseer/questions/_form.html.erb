<% grading = question.grading || {} %>
<% widget = grading["widget"] || "number_line" %>
<% statuses = local_assigns.fetch(:statuses, Question.statuses.keys) %>
<% form_url = local_assigns.fetch(:form_url, nil) %>

<%= form_with model: question, url: form_url || url_for([ :overseer, question ]), scope: :question, class: "space-y-6", data: { controller: "question-form" } do |f| %>
  <% if question.errors.any? %>
    <div class="alert-danger">
      <div>
        <div>
          <p><%= question.errors.full_messages.join(", ") %></p>
        </div>
      </div>
    </div>
  <% end %>

  <div data-controller="editor" data-editor-content-value="<%= (question.body || {}).to_json %>">
    <%= f.label :body_json, t("overseer.questions.body"), class: "block text-sm font-medium mb-1" %>
    <div class="editor-shell">
      <div class="editor-toolbar">
        <button type="button" data-editor-target="boldButton" data-action="editor#bold" title="<%= t('overseer.questions.bold') %>"><strong>B</strong></button>
        <button type="button" data-editor-target="italicButton" data-action="editor#italic" title="<%= t('overseer.questions.italic') %>"><em>I</em></button>
        <button type="button" data-action="editor#insertMath"><%= t("overseer.questions.insert_math") %></button>
      </div>
      <div data-editor-target="mount"></div>
    </div>
    <%= f.hidden_field :body_json, data: { editor_target: "hidden" } %>

    <div data-editor-target="popover" class="hidden mt-2 flex items-center gap-2 rounded-lg border border-gray-200 bg-white p-2 shadow-md">
      <div data-slot="field" class="flex-1"></div>
      <button type="button" class="button button-primary" data-action="editor#confirmMath"><%= t("overseer.questions.math_ok") %></button>
    </div>
  </div>

  <div>
    <%= f.label :explanation, t("overseer.questions.explanation"), class: "block text-sm font-medium mb-1" %>
    <%= f.text_area :explanation, rows: 3 %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div>
      <%= f.label :answer_type, t("overseer.questions.answer_type"), class: "block text-sm font-medium mb-1" %>
      <%= f.select :answer_type,
            [ [ t("overseer.questions.answer_types.multiple_choice"), "multiple_choice" ],
              [ t("overseer.questions.answer_types.exact_value"), "exact_value" ],
              [ t("overseer.questions.answer_types.interactive"), "interactive" ] ],
            {}, data: { question_form_target: "typeSelect", action: "question-form#update" } %>
    </div>
    <div>
      <%= f.label :status, t("overseer.questions.status"), class: "block text-sm font-medium mb-1" %>
      <%= f.select :status, statuses.map { |status| [ t("overseer.questions.statuses.#{status}"), status ] } %>
    </div>
    <div>
      <%= f.label :elo, t("overseer.questions.elo"), class: "block text-sm font-medium mb-1" %>
      <%= f.number_field :elo, step: 10 %>
    </div>
  </div>

  <%# --- Multiple choice --- %>
  <div class="hidden space-y-3" data-question-form-target="section" data-answer-type="multiple_choice">
    <span class="block text-sm font-medium"><%= t("overseer.questions.options") %></span>
    <div class="space-y-2" data-question-form-target="optionsList">
      <%= f.fields_for :possible_answers do |option_form| %>
        <div class="flex items-center gap-3" data-option-row>
          <%= option_form.text_field :value, placeholder: t("overseer.questions.option_value") %>
          <label class="flex items-center gap-1.5 text-sm whitespace-nowrap">
            <%= option_form.check_box :correct, class: "size-4 accent-primary-600" %>
            <%= t("overseer.questions.option_correct") %>
          </label>
          <%= option_form.hidden_field :_destroy, value: "" %>
          <button type="button" class="button button-secondary" data-action="question-form#removeOption"><%= t("overseer.questions.remove_option") %></button>
        </div>
      <% end %>
    </div>
    <template data-question-form-target="optionTemplate">
      <div class="flex items-center gap-3" data-option-row>
        <input type="text" name="question[possible_answers_attributes][__INDEX__][value]" placeholder="<%= t('overseer.questions.option_value') %>">
        <label class="flex items-center gap-1.5 text-sm whitespace-nowrap">
          <input type="checkbox" name="question[possible_answers_attributes][__INDEX__][correct]" value="1" class="size-4 accent-primary-600">
          <%= t("overseer.questions.option_correct") %>
        </label>
        <button type="button" class="button button-secondary" data-action="question-form#removeOption"><%= t("overseer.questions.remove_option") %></button>
      </div>
    </template>
    <button type="button" class="button button-secondary" data-action="question-form#addOption"><%= t("overseer.questions.add_option") %></button>
  </div>

  <%# --- Exact value --- %>
  <div class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4" data-question-form-target="section" data-answer-type="exact_value">
    <div>
      <%= label_tag "question_expected", t("overseer.questions.expected"), class: "block text-sm font-medium mb-1" %>
      <%= text_field_tag "question[expected]", grading["expected"] %>
    </div>
    <div>
      <%= label_tag "question_tolerance", t("overseer.questions.tolerance"), class: "block text-sm font-medium mb-1" %>
      <%= text_field_tag "question[tolerance]", grading["tolerance"] %>
    </div>
  </div>

  <%# --- Interactive --- %>
  <div class="hidden space-y-4" data-question-form-target="section" data-answer-type="interactive">
    <div class="sm:max-w-xs">
      <%= label_tag "question_widget", t("overseer.questions.widget"), class: "block text-sm font-medium mb-1" %>
      <%= select_tag "question[widget]",
            options_for_select(Widgets.keys.map { |key| [ t("widgets.#{key}"), key ] }, widget),
            data: { question_form_target: "widgetSelect", action: "question-form#updateWidget" } %>
    </div>

    <div class="hidden grid grid-cols-2 sm:grid-cols-5 gap-4" data-question-form-target="widgetSection" data-widget="number_line">
      <div>
        <%= label_tag "question_nl_min", t("overseer.questions.min"), class: "block text-sm font-medium mb-1" %>
        <%= number_field_tag "question[nl_min]", grading.dig("params", "min") || 0, step: "any" %>
      </div>
      <div>
        <%= label_tag "question_nl_max", t("overseer.questions.max"), class: "block text-sm font-medium mb-1" %>
        <%= number_field_tag "question[nl_max]", grading.dig("params", "max") || 10, step: "any" %>
      </div>
      <div>
        <%= label_tag "question_nl_step", t("overseer.questions.step"), class: "block text-sm font-medium mb-1" %>
        <%= number_field_tag "question[nl_step]", grading.dig("params", "step") || 1, step: "any" %>
      </div>
      <div>
        <%= label_tag "question_nl_solution", t("overseer.questions.solution_value"), class: "block text-sm font-medium mb-1" %>
        <%= number_field_tag "question[nl_solution]", grading.dig("solution", "value"), step: "any" %>
      </div>
      <div>
        <%= label_tag "question_nl_tolerance", t("overseer.questions.tolerance"), class: "block text-sm font-medium mb-1" %>
        <%= number_field_tag "question[nl_tolerance]", grading.dig("solution", "tolerance") || 0, step: "any" %>
      </div>
    </div>

    <div class="hidden" data-question-form-target="widgetSection" data-widget="ordering">
      <%= label_tag "question_ordering_items", t("overseer.questions.items_one_per_line"), class: "block text-sm font-medium mb-1" %>
      <%= text_area_tag "question[ordering_items]",
            Array(grading.dig("params", "items")).map { |item| item["label"] }.join("\n"),
            rows: 5 %>
    </div>

    <div class="hidden grid grid-cols-2 gap-4 sm:max-w-md" data-question-form-target="widgetSection" data-widget="fraction_bars">
      <div>
        <%= label_tag "question_fb_segments", t("overseer.questions.segments"), class: "block text-sm font-medium mb-1" %>
        <%= number_field_tag "question[fb_segments]", grading.dig("params", "segments") || 4, min: 2, max: 20 %>
      </div>
      <div>
        <%= label_tag "question_fb_shaded", t("overseer.questions.shaded"), class: "block text-sm font-medium mb-1" %>
        <%= number_field_tag "question[fb_shaded]", grading.dig("solution", "shaded"), min: 0 %>
      </div>
    </div>
  </div>

  <div>
    <span class="block text-sm font-medium mb-1"><%= t("overseer.questions.topics") %></span>
    <div class="flex flex-wrap gap-3">
      <% Topic.ordered.each do |topic| %>
        <label class="flex items-center gap-1.5 text-sm rounded-lg border border-gray-200 px-3 py-1.5 has-checked:border-primary-400 has-checked:bg-primary-50">
          <%= check_box_tag "question[topic_ids][]", topic.id, question.topic_ids.include?(topic.id), id: "question_topic_#{topic.id}", class: "size-4 accent-primary-600" %>
          <%= topic.name %>
        </label>
      <% end %>
    </div>
  </div>

  <div class="sm:max-w-xs">
    <%= f.label :image, t("overseer.questions.image"), class: "block text-sm font-medium mb-1" %>
    <%= f.file_field :image, accept: "image/*" %>
    <% if question.image %>
      <div class="mt-2 rounded-lg overflow-hidden max-w-48">
        <%= image_tag question.image.file, alt: "" %>
      </div>
    <% end %>
  </div>

  <div>
    <%= f.submit t("overseer.questions.save"), class: "button button-primary" %>
  </div>
<% end %>

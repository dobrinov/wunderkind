<%# The selected question, beside the list: the problem as a student meets
    it with the right answer marked, how it has fared, why the answer is what
    it is, and anyone waiting on a report. Swapped on its own when a row is
    chosen, so every link and form in it leaves the frame for the whole page. %>
<turbo-frame id="question-pane">
  <% if question %>
    <% split = @pane_split || QuestionStats::EMPTY %>
    <div class="flex flex-wrap items-center gap-2 border-b border-ink-100 px-4 py-3">
      <span class="text-meta font-extrabold text-ink-500">
        <%= question_number(question) %> · <%= t("overseer.questions.statuses.#{question.status}").downcase %>
      </span>
      <span class="ml-auto flex gap-1">
      <%= link_to t("overseer.questions.browser.as_student"),
                  preview_overseer_question_path(question, close_path: overseer_questions_path(@filter.to_params.merge(selected: question.id))),
                  class: "button button-quiet px-2.5", data: { turbo_frame: "_top" } %>
      <%= link_to t("overseer.questions.browser.edit"), edit_listed_question_path(question, @filter),
                  class: "button button-primary", data: { turbo_frame: "_top" } %>
      </span>
    </div>

    <div class="flex flex-col gap-3.5 bg-ink-50 px-4 py-5">
      <% if question.image %>
        <div class="flex justify-center overflow-hidden rounded-xl"><%= image_tag question.image.file, alt: "" %></div>
      <% end %>
      <%= question_body(question) %>
      <% if question.multiple_choice? %>
        <div class="grid grid-cols-2 gap-2.5">
          <% question.possible_answers.each do |option| %>
            <span class="flex min-h-13 items-center justify-center rounded-[14px] border-2 bg-white px-3 text-center text-lg font-black <%= option.correct? ? 'border-green-600 text-green-800' : 'border-ink-200 text-ink-800' %>">
              <% if option.correct? %><span class="sr-only"><%= t("overseer.questions.editor.correct_toggle") %>:</span><% end %>
              <%= math_value(option.value) %>
            </span>
          <% end %>
        </div>
      <% else %>
        <p class="text-ui font-semibold text-ink-600">
          <%= t("answers.correct_answer") %>: <strong class="text-green-800"><%= math_value(Grading.correct_answer_display(question).presence || "—") %></strong>
        </p>
      <% end %>
    </div>

    <dl class="grid grid-cols-3 gap-3 border-t border-ink-100 px-4 py-4">
      <div class="flex flex-col-reverse gap-0.5">
        <dt class="text-caption font-bold text-ink-500"><%= t("overseer.questions.browser.stat_elo") %></dt>
        <dd class="text-xl font-black tabular-nums"><%= number_with_delimiter(question.elo) %></dd>
      </div>
      <div class="flex flex-col-reverse gap-0.5">
        <dt class="text-caption font-bold text-ink-500"><%= t("overseer.questions.browser.stat_answers") %></dt>
        <dd class="text-xl font-black tabular-nums"><%= number_with_delimiter(split.total) %></dd>
      </div>
      <div class="flex flex-col-reverse gap-0.5">
        <dt class="text-caption font-bold text-ink-500"><%= t("overseer.questions.browser.stat_skipped") %></dt>
        <dd class="text-xl font-black tabular-nums <%= 'text-amber-700' if split.share(:skipped) >= QuestionFilter::SKIPPED_SHARE * 100 %>"><%= split.share(:skipped) %>%</dd>
      </div>
    </dl>

    <% if question.explanation.present? %>
      <div class="flex flex-col gap-1.5 border-t border-ink-100 px-4 py-3.5">
        <div class="text-caption font-black tracking-[.05em] text-ink-500 uppercase"><%= t("overseer.questions.browser.why") %></div>
        <div class="text-sm leading-relaxed whitespace-pre-line text-ink-700"><%= math_text(question.explanation) %></div>
      </div>
    <% end %>

    <% if (report = @pane_reports&.first) %>
      <div class="flex items-center gap-2.5 border-t border-ink-100 bg-red-50 px-4 py-3">
        <span class="flex-1 text-sm text-red-800" data-trace-mask>
          <strong><%= t("overseer.questions.browser.report_banner", count: @pane_reports.size) %></strong>
          · <%= t("overseer.questions.browser.report_from", reason: t("reports.reasons.#{report.reason}"), name: report.user&.short_name) %>
        </span>
        <%= link_to t("overseer.questions.browser.open_report"), overseer_question_report_path(report), class: "button button-secondary", data: { turbo_frame: "_top" } %>
      </div>
    <% end %>

    <div class="flex flex-wrap gap-1 border-t border-ink-100 px-3 py-2.5">
      <%= link_to t("overseer.questions.browser.hints"), edit_overseer_question_path(question, from: @filter.to_params, anchor: "hints"),
                  class: "button button-quiet px-2.5", data: { turbo_frame: "_top" } %>
      <%= link_to t("overseer.questions.browser.template"), overseer_questions_path(template: question.id, group: nil),
                  class: "button button-quiet px-2.5", data: { turbo_frame: "_top" } %>
      <% if question.published? %>
        <%= button_to t("overseer.questions.retire"), retire_overseer_question_path(question), class: "button button-quiet px-2.5 text-red-700",
                      form: { class: "inline-flex", data: { turbo_frame: "_top", turbo_confirm: t("overseer.questions.retire_confirm") } } %>
      <% elsif question.retired? %>
        <%= button_to t("overseer.questions.restore"), restore_overseer_question_path(question), class: "button button-quiet px-2.5",
                      form: { class: "inline-flex", data: { turbo_frame: "_top" } } %>
      <% end %>
    </div>
  <% else %>
    <p class="px-4 py-6 text-ui font-semibold text-ink-500"><%= t("overseer.questions.browser.nothing_selected") %></p>
  <% end %>
</turbo-frame>

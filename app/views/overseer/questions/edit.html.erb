<div class="page">
  <header>
    <h1><%= t("overseer.questions.edit") %></h1>
    <div class="flex gap-2">
      <%= link_to t("preview.open"), preview_overseer_question_path(@question, close_path: edit_overseer_question_path(@question)), class: "button button-secondary" %>
      <%= render "retirement", question: @question %>
    </div>
  </header>

  <%# Students are waiting on this question: the answer to them is written in
      the report queue, so say so here, where the fix is made. %>
  <% if @active_reports.to_i.positive? %>
    <p class="max-w-3xl mb-4 flex flex-wrap items-center gap-3 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800">
      <span>⚑ <%= t("overseer.questions.reports_waiting", count: @active_reports) %></span>
      <%= link_to t("overseer.questions.reports_answer"), overseer_question_reports_path(anchor: "question_#{@question.id}"), class: "font-bold underline" %>
    </p>
  <% end %>

  <% if @question.retired? %>
    <p class="max-w-3xl mb-4 rounded-lg bg-ink-100 px-4 py-3 text-sm text-ink-700"><%= t("overseer.questions.retired_note") %></p>
  <% end %>

  <main>
    <div class="card max-w-3xl">
      <section>
        <%= render "form", question: @question %>
      </section>
    </div>
  </main>
</div>

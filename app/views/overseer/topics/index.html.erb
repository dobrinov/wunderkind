<div class="page">
  <header>
    <h1><%= t("overseer.topics.title") %></h1>
    <%= link_to t("overseer.topics.new"), new_overseer_topic_path, class: "button button-primary" %>
  </header>

  <main>
    <% if @topics.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("overseer.topics.name") %></th>
            <th><%= t("overseer.topics.parent") %></th>
            <th><%= t("overseer.topics.questions_count") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @topics.each do |topic| %>
            <tr>
              <td><%= topic.name %></td>
              <td><%= topic.parent&.name || t("overseer.topics.no_parent") %></td>
              <td><%= topic.questions_count %></td>
              <td class="actions">
                <%= link_to t("overseer.topics.edit"), edit_overseer_topic_path(topic), class: "text-primary-600 hover:text-primary-800" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </main>
  <footer>
    <%= paginate @topics %>
  </footer>
</div>

<div class="page">
  <header class="flex-wrap">
    <div>
      <h1><%= t("overseer.topics.title") %></h1>
      <p class="text-sm font-bold text-ink-500">
        <%= t("overseer.topics.summary", areas: @areas.size, topics: @leaves.size) %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <nav class="segmented" aria-label="<%= t("overseer.topics.views_label") %>">
        <% Overseer::TopicsController::VIEWS.each do |view| %>
          <%= link_to t("overseer.topics.views.#{view}"), overseer_topics_path(view: view, selected: @selected&.id),
                      class: class_names("is-active": @view == view), aria: { current: (@view == view ? "page" : nil) } %>
        <% end %>
      </nav>
      <%= link_to new_overseer_topic_path, class: "button button-primary" do %>
        <%= render "shared/icon", name: :plus, size: 18 %>
        <%= t("overseer.topics.new") %>
      <% end %>
    </div>
  </header>

  <main class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="min-w-0" data-controller="topic-tree">
      <%= render @view, stats: @stats %>
    </div>

    <aside class="lg:sticky lg:top-4">
      <%= render "panel", detail: @detail, stats: @stats %>
    </aside>
  </main>
</div>

<%# The prerequisite graph laid out in columns by depth (see
    TopicsController#prerequisite_layers): everything a topic needs sits in a
    column to its left, so the map reads left to right the way a student
    meets the topics. Each node names what it waits for, which is the edge a
    drawn arrow would have been. %>
<% names = @leaves.to_h { |leaf| [ leaf.id, leaf.name ] } %>
<% selected_links = @selected ? [ *@requires.fetch(@selected.id, []), *@requires.select { |_, ids| ids.include?(@selected.id) }.keys ] : [] %>
<p class="mb-4 text-meta font-semibold text-ink-500"><%= t("overseer.topics.map.intro") %></p>
<div class="overflow-x-auto rounded-[20px] bg-white p-4 ring-1 ring-ink-150">
  <ol class="flex min-w-max items-start gap-4">
    <% @layers.each_with_index do |layer, index| %>
      <li class="flex w-48 flex-col gap-2">
        <h2 class="topic-section-title">
          <%= index.zero? ? t("overseer.topics.map.first") : t("overseer.topics.map.step", step: index + 1) %>
        </h2>
        <% layer.sort_by(&:name).each do |leaf| %>
          <% needs = @requires.fetch(leaf.id, []).filter_map { |id| names[id] } %>
          <%= topic_panel_link leaf, view: "map",
                class: class_names("flex flex-col items-start gap-0.5 rounded-[12px] px-3 py-2 text-left ring-1 hover:bg-ink-25",
                                   "ring-ink-150": leaf != @selected && !selected_links.include?(leaf.id),
                                   "bg-primary-600 text-white ring-primary-600 hover:bg-primary-700": leaf == @selected,
                                   "bg-primary-25 ring-primary-200": selected_links.include?(leaf.id)) do %>
            <span class="text-sm font-extrabold"><%= leaf.name %></span>
            <% if needs.any? %>
              <span class="text-caption font-bold <%= leaf == @selected ? "text-primary-100" : "text-ink-500" %>">
                <%= t("overseer.topics.map.needs", topics: needs.sort.join(", ")) %>
              </span>
            <% end %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ol>
</div>

<%= form_with model: [ :overseer, topic ], class: "space-y-4" do |f| %>
  <% if topic.errors.any? %>
    <div class="alert-danger">
      <div>
        <div>
          <p><%= topic.errors.full_messages.join(", ") %></p>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :name, t("overseer.topics.name"), class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :parent_id, t("overseer.topics.parent"), class: "block text-sm font-medium mb-1" %>
    <%= f.select :parent_id,
          Topic.ordered.where.not(id: topic.id).map { |candidate| [ candidate.name, candidate.id ] },
          include_blank: t("overseer.topics.no_parent") %>
  </div>

  <div>
    <span class="block text-sm font-medium mb-1"><%= t("overseer.topics.prerequisites") %></span>
    <p class="text-xs text-gray-500 mb-2"><%= t("overseer.topics.prerequisites_hint") %></p>
    <div class="flex flex-wrap gap-3">
      <% Topic.ordered.where.not(id: topic.id).each do |candidate| %>
        <label class="flex items-center gap-1.5 text-sm rounded-lg border border-gray-200 px-3 py-1.5 has-checked:border-primary-400 has-checked:bg-primary-50">
          <%= check_box_tag "topic[prerequisite_ids][]", candidate.id, topic.prerequisite_ids.include?(candidate.id), id: "topic_prerequisite_#{candidate.id}", class: "size-4 accent-primary-600" %>
          <%= candidate.name %>
        </label>
      <% end %>
    </div>
  </div>

  <div>
    <%= f.submit t("overseer.topics.save"), class: "button button-primary" %>
  </div>
<% end %>

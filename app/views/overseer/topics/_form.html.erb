<%# The topic editor. The fields are one form (#topic_form); the save bar's
    button and the danger zone's own forms sit outside it, the bar reaching it
    through `form=`, because forms cannot nest. %>
<% detail = @detail %>
<% leaf = topic.new_record? || topic.leaf? %>
<% saved_ids = topic.persisted? ? topic.prerequisite_ids : [] %>
<% chosen = Topic.where(id: topic.pending_prerequisite_ids).ordered.to_a %>
<% named_in_code = detail.grades.any? || detail.explainer || detail.competitions.any? %>
<div class="page gap-6!" data-controller="topic-form"
     data-topic-form-one-value="<%= t("overseer.topics.unsaved.one") %>"
     data-topic-form-other-value="<%= t("overseer.topics.unsaved.other") %>"
     data-topic-form-new-note-value="<%= t("overseer.topics.path.new_note") %>"
     data-topic-form-remove-value="<%= t("overseer.topics.prerequisites_remove") %>"
     data-topic-form-nothing-value="<%= t("overseer.topics.prerequisites_nothing") %>">
  <div class="topic-savebar">
    <%= link_to overseer_topics_path(selected: topic.id), class: "button button-quiet px-2!", aria: { label: t("overseer.topics.back") } do %>
      <%= render "shared/icon", name: :back, size: 20 %>
    <% end %>
    <p class="min-w-0 flex-1 truncate text-ui font-black">
      <% if topic.new_record? %>
        <%= t("overseer.topics.new") %>
      <% else %>
        <span class="font-bold text-ink-500"><%= topic.parent ? "#{topic.parent.name} ›" : t("overseer.topics.panel.area") %></span>
        <%= topic.name_was %>
      <% end %>
    </p>
    <span class="text-meta font-extrabold text-amber-700" data-topic-form-target="count" hidden></span>
    <%= link_to t("overseer.topics.cancel"), overseer_topics_path(selected: topic.id), class: "button button-quiet" %>
    <%= button_tag t("overseer.topics.save"), type: "submit", form: "topic_form", class: "button button-primary" %>
  </div>

  <% if topic.errors.any? %>
    <div class="alert-danger" role="alert">
      <div><div><p><%= topic.errors.full_messages.join(" ") %></p></div></div>
    </div>
  <% end %>

  <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="flex min-w-0 flex-col gap-6">
      <%= form_with model: [ :overseer, topic ], id: "topic_form", class: "card",
                    data: { action: "input->topic-form#track change->topic-form#track" } do |f| %>
        <section class="flex flex-col gap-3">
          <h2 class="text-base font-black"><%= t("overseer.topics.place") %></h2>
          <div class="field">
            <%= f.label :name, t("overseer.topics.name") %>
            <%= f.text_field :name, required: true, autocomplete: "off" %>
            <% if topic.persisted? && named_in_code %>
              <p class="field-hint"><%= t("overseer.topics.name_in_code") %></p>
            <% end %>
          </div>
          <div class="field">
            <%= f.label :parent_id, t("overseer.topics.parent") %>
            <%= f.select :parent_id, @areas.map { |area| [ area.name, area.id ] }, include_blank: t("overseer.topics.no_parent") %>
            <% if topic.persisted? && topic.area? && topic.children.any? %>
              <p class="field-hint"><%= t("overseer.topics.area_guard", count: topic.children.size) %></p>
            <% elsif topic.persisted? && topic.leaf? && detail.question_count.positive? %>
              <p class="field-hint"><%= t("overseer.topics.leaf_guard", count: detail.question_count) %></p>
            <% else %>
              <p class="field-hint"><%= t("overseer.topics.parent_hint") %></p>
            <% end %>
          </div>
        </section>

        <% if leaf %>
          <section class="flex flex-col gap-2">
            <h2 class="text-base font-black"><%= t("overseer.topics.address") %></h2>
            <% if topic.slug.present? %>
              <p class="break-all text-ui font-bold text-ink-600">
                <%= Seo.origin.delete_prefix("https://") %>/matematika/tema/<b class="text-ink-900"><%= topic.slug_was || topic.slug %></b>
              </p>
              <p class="field-hint"><%= t("overseer.topics.address_hint") %></p>
            <% else %>
              <p class="field-hint"><%= t("overseer.topics.address_new") %></p>
            <% end %>
            <% if topic.previous_slugs.any? %>
              <p class="field-hint">
                <%= t("overseer.topics.previous_slugs", slugs: topic.previous_slugs.map { |slug| "/matematika/tema/#{slug}" }.join(", ")) %>
              </p>
            <% end %>
          </section>

          <section class="flex flex-col gap-3">
            <h2 class="text-base font-black"><%= t("overseer.topics.prerequisites") %></h2>
            <p class="field-hint"><%= t("overseer.topics.prerequisites_hint", name: topic.name.presence || t("overseer.topics.path.this")) %></p>

            <%# Enhanced by topic-form into chips and a search box; without
                JavaScript it is the multi-select it is built on. A topic that
                already requires this one is disabled and says why. %>
            <div class="flex flex-col gap-2" data-topic-form-target="picker" hidden>
              <div class="flex flex-wrap gap-2" data-topic-form-target="chips"></div>
              <input type="search" data-topic-form-target="search" autocomplete="off"
                     placeholder="<%= t("overseer.topics.prerequisites_search") %>"
                     aria-label="<%= t("overseer.topics.prerequisites_search") %>"
                     data-action="input->topic-form#filter focus->topic-form#filter keydown.esc->topic-form#close">
              <div class="flex flex-col" data-topic-form-target="suggestions"></div>
            </div>

            <%= hidden_field_tag "topic[pending_prerequisite_ids][]", "", id: nil %>
            <select multiple size="10" name="topic[pending_prerequisite_ids][]" id="topic_pending_prerequisite_ids"
                    data-topic-form-target="select" aria-label="<%= t("overseer.topics.prerequisites") %>">
              <% @candidates.group_by(&:parent).sort_by { |area, _| [ area.position, area.name ] }.each do |area, leaves| %>
                <optgroup label="<%= area.name %>">
                  <% leaves.each do |candidate| %>
                    <% chain = @blocked[candidate.id] %>
                    <% reason = chain && t("overseer.topics.prerequisites_blocked", chain: chain.map { |name| "„#{name}“" }.join(" → ")) %>
                    <option value="<%= candidate.id %>" <%= "selected" if topic.pending_prerequisite_ids.include?(candidate.id) %>
                            <%= "disabled" if chain %> data-reason="<%= reason %>"
                            data-saved="<%= saved_ids.include?(candidate.id) %>"><%= candidate.name %><%= " — #{reason}" if reason %></option>
                  <% end %>
                </optgroup>
              <% end %>
            </select>
          </section>
        <% end %>
      <% end %>

      <% if topic.persisted? %>
        <section class="card">
          <section class="flex flex-col gap-3">
            <h2 class="text-base font-black"><%= t("overseer.topics.questions") %></h2>
            <p class="text-ui font-bold text-ink-700">
              <%= %w[published draft in_review private_library retired].filter_map { |status|
                    count = detail.status_counts.fetch(status, 0)
                    t("overseer.topics.status_counts.#{status}", count: count) if count.positive? || status == "published"
                  }.join(" · ") %>
            </p>
            <div>
              <%= link_to t("overseer.topics.open_questions"), overseer_questions_path(topic_id: topic.id), class: "button button-secondary" %>
            </div>
            <% if topic.leaf? %>
              <p class="field-hint"><%= t("overseer.topics.leaf_note") %></p>
            <% else %>
              <p class="field-hint"><%= t("overseer.topics.area_note") %></p>
              <div class="flex flex-col">
                <% topic.children.ordered.each do |child| %>
                  <%= link_to child.name, edit_overseer_topic_path(child), class: "flex min-h-11 items-center border-t border-ink-100 text-ui font-bold text-ink-800 hover:text-primary-700" %>
                <% end %>
              </div>
              <div><%= link_to t("overseer.topics.new_in_area"), new_overseer_topic_path(parent_id: topic.id), class: "link-cta" %></div>
            <% end %>
          </section>
        </section>

        <section class="card ring-red-200">
          <section class="flex flex-col gap-3">
            <h2 class="text-base font-black text-red-800"><%= t("overseer.topics.danger") %></h2>
            <% if @merge_targets %>
              <%= form_with url: merge_overseer_topic_path(topic), method: :post, class: "flex flex-col gap-2",
                            data: { turbo_confirm: t("overseer.topics.merge_confirm", name: topic.name) } do %>
                <div class="field">
                  <%= label_tag :into_id, t("overseer.topics.merge") %>
                  <%= select_tag :into_id,
                        grouped_options_for_select(@merge_targets.group_by { |candidate| candidate.parent.name }
                                                                 .transform_values { |leaves| leaves.map { |candidate| [ candidate.name, candidate.id ] } }),
                        include_blank: t("overseer.topics.merge_pick"), required: true %>
                </div>
                <p class="field-hint">
                  <%= t("overseer.topics.merge_hint", questions: detail.question_count, students: detail.skills_count) %>
                </p>
                <div><%= submit_tag t("overseer.topics.merge_submit"), class: "button button-danger" %></div>
              <% end %>
            <% end %>

            <% if detail.question_count.zero? && topic.children.none? %>
              <%= button_to t("overseer.topics.delete"), overseer_topic_path(topic), method: :delete, class: "button button-danger",
                            form: { data: { turbo_confirm: t("overseer.topics.delete_confirm", name: topic.name) } } %>
            <% else %>
              <p class="field-hint"><%= t("overseer.topics.delete_blocked") %></p>
            <% end %>
          </section>
        </section>
      <% end %>
    </div>

    <aside class="flex flex-col gap-6">
      <% if leaf %>
        <section class="card">
          <section>
            <h3 class="topic-section-title"><%= t("overseer.topics.path.title") %></h3>
            <%= render "path", detail: detail, prerequisites: chosen, saved_ids: saved_ids %>
            <p class="mt-3 text-meta font-semibold text-ink-600" data-topic-form-target="pathNote"
               <%= "hidden" if (chosen.map(&:id) - saved_ids).empty? %>>
              <%= t("overseer.topics.path.new_note", topics: chosen.reject { |p| saved_ids.include?(p.id) }.map { |p| "„#{p.name}“" }.join(", ")) %>
            </p>
            <p class="mt-2 text-meta font-semibold text-ink-500"><%= t("overseer.topics.path.rule") %></p>
          </section>
        </section>

        <section class="card">
          <section>
            <h3 class="topic-section-title"><%= t("overseer.topics.grades_title") %></h3>
            <%= render "grades_strip", detail: detail %>
          </section>
        </section>
      <% end %>

      <% if topic.persisted? %>
        <section class="card">
          <section>
            <h3 class="topic-section-title"><%= t("overseer.topics.seen.title") %></h3>
            <ul class="flex flex-col divide-y divide-ink-100 text-ui font-bold text-ink-800">
              <% if detail.public_page? %>
                <li class="flex min-h-11 items-center justify-between gap-3 py-1">
                  <%= link_to t("overseer.topics.seen.public"), curriculum_topic_path(topic.slug), class: "hover:text-primary-700" %>
                  <span class="text-meta text-ink-500"><%= detail.indexed? ? t("overseer.topics.seen.indexed") : t("overseer.topics.seen.not_indexed", minimum: Curriculum::MINIMUM_PER_TOPIC) %></span>
                </li>
              <% end %>
              <% if (article = detail.explainer) %>
                <li class="flex min-h-11 items-center justify-between gap-3 py-1">
                  <%= link_to t("overseer.topics.seen.explainer", title: article.title), explainer_path(article.slug), class: "hover:text-primary-700" %>
                  <span class="text-meta text-ink-500"><%= t("overseer.topics.seen.article") %></span>
                </li>
              <% end %>
              <% if detail.grade_pages.any? %>
                <li class="flex min-h-11 items-center justify-between gap-3 py-1">
                  <span><%= t("overseer.topics.seen.grade_pages", grades: detail.grade_pages.map(&:number).to_sentence(words_connector: ", ", last_word_connector: t("overseer.topics.seen.and"), two_words_connector: t("overseer.topics.seen.and"))) %></span>
                  <span class="text-meta text-ink-500"><%= detail.grade_pages.size %></span>
                </li>
              <% end %>
              <% if detail.competitions.any? %>
                <li class="py-1">
                  <details>
                    <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-3">
                      <span><%= t("overseer.topics.seen.competitions") %></span>
                      <span class="text-meta text-ink-500"><%= detail.competitions.size %></span>
                    </summary>
                    <p class="pb-2 text-meta font-semibold text-ink-600"><%= detail.competitions.map { |event| event.name.to_s }.join(" · ") %></p>
                  </details>
                </li>
              <% end %>
              <li class="flex min-h-11 items-center justify-between gap-3 py-1">
                <span><%= t("overseer.topics.seen.focus") %></span>
                <span class="text-meta text-ink-500"><%= t("overseer.topics.seen.focus_count", count: detail.active_focuses) %></span>
              </li>
            </ul>
          </section>
        </section>
      <% end %>
    </aside>
  </div>
</div>

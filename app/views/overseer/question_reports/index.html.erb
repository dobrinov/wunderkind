<div class="page">
  <header>
    <h1><%= t("overseer.reports.title") %></h1>
  </header>

  <main>
    <% if @questions.any? %>
      <div class="space-y-4 max-w-3xl">
        <% @questions.each do |question| %>
          <% active = question.reports.select { |report| report.status.in?(QuestionReport::ACTIVE) }.sort_by(&:updated_at).reverse %>
          <div class="card">
            <header class="flex flex-wrap justify-between items-center gap-3">
              <span class="text-sm text-ink-500">
                <%= t("overseer.reports.count", count: active.size) %>
                · <%= t("overseer.questions.statuses.#{question.status}") %>
                · <%= question.elo %>
                <% if question.topics.any? %>· <%= question.topics.map(&:name).join(", ") %><% end %>
              </span>
              <div class="flex flex-wrap gap-2">
                <%= link_to t("overseer.reports.edit"), edit_overseer_question_path(question), class: "button button-secondary" %>
                <%= link_to t("preview.open"), preview_overseer_question_path(question, close_path: overseer_question_reports_path), class: "button button-secondary" %>
              </div>
            </header>

            <section>
              <%= question_body(question) %>
              <p class="mt-3 text-sm text-ink-500">
                <%= t("answers.correct_answer") %>:
                <strong>
                  <% if question.multiple_choice? %>
                    <%= question.correct_possible_answers.map(&:value).join(", ") %>
                  <% else %>
                    <%= Grading.correct_answer_display(question) %>
                  <% end %>
                </strong>
              </p>

              <%# One conversation per student, like a ticket each: what they
                  reported, then the thread. With several students on one
                  question each gets their own reply box; the box at the foot
                  speaks to all of them (and is the only one when there is one). %>
              <ul class="mt-4 space-y-3">
                <% active.each do |report| %>
                  <li class="rounded-xl bg-ink-50 px-4 py-3" id="<%= dom_id(report) %>">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-sm font-semibold text-ink-800"><%= report.user.name %></span>
                      <%= render "reports/status", report: report %>
                      <% if report.awaiting_team? %>
                        <span class="rounded-full bg-red-50 px-2.5 py-1 text-caption font-extrabold text-red-700"><%= t("overseer.reports.awaiting") %></span>
                      <% end %>
                    </div>
                    <div class="mt-2 text-sm font-semibold text-ink-800">⚑ <%= t("reports.reasons.#{report.reason}") %></div>
                    <% if report.note.present? %>
                      <p class="mt-1 text-sm text-ink-700 whitespace-pre-line"><%= report.note %></p>
                    <% end %>
                    <div class="mt-1 text-xs text-ink-400"><%= l report.created_at, format: :short %></div>

                    <% if report.messages.any? %>
                      <ul class="mt-3 flex flex-col gap-2">
                        <% report.messages.each do |message| %>
                          <%= render "reports/message", message: message, viewer: :team %>
                        <% end %>
                      </ul>
                      <p class="mt-1 text-xs text-ink-400">
                        <%= report.unread? ? t("overseer.reports.reply_unseen") : t("overseer.reports.reply_seen") %>
                      </p>
                    <% end %>

                    <% if active.size > 1 %>
                      <%= render "form", question: question, report: report, label: t("overseer.reports.reply_to", name: report.user.name) %>
                    <% end %>
                  </li>
                <% end %>
              </ul>

              <%= render "form", question: question, report: nil,
                         label: active.size > 1 ? t("overseer.reports.reply_all", count: active.size) : t("overseer.reports.reply_to", name: active.first.user.name) %>
            </section>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="alert-info"><div><div><p><%= t("overseer.reports.empty") %></p></div></div></div>
    <% end %>
  </main>
  <footer>
    <%= paginate @questions %>
  </footer>
</div>

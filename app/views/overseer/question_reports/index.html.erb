<div class="page">
  <header>
    <h1><%= t("overseer.reports.title") %></h1>
  </header>

  <main>
    <% if @questions.any? %>
      <div class="space-y-4 max-w-3xl">
        <% @questions.each do |question| %>
          <% open_reports = question.reports.select(&:open?).sort_by(&:created_at).reverse %>
          <div class="card">
            <header class="flex flex-wrap justify-between items-center gap-3">
              <span class="text-sm text-ink-500">
                <%= t("overseer.reports.count", count: open_reports.size) %>
                · <%= t("overseer.questions.statuses.#{question.status}") %>
                · <%= question.elo %>
                <% if question.topics.any? %>· <%= question.topics.map(&:name).join(", ") %><% end %>
              </span>
              <div class="flex flex-wrap gap-2">
                <%= link_to t("overseer.reports.edit"), edit_overseer_question_path(question), class: "button button-secondary" %>
                <%= link_to t("preview.open"), preview_overseer_question_path(question, close_path: overseer_question_reports_path), class: "button button-secondary" %>
              </div>
            </header>

            <section>
              <%= question_body(question) %>
              <p class="mt-3 text-sm text-ink-500">
                <%= t("answers.correct_answer") %>:
                <strong>
                  <% if question.multiple_choice? %>
                    <%= question.correct_possible_answers.map(&:value).join(", ") %>
                  <% else %>
                    <%= Grading.correct_answer_display(question) %>
                  <% end %>
                </strong>
              </p>

              <%# What the students actually said, newest first. The reason is
                  the signal; the note is where the useful detail usually is. %>
              <ul class="mt-4 space-y-2">
                <% open_reports.each do |report| %>
                  <li class="rounded-xl bg-ink-50 px-4 py-3">
                    <div class="text-sm font-semibold text-ink-800">⚑ <%= t("reports.reasons.#{report.reason}") %></div>
                    <% if report.note.present? %>
                      <p class="mt-1 text-sm text-ink-700 whitespace-pre-line"><%= report.note %></p>
                    <% end %>
                    <div class="mt-1 text-xs text-ink-400">
                      <%= report.user.name %> · <%= l report.created_at, format: :short %>
                    </div>

                    <%# A word to this one student, leaving the report open. %>
                    <% if report.response.present? %>
                      <p class="mt-2 border-l-2 border-primary-300 pl-3 text-sm text-ink-700 whitespace-pre-line"><%= report.response %></p>
                      <p class="mt-1 text-xs text-ink-400">
                        <%= report.response_seen_at ? t("overseer.reports.reply_seen") : t("overseer.reports.reply_unseen") %>
                      </p>
                    <% end %>
                    <details class="mt-2">
                      <summary class="cursor-pointer text-sm font-extrabold text-primary-700">
                        <%= report.response.present? ? t("overseer.reports.reply_again") : t("overseer.reports.reply") %>
                      </summary>
                      <%= form_with url: reply_overseer_question_report_path(question), method: :post, class: "mt-2 flex flex-col gap-2" do %>
                        <%= hidden_field_tag :report_id, report.id, id: nil %>
                        <%= text_area_tag :response, nil, id: "reply_#{report.id}", rows: 2, required: true,
                                          maxlength: QuestionReport::RESPONSE_LIMIT,
                                          aria: { label: t("overseer.reports.reply_to", name: report.user.name) },
                                          placeholder: t("overseer.reports.reply_placeholder") %>
                        <%= button_tag t("overseer.reports.reply_send"), class: "button button-secondary self-start" %>
                      <% end %>
                    </details>
                  </li>
                <% end %>
              </ul>

              <%# The answer goes back to every student in the pile and is shown
                  on their „Днес". One box, three ways to close: fixed (the
                  reply is optional — they are told it was fixed either way),
                  nothing wrong (the reply is the reason, and required unless
                  every student has had one of their own), or taken out of
                  circulation. Left blank, a student's own reply stands. %>
              <%= form_with url: resolve_overseer_question_report_path(question), method: :post, class: "mt-4" do %>
                <div class="field">
                  <%= label_tag "response_#{question.id}", t("overseer.reports.response") %>
                  <%= text_area_tag :response, nil, id: "response_#{question.id}", rows: 3,
                                    maxlength: QuestionReport::RESPONSE_LIMIT,
                                    placeholder: t("overseer.reports.response_placeholder") %>
                  <p class="field-hint"><%= t("overseer.reports.response_hint") %></p>
                </div>
                <div class="mt-3 flex flex-wrap gap-2">
                  <%= button_tag t("overseer.reports.resolve"), class: "button button-primary" %>
                  <%= button_tag t("overseer.reports.dismiss"), formaction: dismiss_overseer_question_report_path(question), class: "button button-secondary" %>
                  <% if question.published? %>
                    <%= button_tag t("overseer.reports.withdraw"), formaction: withdraw_overseer_question_report_path(question), class: "button button-danger" %>
                  <% end %>
                </div>
              <% end %>
            </section>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="alert-info"><div><div><p><%= t("overseer.reports.empty") %></p></div></div></div>
    <% end %>
  </main>
  <footer>
    <%= paginate @questions %>
  </footer>
</div>

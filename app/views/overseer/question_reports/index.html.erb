<%# Reports as a list of tickets, like an issue tracker: one row per student's
    report, filtered by where it stands — waiting on us first, since that is
    the work — and optionally by question. A row opens the ticket. %>
<div class="page">
  <header>
    <h1><%= t("overseer.reports.title") %></h1>
  </header>

  <main>
    <div class="mb-4 flex flex-wrap items-center gap-3">
      <nav class="segmented" aria-label="<%= t("overseer.reports.title") %>">
        <% Overseer::QuestionReportsController::FILTERS.each do |filter| %>
          <%= link_to overseer_question_reports_path(filter: filter, question_id: @question&.id),
                      class: ("is-active" if @filter == filter), "aria-current": ("page" if @filter == filter) do %>
            <span><%= t("overseer.reports.filters.#{filter}") %></span>
            <% if @counts[filter] %><span class="segmented-count"><%= @counts[filter] %></span><% end %>
          <% end %>
        <% end %>
      </nav>
      <% if @question %>
        <span class="rounded-full bg-ink-100 px-3 py-1 text-sm text-ink-700">
          <%= t("overseer.reports.for_question", id: @question.id) %>
          <%= link_to "×", overseer_question_reports_path(filter: @filter), class: "ml-1 font-bold", "aria-label": t("browse.clear") %>
        </span>
      <% end %>
    </div>

    <% if @reports.any? %>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th><%= t("overseer.reports.columns.question") %></th>
            <th><%= t("overseer.reports.columns.reason") %></th>
            <th><%= t("overseer.reports.columns.reporter") %></th>
            <th><%= t("overseer.reports.columns.status") %></th>
            <th><%= t("overseer.reports.columns.updated") %></th>
          </tr>
        </thead>
        <tbody>
          <% @reports.each do |report| %>
            <tr>
              <td class="font-mono"><%= link_to report.id, overseer_question_report_path(report), class: "underline" %></td>
              <td class="whitespace-normal max-w-lg">
                <%= link_to report.question.body_text.truncate(110), overseer_question_report_path(report), class: "font-medium text-ink-900 hover:underline" %>
                <% if report.note.present? %>
                  <div class="mt-0.5 text-xs text-ink-500">„<%= report.note.truncate(90) %>“</div>
                <% end %>
              </td>
              <td class="whitespace-normal max-w-48 text-sm"><%= t("reports.reasons.#{report.reason}") %></td>
              <td class="text-sm"><%= report.user.name %></td>
              <td>
                <div class="flex flex-wrap items-center gap-1.5">
                  <%= render "reports/status", report: report %>
                  <% if report.awaiting_team? %>
                    <span class="rounded-full bg-red-50 px-2 py-0.5 text-xs font-bold text-red-700"><%= t("overseer.reports.awaiting") %></span>
                  <% end %>
                </div>
              </td>
              <td class="text-sm text-ink-500"><%= l report.updated_at, format: :short %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="alert-info"><div><div><p><%= t("overseer.reports.empty") %></p></div></div></div>
    <% end %>
  </main>
  <footer>
    <%= paginate @reports %>
  </footer>
</div>

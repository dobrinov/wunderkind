<%# One ticket, full page. Along the top: back to the inbox view it was opened
    from, with its place in it („3 от 11") and the previous and next ticket
    there. The main column is the work — the question as the reporter saw it
    beside how it is now (or the suggested problem), the conversation, and
    the box to answer in as „Екипът на Wunderkind". The side column is the
    ticket: its state as four choices, the people, the other tickets on the
    same question, and what can be done to the question itself. %>
<% report = @report %>
<% question = report.question %>
<% inbox = @inbox.params %>
<% here = overseer_question_report_path(report, inbox) %>
<% active_related = @related.select { |other| other.status.in?(QuestionReport::ACTIVE) && other.report? } %>
<div class="flex flex-col gap-4">
  <div class="flex flex-wrap items-center gap-2.5">
    <%= link_to overseer_inbox_path(inbox.merge(ticket: report.id)), class: "button button-quiet -ml-2 px-2.5" do %>
      <%= render "shared/icon", name: :back, size: 18 %>
      <span>
        <%= t("overseer.inbox.title") %> · „<%= t("overseer.inbox.filters.#{@inbox.filter}") %>“
        <% if @position %>· <%= t("overseer.inbox.position", index: @position[:index], total: @position[:total]) %><% end %>
      </span>
    <% end %>
    <% if @position %>
      <% [ [ :previous, :chevron_up ], [ :next, :chevron_down ] ].each do |direction, icon| %>
        <% if (id = @position[direction]) %>
          <%= link_to overseer_question_report_path(id, inbox), class: "button button-secondary px-3", "aria-label": t("overseer.inbox.#{direction}") do %>
            <%= render "shared/icon", name: icon, size: 18 %>
          <% end %>
        <% else %>
          <span class="button button-secondary px-3 opacity-40" aria-hidden="true"><%= render "shared/icon", name: icon, size: 18 %></span>
        <% end %>
      <% end %>
    <% end %>
    <%= render "overseer/tickets/tag", report: report %>
    <h1 class="min-w-0 text-xl font-black"><%= question.body_text.truncate(90) %></h1>
    <span class="text-meta font-semibold text-muted"><%= t("overseer.reports.ticket", id: report.id) %> · №<%= question.id %></span>
  </div>

  <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
    <div class="flex min-w-0 flex-col gap-4">
      <%= render "overseer/tickets/question", report: report, return_to: here %>

      <section class="card" aria-label="<%= t("overseer.reports.activity") %>">
        <section><%= render "overseer/tickets/thread", report: report %></section>
      </section>

      <section class="card ring-2 ring-primary-200" aria-label="<%= t("overseer.inbox.reply") %>">
        <section>
          <%= render "overseer/tickets/composer", report: report, active_related: active_related, return_to: here,
                                                  own_child: @my_children_ids.include?(report.user_id) %>
        </section>
      </section>
    </div>

    <aside class="flex flex-col gap-4">
      <section class="card">
        <header><h2 class="text-lg font-bold"><%= t("overseer.reports.columns.status") %></h2></header>
        <section><%= render "overseer/tickets/status_form", report: report, active_related: active_related, return_to: here %></section>
      </section>

      <% if @checks %>
        <section class="card">
          <header><h2 class="text-lg font-bold"><%= t("overseer.inbox.checks_title") %></h2></header>
          <section><%= render "overseer/tickets/checks", checks: @checks %></section>
        </section>
      <% end %>

      <section class="card">
        <header><h2 class="text-lg font-bold"><%= t("overseer.inbox.people") %></h2></header>
        <section><%= render "overseer/tickets/people", report: report %></section>
      </section>

      <% if @related.any? %>
        <section class="card">
          <header><h2 class="text-lg font-bold"><%= t("overseer.inbox.same_question") %></h2></header>
          <section><%= render "overseer/tickets/related", related: @related %></section>
        </section>
      <% end %>

      <section class="card">
        <header><h2 class="text-lg font-bold"><%= t("overseer.inbox.actions") %></h2></header>
        <section class="flex flex-col items-start gap-1">
          <%= link_to t("overseer.reports.edit"), edit_overseer_question_path(question, return_to: here), class: "button button-quiet -ml-3" %>
          <%= link_to t("preview.open"), preview_overseer_question_path(question, close_path: here), class: "button button-quiet -ml-3" %>
          <p class="py-2 text-meta font-semibold text-muted">
            <%= t("overseer.inbox.same_template", count: @template[:count]) %>
          </p>
          <% if report.decidable? %>
            <%= link_to t("overseer.inbox.review_mode"), overseer_inbox_review_path(ticket: report.id), class: "button button-quiet -ml-3" %>
          <% end %>
          <% if question.published? %>
            <%= button_to t("overseer.reports.withdraw"), withdraw_overseer_question_report_path(report),
                          params: { return_to: here }, form_class: "-ml-3",
                          class: "button button-quiet text-red-700", data: { turbo_confirm: t("overseer.reports.withdraw_confirm") } %>
            <p class="text-caption font-semibold text-muted"><%= t("overseer.reports.withdraw_hint") %></p>
          <% end %>
        </section>
      </section>
    </aside>
  </div>
</div>

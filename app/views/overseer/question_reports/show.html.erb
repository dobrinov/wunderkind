<%# One report as a ticket. The main column is the work — the question, what
    the student said, and the conversation with a comment box under it; the
    side column is the ticket's state — the status dropdown, the details, the
    other reports on the same question, and taking the question out. %>
<% report = @report %>
<% question = report.question %>
<% active_related = @related.select { |other| other.status.in?(QuestionReport::ACTIVE) } %>
<div class="page">
  <header>
    <div>
      <%= link_to "← #{t("overseer.reports.title")}", overseer_question_reports_path, class: "text-sm text-ink-500 hover:underline" %>
      <h1 class="mt-1"><%= t("overseer.reports.ticket", id: report.id) %></h1>
      <div class="mt-1 flex flex-wrap items-center gap-2">
        <%= render "reports/status", report: report %>
        <% if report.awaiting_team? %>
          <span class="rounded-full bg-red-50 px-2.5 py-1 text-caption font-extrabold text-red-700"><%= t("overseer.reports.awaiting") %></span>
        <% end %>
      </div>
    </div>
  </header>

  <main class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
    <div class="flex min-w-0 flex-col gap-5">
      <section class="card">
        <header class="flex flex-wrap items-center justify-between gap-3">
          <span class="text-sm text-ink-500">
            №<%= question.id %> · <%= t("overseer.questions.statuses.#{question.status}") %> · <%= question.elo %>
          </span>
          <div class="flex flex-wrap gap-2">
            <%= link_to t("overseer.reports.edit"), edit_overseer_question_path(question, return_to: overseer_question_report_path(report)), class: "button button-secondary" %>
            <%= link_to t("preview.open"), preview_overseer_question_path(question, close_path: overseer_question_report_path(report)), class: "button button-secondary" %>
          </div>
        </header>
        <section>
          <%= question_body(question) %>
          <p class="mt-3 text-sm text-ink-500">
            <%= t("answers.correct_answer") %>: <strong><%= Grading.correct_answer_display(question) %></strong>
          </p>
          <% changes = report.changes_since_report %>
          <% if changes.present? %>
            <p class="mt-2 text-sm text-ink-500">
              <%= t("overseer.reports.changed_since", fields: changes.map { |field| t("report_thread.fields.#{field}") }.join(", ")) %>
            </p>
          <% end %>
        </section>
      </section>

      <section class="card">
        <header><h2 class="text-lg font-bold"><%= t("overseer.reports.description") %></h2></header>
        <section>
          <div class="text-sm font-semibold text-ink-800">⚑ <%= t("reports.reasons.#{report.reason}") %></div>
          <% if report.note.present? %>
            <p class="mt-1 text-ink-700 whitespace-pre-line"><%= report.note %></p>
          <% else %>
            <p class="mt-1 text-sm text-ink-400"><%= t("overseer.reports.no_note") %></p>
          <% end %>
        </section>
      </section>

      <section class="card">
        <header><h2 class="text-lg font-bold"><%= t("overseer.reports.activity") %></h2></header>
        <section>
          <% if report.messages.any? %>
            <ul class="flex flex-col gap-2.5">
              <% report.messages.each do |message| %>
                <%= render "reports/message", message: message, viewer: :team %>
              <% end %>
            </ul>
            <p class="mt-2 text-xs text-ink-400">
              <%= report.unread? ? t("overseer.reports.reply_unseen") : t("overseer.reports.reply_seen") %>
            </p>
          <% else %>
            <p class="text-sm text-ink-400"><%= t("overseer.reports.no_activity") %></p>
          <% end %>

          <%= form_with url: comment_overseer_question_report_path(report), method: :post, class: "mt-4 flex flex-col gap-3" do %>
            <div class="field">
              <%= label_tag :comment_body, t("overseer.reports.comment_label") %>
              <%= text_area_tag :body, nil, id: "comment_body", rows: 3, maxlength: QuestionReport::MESSAGE_LIMIT,
                                placeholder: t("overseer.reports.comment_placeholder") %>
              <p class="field-hint"><%= t("overseer.reports.comment_hint") %></p>
            </div>
            <details>
              <summary class="cursor-pointer text-sm font-bold text-primary-700"><%= t("overseer.reports.attach_version") %></summary>
              <div class="field mt-2">
                <%= label_tag :comment_corrected, t("overseer.reports.corrected_label"), class: "sr-only" %>
                <%= text_field_tag :corrected_question, nil, id: "comment_corrected", inputmode: "url",
                                   placeholder: t("overseer.reports.corrected_placeholder") %>
              </div>
            </details>
            <% if active_related.any? %>
              <label class="flex items-center gap-2 text-sm">
                <%= check_box_tag :apply_to_related, "1", false, id: "comment_apply" %>
                <%= t("overseer.reports.apply_to_related", count: active_related.size) %>
              </label>
            <% end %>
            <div><%= button_tag t("overseer.reports.comment_submit"), class: "button button-primary" %></div>
          <% end %>
        </section>
      </section>
    </div>

    <aside class="flex flex-col gap-5">
      <%# The status dropdown. What a status needs comes with it and shows only
          when it is chosen (CSS :has, no script): fixed asks for the fixed
          version — this question if it was edited in place, which is the
          default — and „not a problem" for the explanation the student reads.
          Anything else for the student is a comment, in the box under the
          conversation; the dropdown carries no message of its own. %>
      <section class="card">
        <header><h2 class="text-lg font-bold"><%= t("overseer.reports.columns.status") %></h2></header>
        <section>
          <%= form_with url: transition_overseer_question_report_path(report), method: :post, class: "ticket-status flex flex-col gap-3" do %>
            <div class="field">
              <%= label_tag :status, t("overseer.reports.change_status") %>
              <%= select_tag :status,
                    options_for_select(
                      (report.open? ? [ [ t("report_thread.statuses.open"), "open", { disabled: true } ] ] : []) +
                      %w[in_progress resolved dismissed].map { |status| [ t("report_thread.statuses.#{status}"), status ] },
                      report.status) %>
            </div>

            <div class="ticket-if-resolved field">
              <%= label_tag :status_corrected, t("overseer.reports.resolved_version") %>
              <%= text_field_tag :corrected_question, report.current_question.id, id: "status_corrected", inputmode: "url" %>
              <p class="field-hint"><%= t("overseer.reports.resolved_version_hint", id: question.id) %></p>
            </div>

            <div class="ticket-if-dismissed field">
              <%= label_tag :status_body, t("overseer.reports.dismiss_reason") %>
              <%= text_area_tag :body, nil, id: "status_body", rows: 3, maxlength: QuestionReport::MESSAGE_LIMIT %>
            </div>

            <% if active_related.any? %>
              <label class="flex items-center gap-2 text-sm">
                <%= check_box_tag :apply_to_related, "1", false, id: "status_apply" %>
                <%= t("overseer.reports.apply_to_related", count: active_related.size) %>
              </label>
            <% end %>
            <div><%= button_tag t("overseer.reports.save_status"), class: "button button-primary" %></div>
          <% end %>
        </section>
      </section>

      <section class="card">
        <header><h2 class="text-lg font-bold"><%= t("overseer.reports.details") %></h2></header>
        <section>
          <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
            <dt class="text-ink-500"><%= t("overseer.reports.columns.reporter") %></dt>
            <dd><%= report.user.name %></dd>
            <dt class="text-ink-500"><%= t("overseer.reports.created") %></dt>
            <dd><%= l report.created_at, format: :short %></dd>
            <dt class="text-ink-500"><%= t("overseer.reports.columns.updated") %></dt>
            <dd><%= l report.updated_at, format: :short %></dd>
            <% if report.resolver %>
              <dt class="text-ink-500"><%= t("overseer.reports.closed_by") %></dt>
              <dd><%= report.resolver.name %></dd>
            <% end %>
            <% if report.replaced? %>
              <dt class="text-ink-500"><%= t("report_thread.corrected_version") %></dt>
              <dd><%= link_to "№#{report.current_question.id}", edit_overseer_question_path(report.current_question), class: "underline" %></dd>
            <% end %>
          </dl>
        </section>
      </section>

      <% if @related.any? %>
        <section class="card">
          <header><h2 class="text-lg font-bold"><%= t("overseer.reports.related", count: @related.size) %></h2></header>
          <section>
            <ul class="flex flex-col gap-2">
              <% @related.each do |other| %>
                <li class="flex flex-wrap items-center gap-2 text-sm">
                  <%= link_to "##{other.id}", overseer_question_report_path(other), class: "font-mono underline" %>
                  <span><%= other.user.name %></span>
                  <%= render "reports/status", report: other %>
                </li>
              <% end %>
            </ul>
          </section>
        </section>
      <% end %>

      <% if question.published? %>
        <section class="card">
          <section>
            <%= button_to t("overseer.reports.withdraw"), withdraw_overseer_question_report_path(report),
                          class: "button button-danger", data: { turbo_confirm: t("overseer.reports.withdraw_confirm") } %>
            <p class="mt-2 text-xs text-ink-500"><%= t("overseer.reports.withdraw_hint") %></p>
          </section>
        </section>
      <% end %>
    </aside>
  </main>
</div>

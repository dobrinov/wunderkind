<%# One box, four ways to send it: a reply that keeps the discussion going,
    closing as fixed (the message optional — they are told it was fixed either
    way), closing as not a problem (the message is the reason, required unless
    the team has already written in the thread), and — for the whole pile only
    — taking the question out of circulation while it is fixed. With `report`
    it speaks to that one student; without, to every active report.
    locals: question, report, label %>
<% id = report ? "body_#{report.id}" : "body_q#{question.id}" %>
<%= form_with url: reply_overseer_question_report_path(question), method: :post, class: "mt-3" do %>
  <% if report %>
    <%= hidden_field_tag :report_id, report.id, id: nil %>
  <% end %>
  <div class="field">
    <%= label_tag id, label %>
    <%= text_area_tag :body, nil, id: id, rows: report ? 2 : 3, maxlength: QuestionReport::MESSAGE_LIMIT,
                      placeholder: t("overseer.reports.response_placeholder") %>
    <% unless report %>
      <p class="field-hint"><%= t("overseer.reports.response_hint") %></p>
    <% end %>
  </div>
  <div class="mt-3 flex flex-wrap gap-2">
    <%= button_tag t("overseer.reports.reply"), class: "button button-primary" %>
    <%= button_tag t("overseer.reports.resolve"), formaction: resolve_overseer_question_report_path(question), class: "button button-secondary" %>
    <%= button_tag t("overseer.reports.dismiss"), formaction: dismiss_overseer_question_report_path(question), class: "button button-secondary" %>
    <% if report.nil? && question.published? %>
      <%= button_tag t("overseer.reports.withdraw"), formaction: withdraw_overseer_question_report_path(question), class: "button button-danger" %>
    <% end %>
  </div>
<% end %>

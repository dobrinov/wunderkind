<%# The settings a parent holds, for themselves and per child. %>
<%= render "fact", label: t("overseer.people.facts.link_code"), value: tag.span(@user.link_code.presence || "—", class: "font-mono") %>
<% @children.each do |child| %>
  <%= render "fact", label: child.name,
             value: [
               t("overseer.people.minutes", count: child.daily_minutes_target || DailyPractice::DEFAULT_MINUTES),
               (t("overseer.people.facts.features_all_short") if child.show_all_features?),
               (child.may_join_leagues? ? t("overseer.people.leagues_allowed") : t("overseer.people.leagues_not_allowed"))
             ].compact.join(" · ") %>
<% end %>

<%# Goals and focuses this parent set, in their own words, with where each
    stands now — and the rewards they still owe, oldest first, with how long. %>
<div class="card">
  <header class="flex flex-wrap items-baseline gap-2.5">
    <span class="text-ui font-black"><%= t("overseer.people.promises") %></span>
    <span class="text-meta font-bold text-muted"><%= t("overseer.people.promises_note") %></span>
  </header>
  <section>
    <% if @standings.any? || @focuses.any? || @owed_awards.any? || @owed_focuses.any? %>
      <ul class="flex flex-col divide-y divide-ink-100">
        <% @standings.each do |standing| %>
          <li class="grid grid-cols-[28px_minmax(0,1fr)_auto] items-center gap-3 py-3 sm:grid-cols-[28px_minmax(0,1fr)_160px_90px]">
            <%= person_avatar(standing.goal.child, size: "size-7 text-caption") %>
            <span class="flex min-w-0 flex-col">
              <span class="text-sm font-extrabold"><%= goal_sentence(standing.goal) %> <span class="font-bold text-muted"><%= goal_period_sentence(standing.goal) %></span></span>
              <span class="text-meta font-bold text-muted">„<%= standing.goal.reward %>“ · <%= standing.goal.child.name %></span>
            </span>
            <span class="goal-bar max-sm:hidden <%= "is-complete" if standing.progress.complete? %>"><span style="width: <%= standing.progress.percent %>%"></span></span>
            <span class="text-right text-meta font-black tabular-nums"><%= standing.progress.done %>/<%= standing.progress.target %></span>
          </li>
        <% end %>
        <% @focuses.each do |focus| %>
          <% progress = PracticeFocuses.progress(focus) %>
          <li class="grid grid-cols-[28px_minmax(0,1fr)_auto] items-center gap-3 py-3 sm:grid-cols-[28px_minmax(0,1fr)_160px_90px]">
            <%= person_avatar(focus.child, size: "size-7 text-caption") %>
            <span class="flex min-w-0 flex-col">
              <span class="text-sm font-extrabold"><%= t("overseer.people.focus_line", topics: focus_topic_names(focus), target: t("overseer.people.focus_targets.#{focus.target}")) %></span>
              <span class="text-meta font-bold text-muted"><% if focus.reward.present? %>„<%= focus.reward %>“ · <% end %><%= focus.child.name %></span>
            </span>
            <span class="goal-bar max-sm:hidden"><span style="width: <%= (progress.fraction * 100).round %>%"></span></span>
            <span class="text-right text-meta font-black tabular-nums"><%= t("overseer.people.topics_done", done: progress.done_count, total: progress.topics.size) %></span>
          </li>
        <% end %>
        <% @owed_awards.each do |award| %>
          <li class="grid grid-cols-[28px_minmax(0,1fr)_auto] items-center gap-3 py-3">
            <%= person_avatar(award.goal.child, size: "size-7 text-caption") %>
            <span class="flex min-w-0 flex-col">
              <span class="text-sm font-extrabold"><%= goal_sentence(award.goal) %></span>
              <span class="text-meta font-bold text-muted">„<%= award.reward %>“ · <%= goal_window([ award.period_start, award.period_end ]) %></span>
            </span>
            <%= person_tag(:parent, t("overseer.people.owed_for", time: distance_of_time_in_words(award.earned_at, Time.current))) %>
          </li>
        <% end %>
        <% @owed_focuses.each do |focus| %>
          <li class="grid grid-cols-[28px_minmax(0,1fr)_auto] items-center gap-3 py-3">
            <%= person_avatar(focus.child, size: "size-7 text-caption") %>
            <span class="flex min-w-0 flex-col">
              <span class="text-sm font-extrabold"><%= t("overseer.people.focus_line", topics: focus_topic_names(focus), target: t("overseer.people.focus_targets.#{focus.target}")) %></span>
              <span class="text-meta font-bold text-muted">„<%= focus.reward %>“ · <%= focus.child.name %></span>
            </span>
            <%= person_tag(:parent, t("overseer.people.owed_for", time: distance_of_time_in_words(focus.completed_at, Time.current))) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm font-bold text-muted"><%= t("overseer.people.no_promises") %></p>
    <% end %>
  </section>
</div>

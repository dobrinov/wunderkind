<%# A student as one row: under a family's parents (nested, its nickname,
    rank and kind of account behind the family's „Подробности") or on the list
    of students nobody is linked to (shown). The name leads to their page,
    where the statistics are. locals: user, tickets, nested %>
<% nested = local_assigns.fetch(:nested, false) %>
<% recent = user.last_active_on && user.last_active_on >= 7.days.ago.to_date %>
<div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-2.5 lg:grid lg:grid-cols-[minmax(0,1.6fr)_repeat(4,minmax(0,110px))_150px]">
  <div class="flex min-w-[240px] flex-1 items-center gap-3 <%= "lg:pl-6" if nested %>">
    <%= person_avatar(user, size: "size-8 text-meta") %>
    <div class="flex min-w-0 flex-col">
      <span class="flex flex-wrap items-center gap-1.5">
        <%= link_to user.name, overseer_user_path(user), class: "text-ui font-black text-ink-900 hover:underline" %>
        <% if tickets[user.id] %>
          <%= link_to t("overseer.people.open_tickets", count: tickets[user.id]), overseer_user_path(user, tab: "tickets"), class: "text-meta font-extrabold text-primary-700" %>
        <% end %>
      </span>
      <span class="flex flex-wrap items-center gap-1.5 text-meta font-bold text-muted" <%= "data-reveal-target=panel hidden" if nested %>>
        <%= user.nickname.present? ? t("overseer.people.nickname", nickname: user.nickname) : t("overseer.people.no_nickname") %>
        · <%= t("profile.level_n", level: user.level) %>
        <%= account_kind_tag(user) %>
      </span>
    </div>
  </div>
  <dl class="order-last flex w-full flex-wrap gap-x-5 gap-y-1 text-sm lg:contents">
    <div class="flex gap-1.5 lg:block"><dt class="text-muted lg:sr-only"><%= t("overseer.users.grade") %></dt><dd class="font-extrabold tabular-nums"><%= SchoolGrade.label(user.estimated_grade) || "—" %></dd></div>
    <div class="flex gap-1.5 lg:block"><dt class="text-muted lg:sr-only"><%= t("overseer.users.rating") %></dt><dd class="font-extrabold tabular-nums"><%= user.elo %></dd></div>
    <div class="flex gap-1.5 lg:block"><dt class="text-muted lg:sr-only"><%= t("overseer.people.streak") %></dt><dd class="font-extrabold tabular-nums"><% if (streak = user.live_streak).positive? %><%= t("overseer.people.days", count: streak) %><% else %><span class="text-muted">—</span><% end %></dd></div>
    <div class="flex gap-1.5 lg:block"><dt class="text-muted lg:sr-only"><%= t("overseer.people.practised") %></dt><dd class="font-bold <%= recent ? "text-ink-900" : "text-muted" %>"><%= day_words(user.last_active_on) %></dd></div>
  </dl>
  <div class="ml-auto flex justify-end">
    <% if impersonable?(user) %>
      <%= button_to impersonate_path(user), class: "button button-quiet gap-1.5" do %>
        <%= render "shared/icon", name: :eye, size: 16 %><%= t("overseer.users.impersonate") %>
      <% end %>
    <% end %>
  </div>
</div>

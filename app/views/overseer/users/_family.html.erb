<%# One household: its grown-ups on one line, its children under them. The
    line carries only what the list is scanned for — who, when last here, and
    anything out of the ordinary (an unconfirmed address, a report switched
    off, an open ticket); the emails, confirmations, nicknames, ranks, kinds of
    account and view-as buttons wait behind „Подробности". A child with two
    parents is here once. locals: family, tickets %>
<% unverified = family.parents.any? { it.email.present? && it.verified_at.nil? } %>
<% report_off = family.children.any? && family.parents.any? { it.email.present? && !it.weekly_report? } %>
<% seen = family.parents.filter_map { last_seen(it) }.max %>
<% joined = family.parents.map(&:created_at).min %>
<article class="card" aria-label="<%= t("overseer.people.family_of", names: family.parents.map(&:name).to_sentence) %>"
         data-controller="reveal"
         data-reveal-open-label-value="<%= t("overseer.people.hide_details") %>"
         data-reveal-closed-label-value="<%= t("overseer.people.details") %>">
  <header class="flex flex-wrap items-center gap-x-3 gap-y-2 bg-ink-25 py-2.5">
    <div class="flex shrink-0 -space-x-2" aria-hidden="true">
      <% family.parents.each do |parent| %>
        <%= person_avatar(parent, size: "size-9 text-base ring-2 ring-white") %>
      <% end %>
    </div>
    <div class="flex min-w-0 flex-[1_1_16rem] flex-wrap items-center gap-x-2 gap-y-1">
      <% family.parents.each_with_index do |parent, index| %>
        <% if index.positive? %><span class="font-bold text-muted">и</span><% end %>
        <%= link_to parent.name, overseer_user_path(parent), class: "text-base font-black text-ink-900 hover:underline" %>
      <% end %>
      <% if family.parents.any? { it.admin? && it == current_user } %>
        <%= person_tag(:admin, t("overseer.people.admin_you")) %>
      <% elsif family.parents.any?(&:admin?) %>
        <%= person_tag(:admin, t("overseer.users.roles.admin")) %>
      <% end %>
      <%= person_tag(:warn, t("overseer.people.email_unverified")) if unverified %>
      <%= person_tag(:quiet, t("overseer.people.weekly_report", state: on_off(false))) if report_off %>
      <% family.parents.each do |parent| %>
        <% if tickets[parent.id] %>
          <%= link_to t("overseer.people.open_tickets", count: tickets[parent.id]), overseer_user_path(parent, tab: "tickets"), class: "text-meta font-extrabold text-primary-700" %>
        <% end %>
      <% end %>
    </div>
    <span class="shrink-0 text-meta font-bold text-muted" title="<%= l(joined, format: :long) %>"><%= t("overseer.people.joined", when: day_words(joined.to_date)) %></span>
    <span class="shrink-0 text-meta font-bold text-muted"><%= t("overseer.people.last_seen", when: when_words(seen)) %></span>
    <button type="button" class="button button-quiet shrink-0 gap-1.5 [&[aria-expanded=true]_svg]:rotate-180"
            aria-expanded="false" data-reveal-target="button" data-action="reveal#toggle">
      <span data-reveal-target="label"><%= t("overseer.people.details") %></span>
      <%= render "shared/icon", name: :chevron_down, size: 16 %>
    </button>
  </header>

  <div class="flex flex-col divide-y divide-ink-100 border-b border-ink-100 bg-primary-25 px-5" data-reveal-target="panel" hidden>
    <% family.parents.each do |parent| %>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 py-2.5 text-meta font-bold text-muted">
        <span class="min-w-40 text-sm font-black text-ink-900"><%= parent.name %></span>
        <% if parent.email.present? %>
          <span class="text-ink-700"><%= parent.email %></span>
          <% if parent.verified_at %>
            <span class="text-green-700"><%= t("overseer.people.verified") %></span>
          <% else %>
            <span class="text-red-700"><%= t("overseer.people.unverified") %></span>
          <% end %>
        <% end %>
        <span><%= t("overseer.people.weekly_report", state: on_off(parent.weekly_report?)) %></span>
        <span><%= t("overseer.people.joined", when: day_words(parent.created_at.to_date)) %></span>
        <span><%= t("overseer.people.last_seen", when: when_words(last_seen(parent))) %></span>
        <% if impersonable?(parent) %>
          <%= button_to t("overseer.people.view_as", name: first_name(parent)), impersonate_path(parent), class: "button button-secondary", form_class: "ml-auto" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if family.solo? %>
    <div class="flex flex-wrap items-center gap-2.5 px-5 py-4 text-sm font-bold text-reward-800">
      <%= person_tag(:parent, t("overseer.people.no_children_tag")) %>
      <%= t("overseer.people.no_children", when: when_words(family.parents.first.created_at)) %>
    </div>
  <% else %>
    <div class="divide-y divide-ink-100">
      <% family.children.each do |child| %>
        <%= render "person_row", user: child, tickets:, nested: true %>
      <% end %>
    </div>
  <% end %>
</article>

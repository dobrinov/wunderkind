<%# Everybody one row each, most recent sign-in first — the list as it was
    before families, kept for finding a person by when they last came. %>
<table>
  <thead>
    <tr>
      <th><%= t("overseer.users.name") %></th>
      <th><%= t("overseer.users.email") %></th>
      <th><%= t("overseer.users.role") %></th>
      <th><%= t("overseer.users.rating") %></th>
      <th><%= t("overseer.users.grade") %></th>
      <th><%= t("overseer.users.level") %></th>
      <th><%= t("overseer.users.last_login") %></th>
      <th><%= t("overseer.users.actions") %></th>
    </tr>
  </thead>
  <tbody>
    <% users.each do |user| %>
      <tr>
        <td><%= link_to user.name, overseer_user_path(user), class: "font-bold text-ink-900 hover:underline" %></td>
        <%# A managed child has no address of their own; name whose account holds them. %>
        <td><%= user.email || (user.managed? ? t("overseer.users.managed_by", name: user.managed_by.name) : "—") %></td>
        <td><%= t("overseer.users.roles.#{user.role}") %></td>
        <td><%= user.elo %></td>
        <td title="<%= user.birth_year %>"><%= SchoolGrade.label(user.estimated_grade) || "—" %></td>
        <td><%= user.level %> (<%= user.total_xp %> XP)</td>
        <td title="<%= user.last_login_at&.iso8601 %>"><%= user.last_login_at ? t("overseer.users.ago", time: time_ago_in_words(user.last_login_at)) : t("overseer.users.never") %></td>
        <%# No button on an admin row, including your own: see ImpersonationsController. %>
        <td class="flex gap-2">
          <%= link_to t("overseer.users.stats"), overseer_stats_path(user_id: user.id), class: "button button-secondary" %>
          <% unless user.admin? %>
            <%= button_to t("overseer.users.impersonate"), impersonate_path(user), class: "button button-secondary" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%# One competition's own fields — what does not change from year to year.
    The year-to-year part (dates, a format that changed) is its editions. %>
<%= form_with model: [ :overseer, competition ], class: "flex flex-col gap-4 rounded-[20px] bg-white p-5 ring-1 ring-ink-150" do |f| %>
  <% if competition.errors.any? %>
    <div class="alert-danger" role="alert"><div><div><p><%= competition.errors.full_messages.join(" ") %></p></div></div></div>
  <% end %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="field"><%= label_tag "competition_name_bg", t("overseer.competitions.fields.name_bg") %><%= text_field_tag "competition[name][bg]", competition.name.to_h["bg"], id: "competition_name_bg", required: true %></div>
    <div class="field"><%= label_tag "competition_name_en", t("overseer.competitions.fields.name_en") %><%= text_field_tag "competition[name][en]", competition.name.to_h["en"], id: "competition_name_en", required: true %></div>
    <div class="field"><%= f.label :short, t("overseer.competitions.fields.short") %><%= f.text_field :short %></div>
    <div class="field"><%= f.label :slug, t("overseer.competitions.fields.slug") %><%= f.text_field :slug, required: true, readonly: competition.persisted? %></div>
    <div class="field"><%= f.label :organizer, t("overseer.competitions.fields.organizer") %><%= f.text_field :organizer, required: true %></div>
    <div class="field"><%= f.label :kind, t("overseer.competitions.fields.kind") %><%= f.select :kind, Competitions::KINDS.map { |k| [ t("overseer.competitions.kinds.#{k}"), k ] } %></div>
    <div class="field"><%= f.label :style, t("overseer.competitions.fields.style") %><%= f.select :style, Competitions::STYLES.map { |k| [ t("overseer.competitions.styles.#{k}"), k ] } %></div>
    <div class="grid grid-cols-2 gap-3">
      <div class="field"><%= f.label :grade_min, t("overseer.competitions.fields.grade_min") %><%= f.number_field :grade_min, in: 1..12 %></div>
      <div class="field"><%= f.label :grade_max, t("overseer.competitions.fields.grade_max") %><%= f.number_field :grade_max, in: 1..12 %></div>
    </div>
    <div class="field"><%= f.label :url, t("overseer.competitions.fields.url") %><%= f.url_field :url %></div>
    <div class="field"><%= f.label :archive_url, t("overseer.competitions.fields.archive_url") %><%= f.url_field :archive_url %></div>
  </div>
  <% %w[description format].each do |field| %>
    <div class="grid gap-4 sm:grid-cols-2">
      <% %w[bg en].each do |locale| %>
        <div class="field">
          <%= label_tag "competition_#{field}_#{locale}", t("overseer.competitions.fields.#{field}_#{locale}") %>
          <%= text_area_tag "competition[#{field}][#{locale}]", competition.public_send(field).to_h[locale], id: "competition_#{field}_#{locale}", rows: 3, required: true %>
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_14rem]">
    <div class="field">
      <%= label_tag "competition_topic_list", t("overseer.competitions.fields.topics") %>
      <%= text_area_tag "competition[topic_list]", competition.topic_names.join("\n"), id: "competition_topic_list", rows: 6 %>
      <p class="field-hint"><%= t("overseer.competitions.fields.topics_hint") %></p>
    </div>
    <div class="flex flex-col gap-3">
      <div class="field"><%= f.label :programme_from, t("overseer.competitions.fields.programme_from") %><%= f.number_field :programme_from, in: 1..12 %></div>
      <div class="field"><%= f.label :programme_to, t("overseer.competitions.fields.programme_to") %><%= f.number_field :programme_to, in: 1..12 %></div>
      <div class="field"><%= f.label :grade_page, t("overseer.competitions.fields.grade_page") %><%= f.number_field :grade_page, in: 1..12 %></div>
    </div>
  </div>
  <div><%= f.submit t("overseer.competitions.save"), class: "button button-primary" %></div>
<% end %>

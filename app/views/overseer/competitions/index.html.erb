<%# The competition calendar for the team — see Overseer::CompetitionsController.
    One row per competition or exam: its next edition and date, how many
    years of papers the bank has, and what needs attention. %>
<div class="page gap-5!">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-page font-black tracking-[-.02em]"><%= t("overseer.competitions.title") %></h1>
      <p class="mt-1 text-ui font-semibold text-muted"><%= t("overseer.competitions.lead") %></p>
    </div>
    <%= link_to t("overseer.competitions.new"), new_overseer_competition_path, class: "button button-secondary" %>
  </div>

  <div class="overflow-hidden rounded-[20px] bg-white ring-1 ring-ink-150">
    <% @events.each do |event| %>
      <% round = event.next_round(@today) %>
      <% flags = @flags[event.slug] %>
      <%= link_to edit_overseer_competition_path(event.slug), class: "flex min-h-14 flex-wrap items-center gap-x-4 gap-y-1 border-t border-ink-100 px-4 py-3 first:border-t-0 hover:bg-ink-25" do %>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-ui font-extrabold text-ink-900"><%= event.name %></span>
          <span class="block text-meta font-semibold text-muted">
            <%= t("overseer.competitions.kinds.#{event.kind}") %> · <%= t("overseer.competitions.grades", from: event.grade_min, to: event.grade_max) %>
            · <%= t("overseer.competitions.editions", count: event.editions.size) %>
            <% if (years = @papers[event.slug].to_i).positive? %> · <%= t("overseer.competitions.papers", count: years) %><% end %>
          </span>
        </span>
        <span class="text-meta font-bold text-ink-700">
          <% if round %>
            <%= l(round.date, format: :long) %><% if round.approximate? %> <span class="text-amber-700">(<%= t("overseer.competitions.approx") %>)</span><% end %>
          <% else %>
            <span class="text-muted"><%= t("overseer.competitions.no_date") %></span>
          <% end %>
        </span>
        <% flags.each do |flag| %>
          <span class="rounded-full bg-amber-50 px-2.5 py-1 text-micro font-extrabold text-amber-800"><%= t("overseer.competitions.flags.#{flag.key}", year: flag.year) %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

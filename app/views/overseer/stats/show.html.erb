<div class="page">
  <header class="flex flex-wrap items-center gap-3">
    <h1><%= @user ? t("overseer.stats.title_for", name: @user.name) : t("overseer.stats.title") %></h1>
    <% if @user %>
      <%= link_to t("overseer.stats.everyone"), overseer_stats_path(days: @stats.days.size),
                  class: "ml-auto rounded-md px-3 py-1 text-sm font-bold text-ink-500 hover:bg-ink-100" %>
    <% end %>
  </header>

  <main>
    <%# A day opens a list only for one user — see Overseer::StatsController#day. %>
    <%= render "shared/answer_stats", stats: @stats, always: true,
               range_path: ->(days) { overseer_stats_path(days: days, user_id: @user&.id) },
               day_path: (@user && ->(date) { overseer_stats_day_path(date: date.iso8601, user_id: @user.id) }) %>
  </main>
</div>

<%# Two charts over the same days, one under the other, so a column in one
    lines up with the same day in the other: the shares on top, the volume
    underneath. Hovering any day, in either chart, shows all three numbers for
    it — a share without the count behind it is how 100% wrong on one answer
    looks like a crisis. %>
<% days = @stats.days %>
<% edge = ->(index) { index < days.size * 0.2 ? "chart-tip-start" : ("chart-tip-end" if index > days.size * 0.8) } %>
<% tip = ->(day) {
     next t("overseer.stats.point_empty", date: l(day.date, format: :short)) unless day.any?

     t("overseer.stats.point",
       date: l(day.date, format: :short),
       solved: day.solved,
       wrong: number_with_precision(day.wrong_rate, precision: 1, strip_insignificant_zeros: true),
       skipped: number_with_precision(day.skipped_rate, precision: 1, strip_insignificant_zeros: true))
   } %>
<%# The rate axis tops out a step above the worst day rather than at 100%:
    the shares mostly live under a third, and on a 0–100 axis they would be
    two lines along the floor. %>
<% peak = days.filter_map(&:wrong_rate).concat(days.filter_map(&:skipped_rate)).max.to_f %>
<% rate_top = [ (peak / 10.0).ceil * 10, 10 ].max.clamp(10, 100) %>
<%# Each day sits in the middle of its hover column. %>
<% x_for = ->(index) { (index + 0.5) * 100.0 / days.size } %>
<%# A day nobody answered on is a gap in the line, not a zero: 0% wrong would
    be a claim about answers that were never given. %>
<% segments = ->(field) {
     days.each_with_index.slice_when { |(a, _), (b, _)| a.public_send(field).nil? != b.public_send(field).nil? }.
       select { |run| run.first.first.public_send(field) }.
       map { |run| run.map { |day, index| "#{x_for.(index).round(2)},#{(100 - day.public_send(field) * 100.0 / rate_top).round(2)}" }.join(" ") }
   } %>
<% solved_top = [ @stats.max_solved * 1.15, 1 ].max %>

<div class="page">
  <header class="flex flex-wrap items-center gap-3">
    <h1><%= @user ? t("overseer.stats.title_for", name: @user.name) : t("overseer.stats.title") %></h1>
    <nav class="ml-auto flex gap-1">
      <% AnswerStats::RANGES.each do |range| %>
        <%= link_to t("overseer.stats.range", count: range),
                    overseer_stats_path(days: range, user_id: @user&.id),
                    class: "rounded-md px-3 py-1 text-sm font-bold #{days.size == range ? 'bg-primary-50 text-primary-700' : 'text-gray-500 hover:bg-gray-100'}" %>
      <% end %>
      <%= link_to t("overseer.stats.everyone"), overseer_stats_path(days: days.size), class: "rounded-md px-3 py-1 text-sm font-bold text-gray-500 hover:bg-gray-100" if @user %>
    </nav>
  </header>

  <main class="space-y-4">
    <% if @stats.enough? %>
      <div class="card">
        <header class="flex flex-wrap items-center gap-2.5">
          <span class="text-[15px] font-black"><%= t("overseer.stats.rates") %></span>
          <span class="text-[13px] font-bold text-muted"><%= t("overseer.stats.rates_sub") %></span>
          <span class="ml-auto flex gap-3 text-[12px] font-black">
            <span class="flex items-center gap-1.5 text-red-600"><span class="size-2.5 rounded-full bg-red-500"></span><%= t("overseer.stats.wrong", rate: number_with_precision(@stats.wrong_rate, precision: 1, strip_insignificant_zeros: true)) %></span>
            <span class="flex items-center gap-1.5 text-amber-600"><span class="size-2.5 rounded-full bg-amber-500"></span><%= t("overseer.stats.skipped", rate: number_with_precision(@stats.skipped_rate, precision: 1, strip_insignificant_zeros: true)) %></span>
          </span>
        </header>

        <section>
          <div class="relative h-48">
            <% [ rate_top, rate_top / 2.0 ].each do |grid| %>
              <div class="pointer-events-none absolute inset-x-0" style="bottom: <%= (grid * 100.0 / rate_top).round(2) %>%">
                <div class="ml-12 border-t border-gray-200"></div>
                <span class="absolute left-0 top-0 -translate-y-1/2 text-[10.5px] font-extrabold text-gray-400">
                  <%= number_with_precision(grid, precision: 1, strip_insignificant_zeros: true) %>%
                </span>
              </div>
            <% end %>

            <div class="absolute inset-y-0 left-12 right-0 border-b border-gray-200">
              <svg class="size-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <% { wrong_rate: "var(--color-red-500)", skipped_rate: "var(--color-amber-500)" }.each do |field, colour| %>
                  <% segments.(field).each do |points| %>
                    <polyline points="<%= points %>" fill="none" stroke="<%= colour %>" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                  <% end %>
                <% end %>
              </svg>

              <%# A dot on every day with answers, so a day standing on its own —
                  one point is not a line — still shows up. %>
              <% days.each_with_index do |day, index| %>
                <% next unless day.any? %>
                <% { wrong_rate: "bg-red-500", skipped_rate: "bg-amber-500" }.each do |field, colour| %>
                  <span class="pointer-events-none absolute size-1.5 -translate-x-1/2 translate-y-1/2 rounded-full <%= colour %>"
                        style="left: <%= x_for.(index).round(2) %>%; bottom: <%= (day.public_send(field) * 100.0 / rate_top).round(2) %>%"></span>
                <% end %>
              <% end %>

              <div class="absolute inset-0 flex">
                <% days.each_with_index do |day, index| %>
                  <span class="chart-col group <%= edge.(index) %>" tabindex="0" aria-label="<%= tip.(day) %>">
                    <span class="absolute inset-y-0 left-1/2 hidden w-px bg-gray-300 group-hover:block"></span>
                    <span class="chart-tip"><%= tip.(day) %></span>
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div class="card">
        <header class="flex flex-wrap items-center gap-2.5">
          <span class="text-[15px] font-black"><%= t("overseer.stats.solved") %></span>
          <span class="text-[13px] font-bold text-muted"><%= t("overseer.stats.solved_sub") %></span>
          <span class="ml-auto whitespace-nowrap rounded-full bg-primary-50 px-2.5 py-1 text-[12px] font-black text-primary-700">
            <%= t("overseer.stats.solved_total", count: @stats.total_solved) %>
          </span>
        </header>

        <section>
          <div class="relative h-36 border-b border-gray-200 pl-12">
            <span class="absolute left-0 top-0 text-[10.5px] font-extrabold text-gray-400"><%= @stats.max_solved %></span>
            <div class="flex h-full items-end gap-px">
              <% days.each_with_index do |day, index| %>
                <span class="chart-col group flex items-end <%= edge.(index) %>" tabindex="0" aria-label="<%= tip.(day) %>">
                  <span class="w-full rounded-t-[2px] bg-primary-500 group-hover:bg-primary-700"
                        style="height: <%= day.solved.zero? ? 0 : (day.solved / solved_top * 100).clamp(1, 100).round(2) %>%"></span>
                  <span class="chart-tip"><%= tip.(day) %></span>
                </span>
              <% end %>
            </div>
          </div>

          <div class="mt-3 flex items-baseline justify-between pl-12 text-[11.5px] font-extrabold text-gray-400">
            <span><%= l days.first.date, format: :short %></span>
            <span><%= l days.last.date, format: :short %></span>
          </div>
        </section>
      </div>
    <% else %>
      <div class="card-quiet text-sm font-bold text-gray-500"><%= t("overseer.stats.empty") %></div>
    <% end %>
  </main>
</div>

<div class="page">
  <header>
    <%= link_to overseer_stats_path(user_id: @user.id), class: "text-[13px] font-extrabold text-primary-700 hover:underline" do %>
      ← <%= t("overseer.stats.title_for", name: @user.name) %>
    <% end %>
    <h1><%= l @date, format: :long %></h1>
  </header>

  <main>
    <%= render "shared/answer_day", answers: @answers, own: false %>
  </main>
</div>

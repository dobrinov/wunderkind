<% content_for :heading, t("mailers.email_verification.heading") %>
<p><%= t("mailers.greeting", name: @user.name) %></p>
<p><%= t("mailers.email_verification.body") %></p>
<%= email_button t("mailers.email_verification.button"), verify_email_url(token: @token) %>
<p><%= t("mailers.email_verification.expiry") %></p>
<%= email_fallback verify_email_url(token: @token) %>
<% content_for :footer, t("mailers.email_verification.why") %>

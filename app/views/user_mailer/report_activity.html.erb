<% grey = "color:#5d5f78;" %>
<p style="margin:0 0 6px;"><%= t("mailers.greeting", name: @user.name) %></p>
<p style="margin:0 0 16px;<%= grey %>"><%= @child ? t("mailers.#{@words}.family_intro", name: @child.name) : t("mailers.#{@words}.intro") %></p>

<p style="margin:0 0 16px;padding:12px 14px;background:#f5f5f9;border-radius:10px;">
  „<%= @report.question.body_text.truncate(160) %>“
</p>

<% unless @message.kind_comment? %>
  <p style="margin:0 0 6px;font-weight:800;"><%= report_event_label(@message) %></p>
<% end %>
<% if @message.body.present? %>
  <p style="margin:0 0 16px;white-space:pre-line;"><%= @message.body %></p>
<% end %>

<%= email_button t("mailers.report_activity.button"), @thread_url %>

<% content_for :footer do %>
  <%= @child ? t("mailers.#{@words}.family_why", name: @child.name) : t("mailers.#{@words}.why") %>
  <a href="<%= @unsubscribe_url %>" style="color:#6b6d85;"><%= t("mailers.report_activity.unsubscribe") %></a> ·
  <a href="<%= @preferences_url %>" style="color:#6b6d85;"><%= t("mailers.preferences") %></a>
<% end %>

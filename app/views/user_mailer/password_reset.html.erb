<% content_for :heading, t("mailers.password_reset.heading") %>
<p><%= t("mailers.greeting", name: @user.name) %></p>
<p><%= t("mailers.password_reset.body") %></p>
<%= email_button t("mailers.password_reset.button"), edit_password_reset_url(token: @token) %>
<p><%= t("mailers.password_reset.expiry") %></p>
<%= email_fallback edit_password_reset_url(token: @token) %>
<% content_for :footer, t("mailers.password_reset.why") %>

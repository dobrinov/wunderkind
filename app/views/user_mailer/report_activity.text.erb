<%= t("mailers.greeting", name: @user.name) %>

<%= @child ? t("mailers.#{@words}.family_intro", name: @child.name) : t("mailers.#{@words}.intro") %>

„<%= @report.question.body_text.truncate(160) %>“

<% unless @message.kind_comment? %>
<%= report_event_label(@message) %>
<% end %>
<% if @message.body.present? %>
<%= @message.body %>

<% end %>
<%= t("mailers.report_activity.button") %>: <%= @thread_url %>
<% content_for :footer do %>
<%= @child ? t("mailers.#{@words}.family_why", name: @child.name) : t("mailers.#{@words}.why") %> <%= t("mailers.report_activity.unsubscribe") %>: <%= @unsubscribe_url %>
<%= t("mailers.preferences") %>: <%= @preferences_url %>
<% end %>

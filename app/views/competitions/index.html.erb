<%# The student's competitions: the ones they said they will enter, counting
    down, each with its practice button — then everything else still to come
    this season, to say „ще участвам" to. A child does not know which ones
    exist; this list is how they find out. %>
<div class="mx-auto flex max-w-3xl flex-col gap-6">
  <div>
    <h1 class="text-page font-black tracking-[-.02em]"><%= t("competitions.mine.title") %></h1>
    <p class="mt-1 text-sm font-semibold text-muted"><%= t("competitions.mine.subtitle") %></p>
  </div>

  <% if @joined.any? %>
    <section class="flex flex-col gap-3">
      <h2 class="text-xs font-extrabold uppercase tracking-[.1em] text-muted"><%= t("competitions.mine.joined") %></h2>
      <% @joined.each do |event| %>
        <% round = event.next_round(@today) %>
        <div class="flex flex-col gap-3.5 rounded-[14px] bg-primary-50 p-4 ring-1 ring-primary-100">
          <div class="flex items-center gap-3.5">
            <%= render "competitions/date", round: round %>
            <div class="min-w-0 flex-1">
              <div class="text-ui font-black text-primary-900"><%= event.name %></div>
              <div class="text-meta font-bold text-primary-700"><%= round.name %> · <%= days_until(round) %></div>
            </div>
          </div>
          <%= render "competitions/actions", event: event, entry: true %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="flex flex-col gap-3">
    <h2 class="text-xs font-extrabold uppercase tracking-[.1em] text-muted">
      <%= @joined.any? ? t("competitions.mine.more") : t("competitions.mine.upcoming") %>
    </h2>

    <% if @upcoming.empty? %>
      <p class="text-sm font-semibold text-muted"><%= t("competitions.index.season_over") %></p>
    <% end %>

    <% @upcoming.each do |event| %>
      <% round = event.next_round(@today) %>
      <div class="flex flex-col gap-3 rounded-[14px] bg-white p-4 ring-1 ring-ink-200">
        <div class="flex items-center gap-3.5">
          <%= render "competitions/date", round: round %>
          <div class="min-w-0 flex-1">
            <div class="text-ui font-black"><%= event.name %></div>
            <div class="text-meta font-bold text-muted">
              <%= round.name %> · <%= event_grades(event) %> · <%= days_until(round) %>
            </div>
          </div>
          <%= link_to t("competitions.mine.details"), event_page_path(event),
                      class: "shrink-0 link-cta max-sm:hidden" %>
        </div>
        <%= render "competitions/actions", event: event, entry: nil %>
      </div>
    <% end %>
  </section>

  <%= link_to "#{t("competitions.mine.calendar_link")} →", competition_calendar_path,
              class: "self-start px-1 link-cta" %>
</div>

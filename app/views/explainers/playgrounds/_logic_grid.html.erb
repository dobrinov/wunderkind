<%# One three-by-three logic puzzle — three children, three pets, three clues —
    solved the way such puzzles are: a grid whose cells are tapped to ✕ and ✓.
    „Провери" judges the grid against the clues; „Покажи как" fills it one
    clue at a time, saying what each clue rules out and what that forces. %>
<div data-controller="explainer-logic-grid" data-explainer-logic-grid-copy-value="<%= copy.to_json %>" class="flex flex-col gap-4">
  <p class="play-note"><%= copy["intro"] %></p>
  <ol class="flex flex-col gap-1" aria-label="<%= copy["clues_label"] %>">
    <% Array(copy["clues"]).each_with_index do |clue, index| %>
      <li class="flex gap-2 rounded-[10px] px-3 py-1.5 text-ui font-bold text-ink-800 sm:text-base" data-explainer-logic-grid-target="clue">
        <span class="font-black text-primary-700"><%= index + 1 %>.</span><span><%= clue %></span>
      </li>
    <% end %>
  </ol>
  <%# The walkthrough's explanation sits between the clue it reads and the
      grid it marks, so a phone shows all three together. %>
  <p class="play-note rounded-[12px] bg-primary-50 px-4 py-2.5 text-primary-900" aria-live="polite" hidden data-explainer-logic-grid-target="step"></p>
  <div class="play-figure">
    <div class="grid w-full max-w-[400px] grid-cols-[auto_repeat(3,minmax(0,1fr))] items-center gap-2" role="group" aria-label="<%= copy["grid"] %>">
      <span></span>
      <% Array(copy["pets"]).each do |pet| %>
        <span class="text-center text-meta font-black text-ink-700 sm:text-ui" aria-hidden="true"><%= pet %></span>
      <% end %>
      <% Array(copy["children"]).each_with_index do |child, row| %>
        <span class="pr-1 text-meta font-black text-ink-700 sm:text-ui" aria-hidden="true"><%= child %></span>
        <% 3.times do |column| %>
          <button type="button" class="play-key h-14 w-full text-2xl"
                  data-explainer-logic-grid-target="cell" data-action="explainer-logic-grid#mark"
                  data-explainer-logic-grid-row-param="<%= row %>" data-explainer-logic-grid-column-param="<%= column %>"></button>
        <% end %>
      <% end %>
    </div>
  </div>
  <p class="text-meta font-semibold text-ink-600"><%= copy["hint"] %></p>
  <div class="play-row">
    <button type="button" class="play-key is-primary" data-action="explainer-logic-grid#check"><%= copy["check"] %></button>
    <button type="button" class="play-key" data-explainer-logic-grid-target="show" data-action="explainer-logic-grid#show"><%= copy["show"] %></button>
    <button type="button" class="play-key" data-action="explainer-logic-grid#clear"><%= copy["clear"] %></button>
  </div>
  <p class="play-note rounded-[12px] px-4 py-2.5" aria-live="polite" hidden data-explainer-logic-grid-target="result"></p>
</div>

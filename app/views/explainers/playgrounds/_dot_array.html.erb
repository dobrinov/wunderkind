<%# Dots in rows: so many rows with so many in each. The array is read four
    ways underneath — rows of, the two multiplications and the two divisions
    that come from it — and „Завърти" swaps rows and columns to show the
    count does not change. %>
<div data-controller="explainer-dot-array" data-explainer-dot-array-copy-value="<%= copy.to_json %>" class="flex flex-col gap-4">
  <label class="play-slider"><%= copy["rows_label"] %>
    <input type="range" min="1" max="10" step="1" value="4" data-explainer-dot-array-target="rows" data-action="input->explainer-dot-array#render">
    <output data-explainer-dot-array-target="rowsOut"></output>
  </label>
  <label class="play-slider"><%= copy["cols_label"] %>
    <input type="range" min="1" max="10" step="1" value="6" data-explainer-dot-array-target="cols" data-action="input->explainer-dot-array#render">
    <output data-explainer-dot-array-target="colsOut"></output>
  </label>
  <div class="play-row">
    <button type="button" class="play-key" data-action="explainer-dot-array#turn"><%= copy["turn"] %></button>
  </div>
  <div class="play-figure" data-explainer-dot-array-target="figure"></div>
  <div class="flex flex-col gap-2" aria-live="polite">
    <p class="rounded-[12px] bg-primary-50 px-4 py-2.5 text-base font-extrabold tabular-nums text-primary-900 sm:text-lg" data-explainer-dot-array-target="groups"></p>
    <p class="rounded-[12px] bg-ink-50 px-4 py-2.5 text-base font-extrabold tabular-nums text-ink-800" data-explainer-dot-array-target="sum"></p>
    <div class="grid grid-cols-2 gap-2 text-center text-base font-extrabold tabular-nums text-ink-800 sm:text-lg">
      <p class="rounded-[12px] bg-ink-50 px-2 py-2.5" data-explainer-dot-array-target="times"></p>
      <p class="rounded-[12px] bg-ink-50 px-2 py-2.5" data-explainer-dot-array-target="turned"></p>
      <p class="rounded-[12px] bg-ink-50 px-2 py-2.5" data-explainer-dot-array-target="divideByCols"></p>
      <p class="rounded-[12px] bg-ink-50 px-2 py-2.5" data-explainer-dot-array-target="divideByRows"></p>
    </div>
  </div>
  <p class="play-note" data-explainer-dot-array-target="note"></p>
</div>

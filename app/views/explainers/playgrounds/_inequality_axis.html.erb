<%# a·x + b against c with one of the four signs: the inequality is solved in
    two lines — take b away, divide by a, turning the sign when a is negative
    — and the answer is drawn on a number line as a dot (hollow or solid) and
    a ray. The a slider runs over positions, not values, so it steps over 0. %>
<div data-controller="explainer-inequality-axis" data-explainer-inequality-axis-copy-value="<%= copy.to_json %>" class="flex flex-col gap-4">
  <div class="play-row" role="group" aria-label="<%= copy["sign_label"] %>">
    <% %w[< ≤ > ≥].each do |sign| %>
      <button type="button" class="play-key text-lg" aria-pressed="<%= sign == "<" %>"
              data-action="explainer-inequality-axis#choose" data-explainer-inequality-axis-sign-param="<%= sign %>"
              data-explainer-inequality-axis-target="sign"><%= sign %></button>
    <% end %>
  </div>
  <label class="play-slider"><%= copy["a_label"] %>
    <input type="range" min="0" max="9" step="1" value="3" data-explainer-inequality-axis-target="a" data-action="input->explainer-inequality-axis#render">
    <output data-explainer-inequality-axis-target="aOut"></output>
  </label>
  <p class="-mt-3 text-[13px] font-bold text-ink-500"><%= copy["a_note"] %></p>
  <label class="play-slider"><%= copy["b_label"] %>
    <input type="range" min="-5" max="5" step="1" value="3" data-explainer-inequality-axis-target="b" data-action="input->explainer-inequality-axis#render">
    <output data-explainer-inequality-axis-target="bOut"></output>
  </label>
  <label class="play-slider"><%= copy["c_label"] %>
    <input type="range" min="-5" max="5" step="1" value="5" data-explainer-inequality-axis-target="c" data-action="input->explainer-inequality-axis#render">
    <output data-explainer-inequality-axis-target="cOut"></output>
  </label>
  <p class="text-center text-2xl font-black tabular-nums text-ink-900" aria-live="polite" data-explainer-inequality-axis-target="inequality"></p>
  <div class="flex flex-col gap-2">
    <p class="rounded-[12px] bg-ink-50 px-4 py-2.5 text-base font-extrabold tabular-nums text-ink-800" data-explainer-inequality-axis-target="first"></p>
    <p class="rounded-[12px] px-4 py-2.5 text-base font-extrabold tabular-nums" data-explainer-inequality-axis-target="second"></p>
  </div>
  <div class="play-figure" data-explainer-inequality-axis-target="figure"></div>
  <p class="rounded-[12px] bg-primary-50 px-4 py-2.5 text-base font-extrabold tabular-nums text-primary-900 sm:text-lg" aria-live="polite" data-explainer-inequality-axis-target="answer"></p>
</div>

<%# The sieve of Eratosthenes up to 100: cross out the multiples of 2, 3, 5 and 7
    and what is left is every prime. The grid is in the page, so it reads as a
    table of numbers without the script too. %>
<div data-controller="explainer-sieve"
     data-explainer-sieve-copy-value="<%= copy.to_json %>"
     class="flex flex-col gap-4">
  <div class="play-row" role="group">
    <% [ 2, 3, 5, 7 ].each do |prime| %>
      <button type="button" class="play-key" aria-pressed="false"
              data-action="explainer-sieve#strike" data-explainer-sieve-prime-param="<%= prime %>"
              data-explainer-sieve-target="key"><%= copy["strike"].to_s.sub("%{n}", prime.to_s) %></button>
    <% end %>
    <button type="button" class="play-key bg-ink-100" data-action="explainer-sieve#reset"><%= copy["reset"] %></button>
  </div>
  <ol class="grid grid-cols-10 gap-1" aria-label="<%= copy["grid"] %>">
    <% (1..100).each do |number| %>
      <li class="grid aspect-square place-items-center rounded-[8px] bg-white text-[13px] font-black text-ink-900 ring-1 ring-ink-200 sm:text-[15px]"
          data-explainer-sieve-target="cell" data-number="<%= number %>"><%= number %></li>
    <% end %>
  </ol>
  <p class="play-note" aria-live="polite" data-explainer-sieve-target="note"><%= copy["note_start"] %></p>
</div>

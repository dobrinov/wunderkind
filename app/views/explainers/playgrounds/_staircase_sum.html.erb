<%# An arithmetic progression as a staircase of bars. „Гаус" lays a second,
    upside-down copy on top, so every column is a₁ + aₙ high and the sum is
    half of n such columns — the formula as a picture. %>
<div data-controller="explainer-staircase-sum" data-explainer-staircase-sum-copy-value="<%= copy.to_json %>" class="flex flex-col gap-4">
  <label class="play-slider"><%= copy["a_label"] %>
    <input type="range" min="1" max="10" step="1" value="2" data-explainer-staircase-sum-target="a" data-action="input->explainer-staircase-sum#render">
    <output data-explainer-staircase-sum-target="aOut"></output>
  </label>
  <label class="play-slider"><%= copy["d_label"] %>
    <input type="range" min="-3" max="3" step="1" value="3" data-explainer-staircase-sum-target="d" data-action="input->explainer-staircase-sum#render">
    <output data-explainer-staircase-sum-target="dOut"></output>
  </label>
  <label class="play-slider"><%= copy["n_label"] %>
    <input type="range" min="2" max="8" step="1" value="5" data-explainer-staircase-sum-target="n" data-action="input->explainer-staircase-sum#render">
    <output data-explainer-staircase-sum-target="nOut"></output>
  </label>
  <div class="play-row">
    <button type="button" class="play-key" aria-pressed="false" data-explainer-staircase-sum-target="gauss" data-action="explainer-staircase-sum#toggle"><%= copy["gauss"] %></button>
  </div>
  <div class="play-figure" data-explainer-staircase-sum-target="figure"></div>
  <div class="flex flex-col gap-2" aria-live="polite">
    <p class="rounded-[12px] bg-ink-50 px-4 py-2.5 text-base font-extrabold tabular-nums text-ink-800" data-explainer-staircase-sum-target="term"></p>
    <p class="rounded-[12px] bg-primary-50 px-4 py-2.5 text-base font-extrabold tabular-nums text-primary-900 sm:text-lg" data-explainer-staircase-sum-target="sum"></p>
    <p class="play-note" data-explainer-staircase-sum-target="note"></p>
    <p class="play-note" hidden data-explainer-staircase-sum-target="clamped"><%= copy["clamped"] %></p>
  </div>
</div>

<%# The digits 3, 4, 7 in a row of places with the decimal point fixed between
    the ones and the tenths. „по 10" and „делено на 10" move the digits, not
    the point — which is what the rule „the point moves" is hiding. %>
<div data-controller="explainer-place-shift" data-explainer-place-shift-copy-value="<%= copy.to_json %>" class="flex flex-col gap-4">
  <div class="play-figure overflow-x-auto">
    <div class="grid w-full max-w-[560px] grid-cols-[repeat(4,minmax(0,1fr))_auto_repeat(3,minmax(0,1fr))] items-end gap-x-1.5 gap-y-2 text-center">
      <% %w[thousands hundreds tens ones].each do |place| %>
        <span class="text-[11px] font-extrabold leading-tight text-ink-600 sm:text-[13px]"><%= copy[place] %></span>
      <% end %>
      <span></span>
      <% %w[tenths hundredths thousandths].each do |place| %>
        <span class="text-[11px] font-extrabold leading-tight text-ink-600 sm:text-[13px]"><%= copy[place] %></span>
      <% end %>
      <% 4.times do %>
        <span class="grid h-14 place-items-center rounded-[12px] bg-white text-3xl font-black tabular-nums text-ink-900 ring-1 ring-ink-200" data-explainer-place-shift-target="cell"></span>
      <% end %>
      <span class="self-end pb-1 text-4xl font-black leading-none text-primary-700" aria-hidden="true"><%= copy["point"] %></span>
      <% 3.times do %>
        <span class="grid h-14 place-items-center rounded-[12px] bg-primary-50 text-3xl font-black tabular-nums text-ink-900 ring-1 ring-primary-100" data-explainer-place-shift-target="cell"></span>
      <% end %>
    </div>
  </div>
  <p class="text-center text-2xl font-black tabular-nums text-ink-900" aria-live="polite" data-explainer-place-shift-target="value"></p>
  <div class="play-row justify-center">
    <button type="button" class="play-key" data-explainer-place-shift-target="times" data-action="explainer-place-shift#times"><%= copy["times"] %></button>
    <button type="button" class="play-key" data-explainer-place-shift-target="divide" data-action="explainer-place-shift#divide"><%= copy["divide"] %></button>
    <button type="button" class="play-key" data-action="explainer-place-shift#reset"><%= copy["reset"] %></button>
  </div>
  <p class="play-note" aria-live="polite" data-explainer-place-shift-target="note"></p>
</div>

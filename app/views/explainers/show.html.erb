<%# One article. The order is the reading order of the idea: what it is in a
    sentence, the three things to remember, the sections — some of them a
    playground to try it in — the traps, a self-check, and then the bank's own
    worked problems, which is where a reader who understood goes next. %>
<%= render "explainers/article", article: @article %>

<% if @topic %>
  <%= render "curriculum/samples", samples: @samples, heading: t("explainers.samples_heading"), blurb: t("explainers.samples_blurb") %>
  <section class="landing-section">
    <%= link_to t("explainers.topic_link", topic: @topic.name), curriculum_topic_path(@topic.slug), class: "font-extrabold text-primary-700 hover:underline" %>
  </section>
<% end %>

<% if @related.any? %>
  <section class="landing-section">
    <h2 class="landing-h2 mb-4"><%= t("explainers.related") %></h2>
    <ul class="flex flex-wrap gap-2.5">
      <% @related.each do |article| %>
        <li><%= link_to article.title, explainer_path(article.slug), class: "landing-tag hover:border-primary-300" %></li>
      <% end %>
      <li><%= link_to t("explainers.hub_link"), explainers_path, class: "landing-tag hover:border-primary-300" %></li>
    </ul>
  </section>
<% end %>

<%= render "curriculum/cta", deck: (Trial::Deck.for_topic(@topic).key if @topic) %>

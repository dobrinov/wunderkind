<%# The live scoreboard: my points, the shared clock, the opponent's points.
    The opponent's numbers are refreshed by the challenge controller's poll. %>
<div class="w-full max-w-xl shrink-0 flex items-stretch gap-2">
  <div class="flex-1 rounded-xl bg-primary-50 px-3 py-2">
    <div class="text-xs font-medium uppercase tracking-wide text-gray-500 truncate"><%= t("challenges.you") %></div>
    <div class="text-xl font-extrabold leading-tight text-primary-700">
      <span data-challenge-target="yourScore"><%= @participant.score %></span>
      <span class="text-xs font-semibold"><%= t("challenges.points_short") %></span>
    </div>
    <div class="text-xs text-gray-500 tabular-nums">
      <span data-challenge-target="yourAnswered"><%= @participant.answered_count %></span>/<%= @challenge.question_count %>
    </div>
  </div>

  <div class="shrink-0 flex flex-col items-center justify-center px-2">
    <div class="text-2xl font-extrabold tabular-nums" data-challenge-target="clock"><%= duel_clock(@challenge.seconds_left) %></div>
    <div class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t("challenges.time_left") %></div>
  </div>

  <div class="flex-1 rounded-xl bg-gray-100 px-3 py-2 text-right">
    <div class="text-xs font-medium uppercase tracking-wide text-gray-500 truncate">
      <%= @opponent ? opponent_name(@opponent.user) : t("challenges.anonymous_opponent") %>
    </div>
    <div class="text-xl font-extrabold leading-tight text-gray-700">
      <span data-challenge-target="opponentScore"><%= @opponent&.score || 0 %></span>
      <span class="text-xs font-semibold"><%= t("challenges.points_short") %></span>
    </div>
    <div class="text-xs text-gray-500 tabular-nums">
      <span data-challenge-target="opponentAnswered"><%= @opponent&.answered_count || 0 %></span>/<%= @challenge.question_count %>
    </div>
  </div>
</div>

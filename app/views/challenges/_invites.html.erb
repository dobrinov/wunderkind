<%# Somebody asked you to play.

    Above everything else on the page, because a named friend waiting on you
    is a more pressing thing than a list of strangers, and because an invited
    room holds for fifteen minutes rather than three — long enough to be worth
    answering and short enough to still mean somebody is there.

    Ringed in the brand colour so it reads as addressed to you, but the accept
    is a secondary key: the page's one primary stays „Намери противник", and
    an invitation is the alternative to it. „Не сега" is an icon, not a word
    the same weight as „Приемам", so the two are not mistaken for each other
    by a hurried thumb. On a phone the buttons drop under the name rather
    than squeezing it to three letters. %>
<section aria-label="<%= t("duel.invites") %>" data-trace-mask>
  <ul class="duel-list ring-2 ring-primary-300">
    <% invites.each do |invite| %>
      <% host = invite.participants.first&.user %>
      <% next if host.nil? %>
      <li class="duel-row flex-wrap">
        <span class="avatar relative size-11 shrink-0 text-[16px]" aria-hidden="true">
          <%= opponent_name(host).first %>
          <span class="presence-dot <%= "is-online" if host.online? %>"></span>
        </span>

        <div class="duel-row-main min-w-[10rem]">
          <span class="duel-row-title"><%= t("duel.invited_you", name: opponent_name(host)) %></span>
          <span class="duel-row-sub">
            <% if near_level?(host) %>
              <span class="text-primary-700"><%= t("duel.near_level") %></span>
              <span aria-hidden="true">·</span>
            <% end %>
            <span class="<%= "font-black text-primary-700" if invite.custom_format? %>">
              <%= t("duel.lobby_config", count: invite.question_count, seconds: invite.seconds_per_question) %>
            </span>
            <% if invite.topics.any? %>
              <span aria-hidden="true">·</span>
              <span><%= invite.topics.map(&:name).to_sentence %></span>
            <% end %>
          </span>
        </div>

        <div class="ml-auto flex shrink-0 items-center gap-1">
          <%= button_to t("duel.accept_invite"), accept_invite_challenge_path(invite), class: "button button-secondary" %>
          <%= button_to challenge_path(invite), method: :delete, class: "button button-quiet button-icon",
                        title: t("duel.decline_invite") do %>
            <%= render "shared/icon", name: :close, size: 20, label: t("duel.decline_invite") %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
</section>

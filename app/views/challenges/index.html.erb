<%# The duel lobby. Same shape as the student home: one hero that is the only
    thing you have to read, then the record and the history beside it. %>
<div class="flex flex-col gap-5">
  <div class="flex flex-wrap items-baseline gap-2.5">
    <h1 class="text-2xl font-black tracking-[-.02em]">⚔️ <%= t("challenges.title") %></h1>
    <span class="text-sm font-semibold text-muted">
      <%= t("home.duel_sub", count: Challenge::QUESTION_COUNT) %>
    </span>
  </div>

  <div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-[minmax(0,1fr)_336px]">
    <div class="flex min-w-0 flex-col gap-5">
      <%# Deeper than the practice hero and rounder, because this is the one
          band on the page that is an invitation rather than a status. %>
      <div class="duel-hero">
        <% if @current %>
          <div class="duel-hero-row">
            <%= render "hero_text" %>
            <%= link_to "#{t('challenges.rejoin')} →", challenge_path(@current, close_path: challenges_path),
                        class: "button-edge button-edge-white min-h-[58px] shrink-0 px-7 text-[17px]" %>
          </div>
        <% else %>
          <%= render "opener", categories: @categories %>
        <% end %>
      </div>

      <% if @invites.any? %>
        <%= render "invites", invites: @invites %>
      <% end %>

      <div class="card">
        <header class="flex flex-wrap items-center gap-2.5">
          <span class="text-[15px] font-black"><%= t("duel.open_lobbies") %></span>
          <span class="ml-auto text-[13px] font-bold text-muted"><%= t("duel.open_lobbies_hint") %></span>
        </header>

        <section>
        <%# Loaded with the page and then refreshed by itself every few
            seconds: a room that opened ten seconds ago is the whole point of
            showing a list, and a student is reading it while it changes. %>
        <turbo-frame id="open-lobbies" class="block"
                     src="<%= lobbies_challenges_path %>"
                     data-controller="poll" data-poll-interval-value="5000">
          <%= render "lobbies", lobbies: @lobbies %>
        </turbo-frame>
        </section>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <% [ [ t("challenges.won"), @record.won, "stat-primary" ], [ t("challenges.lost"), @record.lost, "" ],
             [ t("challenges.drawn"), @record.drawn, "" ], [ t("challenges.win_rate"), "#{@record.win_rate}%", "stat-reward" ] ].each do |label, value, tone| %>
          <div class="stat-tile <%= tone %>">
            <div class="stat-value"><%= value %></div>
            <div class="stat-label"><%= label %></div>
          </div>
        <% end %>
      </div>

      <div class="card">
        <header class="flex flex-wrap items-center gap-2.5">
          <span class="text-[15px] font-black"><%= t("duel.recent") %></span>
          <span class="ml-auto text-[13px] font-bold text-muted">
            <%= t("duel.record", won: @record.won, lost: @record.lost) %>
          </span>
        </header>

        <% if @history.empty? %>
          <section><p class="text-sm font-semibold text-muted"><%= t("challenges.no_history") %></p></section>
        <% else %>
          <% @history.each do |challenge| %>
            <% mine = challenge.participant_for(current_user) %>
            <% theirs = challenge.opponent_for(current_user) %>
            <% won = challenge.winner_id == current_user.id %>
            <div class="flex items-center gap-3.5 border-t border-ink-100 px-5 py-3">
              <span class="grid size-[34px] shrink-0 place-items-center rounded-full text-[15px]
                           <%= won ? 'bg-green-100' : (challenge.draw? ? 'bg-gray-100' : 'bg-red-100') %>" aria-hidden="true">
                <%= won ? "🏆" : (challenge.draw? ? "🤝" : "💪") %>
              </span>
              <div class="min-w-0 flex-1">
                <div class="truncate text-sm font-extrabold">
                  <%= theirs ? opponent_name(theirs.user) : t("challenges.anonymous_opponent") %>
                </div>
                <div class="text-xs font-bold text-ink-500"><%= l challenge.finished_at.to_date, format: :short %></div>
              </div>
              <span class="shrink-0 text-[15px] font-black tabular-nums text-ink-800">
                <%= mine.score %> : <%= theirs&.score || 0 %>
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-5">
      <div class="card">
        <header><strong class="text-[15px] font-black"><%= t("challenges.how_it_works") %></strong></header>
        <section class="space-y-2 text-sm font-semibold text-gray-700">
          <p>⚔️ <%= t("challenges.rules.pairing") %></p>
          <p>⏱️ <%= t("challenges.rules.clock", count: Challenge::QUESTION_COUNT, seconds: Challenge::SECONDS_PER_QUESTION) %></p>
          <p>🎯 <%= t("challenges.rules.scoring", correct: ChallengeScoring::CORRECT_POINTS, speed: ChallengeScoring::SPEED_POINTS) %></p>
          <p>🛡️ <%= t("challenges.rules.rating") %></p>
        </section>
      </div>

      <div class="rounded-[14px] border border-reward-400/60 bg-reward-50 px-5 py-4">
        <div class="mb-1.5 text-[13px] font-black text-reward-800"><%= t("duel.reward") %></div>
        <div class="text-[13.5px] font-bold leading-relaxed text-reward-800">
          <%= t("duel.reward_body", win: Xp::CHALLENGE_WIN_BONUS, draw: Xp::CHALLENGE_DRAW_BONUS, play: Xp::CHALLENGE_PLAY_BONUS) %>
        </div>
      </div>
    </div>
  </div>
</div>

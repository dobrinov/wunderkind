<% won = @challenge.winner_id == current_user.id %>
<% drawn = @challenge.draw? %>

<div class="h-full flex flex-col gap-5 items-center overflow-y-auto">
  <div class="w-full max-w-xl shrink-0 text-center">
    <div class="text-6xl"><%= won ? "🏆" : (drawn ? "🤝" : "💪") %></div>
    <h1 class="mt-2 text-2xl font-bold">
      <%= won ? t("challenges.you_won") : (drawn ? t("challenges.draw") : t("challenges.you_lost")) %>
    </h1>

    <div class="mt-4 flex items-center justify-center gap-4">
      <div class="stat-tile stat-primary min-w-28">
        <div class="stat-value"><%= @participant.score %></div>
        <div class="stat-label"><%= t("challenges.you") %></div>
      </div>
      <div class="text-xl font-bold text-gray-300">:</div>
      <div class="stat-tile min-w-28">
        <div class="stat-value"><%= @opponent&.score || 0 %></div>
        <div class="stat-label truncate"><%= @opponent ? opponent_name(@opponent.user) : t("challenges.anonymous_opponent") %></div>
      </div>
    </div>

    <div class="mt-4 flex items-center justify-center gap-3">
      <span class="xp-pill">⭐ +<%= @participant.xp_earned %></span>
      <span class="text-sm text-gray-500">
        <%= t("challenges.correct_of", correct: @participant.correct_count, total: @challenge.question_count) %>
      </span>
    </div>
  </div>

  <div class="w-full max-w-xl card shrink-0">
    <header><strong><%= t("challenges.breakdown") %></strong></header>
    <section class="space-y-2">
      <div class="flex items-center gap-3 text-xs font-medium uppercase tracking-wide text-gray-400">
        <span class="w-5 shrink-0"></span>
        <span class="flex-1"></span>
        <span class="w-20 shrink-0 text-right"><%= t("challenges.you") %></span>
        <span class="w-14 shrink-0 text-right truncate">
          <%= @opponent ? opponent_name(@opponent.user) : "" %>
        </span>
      </div>

      <% @challenge.challenge_questions.each do |challenge_question| %>
        <% mine = @participant.answer_for(challenge_question) %>
        <% theirs = @opponent&.answer_for(challenge_question) %>
        <div class="flex items-start gap-3 text-sm">
          <span class="w-5 shrink-0 text-center font-bold text-gray-400"><%= challenge_question.position %></span>
          <div class="flex-1 min-w-0">
            <div class="truncate"><%= challenge_question.question.body_text %></div>
            <% if mine.nil? %>
              <div class="text-xs text-gray-400"><%= t("challenges.no_answer") %></div>
            <% elsif !mine.correct? %>
              <div class="text-xs text-gray-500">
                <%= t("answers.correct_answer") %>: <%= Grading.correct_answer_display(challenge_question.question) %>
              </div>
            <% end %>
          </div>
          <div class="shrink-0 w-20 text-right tabular-nums">
            <% if mine %>
              <div class="<%= mine.correct? ? 'text-green-600' : 'text-red-500' %> font-semibold">
                <%= mine.correct? ? "✓" : "✗" %> <%= mine.points %>
              </div>
              <div class="text-xs text-gray-400">
                <%= t("challenges.seconds", seconds: (mine.duration_ms / 1000.0).round(1)) %>
              </div>
            <% else %>
              <div class="text-gray-300 font-semibold">—</div>
            <% end %>
          </div>
          <div class="shrink-0 w-14 text-right tabular-nums <%= theirs&.correct? ? 'text-green-600' : 'text-gray-400' %>">
            <%= theirs ? "#{theirs.correct? ? '✓' : '✗'} #{theirs.points}" : "—" %>
          </div>
        </div>
      <% end %>
    </section>
  </div>

  <div class="w-full max-w-xl shrink-0 flex gap-3 pb-2">
    <%= button_to t("challenges.rematch"), challenges_path, class: "button button-primary w-full", form_class: "flex-1" %>
    <%= link_to t("challenges.back"), challenges_path, class: "button button-secondary flex-1" %>
  </div>
</div>

<% content_for :bare, true %>

<div class="practice-shell">
  <div class="practice-column flex flex-1 flex-col items-center justify-center text-center">
    <div class="text-5xl" aria-hidden="true">🕳️</div>
    <h1 class="mt-3 text-2xl font-black tracking-[-.02em]"><%= t("challenges.abandoned") %></h1>
    <p class="mx-auto mt-1.5 max-w-sm text-sm font-semibold text-muted"><%= t("challenges.abandoned_hint") %></p>
    <%= button_to t("challenges.find_opponent"), challenges_path, class: "button button-primary mt-6 px-5 py-3" %>
  </div>
</div>

<%# Waiting for an opponent. Two faces and a VS, because that is what the
    screen is about — the old version said „търсим" over a spinner and gave a
    player nothing to look at while they waited.

    The empty seat is dashed and haloed rather than drawn as a silhouette: it
    reads as a place somebody is about to take rather than as a person who is
    already there. The format pills are read off the match itself, so a lobby
    opened under a different budget still says what it is. %>
<% content_for :bare, true %>
<% band = RatingBand.new(current_user.elo) %>

<div class="practice-shell"
     data-controller="challenge"
     data-challenge-url-value="<%= state_challenge_path(@challenge) %>"
     data-challenge-status-value="<%= @challenge.status %>">

  <div class="practice-column flex flex-1 flex-col items-center justify-center text-center">
    <div class="flex items-start gap-10 max-sm:gap-5">
      <div>
        <div class="duel-seat duel-seat-mine"><%= current_user.name.first %></div>
        <div class="mt-4 text-[18px] font-black"><%= current_user.name %></div>
        <div class="text-[13px] font-extrabold text-primary-700"><%= band.name %></div>
      </div>

      <div class="mt-12 text-[18px] font-black tracking-[.1em] text-ink-400" aria-hidden="true">VS</div>

      <%# A room opened for one friend is not a search, and must not say it is:
          the seat has a name in it and the wait has an end other than „somebody
          turns up". %>
      <div>
        <div class="duel-seat duel-seat-empty"><%= @challenge.invited? ? opponent_name(@challenge.invited_user).first : "?" %></div>
        <div class="mt-4 text-[18px] font-black text-ink-500">
          <%= @challenge.invited? ? opponent_name(@challenge.invited_user) : t("challenges.anonymous_opponent") %>
        </div>
        <div class="text-[13px] font-extrabold text-ink-400">
          <%= @challenge.invited? ? t("challenges.invited_waiting_for") : t("challenges.searching_for") %>
          · <span data-challenge-target="waited">0</span><%= t("challenges.seconds_short") %>
        </div>
      </div>
    </div>

    <div class="mt-11 text-[32px] font-black tracking-[-.03em] max-sm:text-2xl">
      <%= @challenge.invited? ? t("challenges.invited_title", name: opponent_name(@challenge.invited_user)) : t("challenges.searching") %>
    </div>
    <p class="mx-auto mt-2 max-w-[440px] text-[15px] font-bold leading-[1.55] text-ink-500">
      <%= @challenge.invited? ? t("challenges.invited_hint", minutes: Challenge::INVITE_TTL.in_minutes.to_i) : t("challenges.searching_hint") %>
    </p>

    <div class="mt-6 flex flex-wrap justify-center gap-2.5">
      <span class="duel-format-pill"><%= t("challenges.format_questions", count: @challenge.question_count) %></span>
      <span class="duel-format-pill"><%= t("challenges.format_seconds", count: @challenge.seconds_per_question) %></span>
      <span class="duel-format-pill">
        <%= t("challenges.format_points", correct: ChallengeScoring::CORRECT_POINTS, speed: ChallengeScoring::SPEED_POINTS) %>
      </span>
    </div>

    <%= button_to t("challenges.cancel"), challenge_path(@challenge), method: :delete,
                  class: "button-edge button-edge-secondary mt-7", form: { data: { turbo: false } } %>
  </div>
</div>

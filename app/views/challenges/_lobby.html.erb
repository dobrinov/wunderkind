<% content_for :bare, true %>

<div class="practice-shell"
     data-controller="challenge"
     data-challenge-url-value="<%= state_challenge_path(@challenge) %>"
     data-challenge-status-value="<%= @challenge.status %>">

  <div class="practice-column flex flex-1 flex-col items-center justify-center text-center">
    <div class="flex items-center gap-6">
      <div>
        <div class="avatar mx-auto mb-2.5 size-20 text-3xl"><%= current_user.name.first %></div>
        <div class="text-[15px] font-black"><%= current_user.name %></div>
        <div class="text-[12.5px] font-bold text-muted"><%= RatingBand.new(current_user.elo).name %></div>
      </div>

      <div class="text-2xl font-black text-gray-400" aria-hidden="true">⚔</div>

      <%# The opponent is a silhouette until the matchmaker fills the lobby;
          the page reloads itself the moment the status changes. %>
      <div class="opacity-50">
        <div class="mx-auto mb-2.5 grid size-20 place-items-center rounded-full bg-gray-100 text-3xl font-black text-gray-400">?</div>
        <div class="text-[15px] font-black text-gray-500"><%= t("challenges.anonymous_opponent") %></div>
        <div class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-gray-400">
          <span class="size-1.5 animate-ping rounded-full bg-primary-500"></span>
          <span><span data-challenge-target="waited">0</span><%= t("challenges.seconds_short") %></span>
        </div>
      </div>
    </div>

    <div class="mt-7">
      <div class="text-2xl font-black tracking-[-.02em]"><%= t("challenges.searching") %></div>
      <p class="mx-auto mt-1.5 max-w-sm text-sm font-semibold text-muted"><%= t("challenges.searching_hint") %></p>
    </div>

    <%= button_to t("challenges.cancel"), challenge_path(@challenge), method: :delete,
                  class: "button button-secondary mt-7 px-5 py-3", form: { data: { turbo: false } } %>
  </div>
</div>

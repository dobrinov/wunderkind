<div class="h-full flex flex-col items-center justify-center gap-6 text-center"
     data-controller="challenge"
     data-challenge-url-value="<%= state_challenge_path(@challenge) %>"
     data-challenge-status-value="<%= @challenge.status %>">
  <div class="text-6xl">⚔️</div>

  <div>
    <h1 class="text-2xl font-bold"><%= t("challenges.searching") %></h1>
    <p class="mt-2 text-gray-500 max-w-sm"><%= t("challenges.searching_hint") %></p>
  </div>

  <div class="flex items-center gap-2 text-sm text-gray-400">
    <span class="size-2 rounded-full bg-primary-500 animate-ping"></span>
    <span><span data-challenge-target="waited">0</span><%= t("challenges.seconds_short") %></span>
  </div>

  <%= button_to t("challenges.cancel"), challenge_path(@challenge), method: :delete,
                class: "button button-secondary", form: { data: { turbo: false } } %>
</div>

<% content_for :bare, true %>

<div class="practice-shell"
     data-controller="challenge"
     data-challenge-url-value="<%= state_challenge_path(@challenge) %>"
     data-challenge-status-value="<%= @challenge.status %>"
     data-challenge-seconds-left-value="<%= @challenge.seconds_left %>">

  <%= render "scoreboard" %>

  <div class="practice-column">
    <% if @challenge_question %>
      <div class="practice-card">
        <div class="practice-meta">
          <% if (topic = @question.topics.first) %>
            <span class="topic-pill"><%= topic.name %></span>
          <% end %>
          <span class="level-label">
            <%= t("challenges.question_of", position: @challenge_question.position, total: @challenge.question_count) %>
          </span>
        </div>

        <% if @question.image %>
          <div class="mb-6 flex justify-center overflow-hidden rounded-xl">
            <%= image_tag @question.image.file, alt: "" %>
          </div>
        <% end %>

        <%= question_body(@question, large: @question.image.nil? && @question.body_text.size < 60) %>

        <div class="mt-7">
          <%# No hints and no "I haven't been taught this" in a duel: both would
              be worth points to whoever used them fastest rather than to
              whoever needed them. %>
          <%= form_with url: challenge_answers_path(@challenge), method: :post,
                        data: { controller: "answer-form", action: "submit->answer-form#submit", turbo: false } do %>
            <%= hidden_field_tag :challenge_question_id, @challenge_question.id %>

            <%= render "answers/inputs", question: @question, numeric_answer: @numeric_answer %>
          <% end %>
        </div>
      </div>

      <%# Reporting is not in the class of things a duel withholds: it awards
          nothing, skips nothing and stops nothing. What it does cost is the
          reporter's own seconds, which the hint says out loud. %>
      <%= render "shared/report_problem", question: @question,
                                          url: challenge_reports_path(@challenge),
                                          hidden: { challenge_question_id: @challenge_question.id },
                                          hint: t("reports.clock_note") %>
    <% else %>
      <div class="practice-card text-center">
        <div class="text-5xl" aria-hidden="true">⏳</div>
        <h2 class="mt-3 text-xl font-black"><%= t("challenges.done_waiting") %></h2>
        <p class="mx-auto mt-1.5 max-w-sm text-sm font-semibold text-muted"><%= t("challenges.done_waiting_hint") %></p>
      </div>
    <% end %>
  </div>
</div>

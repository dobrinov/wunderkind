<%# The question as the student reported it beside the question as it is now,
    for each part that changed. Without a snapshot (a report filed before they
    were kept) or without a change, the question as it is. locals: report %>
<% question = report.question %>
<% changes = report.changes_since_report %>
<% if changes.present? %>
  <div class="flex flex-col gap-3">
    <div class="text-meta font-black text-ink-700"><%= t("report_thread.what_changed") %></div>
    <% now = QuestionReport.snapshot_of(question) %>
    <% changes.each do |field| %>
      <div class="grid gap-2 sm:grid-cols-2">
        <% [ [ :before, report.snapshot ], [ :after, now ] ].each do |side, version| %>
          <div class="rounded-xl px-3 py-2 <%= side == :before ? "bg-ink-50 text-ink-500" : "bg-green-50 text-ink-800" %>">
            <div class="text-micro font-extrabold uppercase tracking-[.06em]">
              <%= t("report_thread.fields.#{field}") %> · <%= t("report_thread.#{side}") %>
            </div>
            <div class="mt-1 text-meta">
              <% case field %>
              <% when "body" %>
                <%= content_tag :div, RichContent.render(version["body"]), class: "question-body" %>
              <% when "options" %>
                <%= safe_join(Array(version["options"]).map { |option| math_value(option) }, " · ") %>
              <% when "answer" %>
                <%= math_value(version["answer"]) %>
              <% else %>
                <span class="whitespace-pre-line"><%= math_text(version["explanation"].presence || "—") %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div>
    <%= question_body(question) %>
    <% if changes == [] && report.closed? %>
      <p class="mt-2 text-caption font-semibold text-muted"><%= t("report_thread.unchanged") %></p>
    <% end %>
  </div>
<% end %>
<% unless question.published? %>
  <p class="text-caption font-semibold text-muted"><%= t("report_thread.withdrawn_note") %></p>
<% end %>

<%# One entry of a report's thread. The student's own words sit on the right,
    the team's on the left, a change of state (closed, reopened, „оправено е")
    is named above whatever was written with it. The student never sees which
    admin wrote — it is „Екипът“ speaking — while the queue names the author.
    locals: message, viewer (:student or :team) %>
<% mine = message.from_reporter? == (viewer == :student) %>
<% author = if message.from_reporter?
              viewer == :student ? t("report_thread.you") : message.author&.name
            else
              viewer == :student ? t("report_thread.team") : (message.author&.name || t("report_thread.team"))
            end %>
<li class="flex <%= mine ? "justify-end" : "justify-start" %>">
  <div class="max-w-[85%] rounded-[14px] px-4 py-2.5 <%= message.from_reporter? ? "bg-ink-100" : "bg-primary-50" %>">
    <div class="text-caption font-extrabold <%= message.from_reporter? ? "text-ink-600" : "text-primary-700" %>">
      <%= author %> · <%= l message.created_at, format: :short %>
    </div>
    <% unless message.kind_comment? %>
      <div class="mt-0.5 text-meta font-black text-ink-800"><%= t("report_thread.events.#{message.kind}") %></div>
    <% end %>
    <% if message.body.present? %>
      <p class="mt-1 text-ui text-ink-800 whitespace-pre-line"><%= message.body %></p>
    <% end %>
    <% if (corrected = message.corrected_question) %>
      <div class="mt-2 rounded-xl bg-white px-3 py-2 text-meta ring-1 ring-primary-100">
        <span class="font-extrabold text-primary-700"><%= t("report_thread.corrected_version") %>:</span>
        <% if viewer == :team %>
          <%= link_to "№#{corrected.id} — #{corrected.body_text.truncate(80)}", edit_overseer_question_path(corrected), class: "underline" %>
        <% else %>
          <%= corrected.body_text.truncate(80) %>
        <% end %>
      </div>
    <% end %>
  </div>
</li>

<%# One entry of a report's thread. The reader's own words sit on the right,
    everybody else's on the left; a change of state (closed, reopened,
    „оправено е") is named above whatever was written with it. Who wrote it is
    worded for the reader — see ReportsHelper. The team's messages are tinted,
    the student's and a parent's are not.
    locals: message, viewer (:student, :family or :team) %>
<li class="flex <%= report_message_mine?(message, viewer) ? "justify-end" : "justify-start" %>">
  <div class="<%= message.corrected_question_id ? "w-full sm:max-w-[85%]" : "max-w-[85%]" %> rounded-[14px] px-4 py-2.5 <%= message.from_team? ? "bg-primary-50" : (message.from_family? ? "bg-reward-50" : "bg-ink-100") %>">
    <div class="text-caption font-extrabold <%= message.from_team? ? "text-primary-700" : "text-ink-600" %>">
      <%= report_message_author(message, viewer) %> · <%= l message.created_at, format: :short %>
    </div>
    <% unless message.kind_comment? %>
      <div class="mt-0.5 text-meta font-black text-ink-800"><%= t("report_thread.events.#{message.kind}") %></div>
    <% end %>
    <% if message.body.present? %>
      <p class="mt-1 text-ui text-ink-800 whitespace-pre-line"><%= message.body %></p>
    <% end %>
    <%# The corrected version is drawn here, in the message that names it, so
        nobody has to follow a link to see what the team means. %>
    <% if (corrected = message.corrected_question) %>
      <div class="mt-3 flex flex-col gap-2">
        <div class="text-caption font-extrabold text-primary-700">
          <%= t("report_thread.corrected_version") %>
          <% if viewer == :team %>
            · <%= link_to "№#{corrected.id}", edit_overseer_question_path(corrected), class: "underline" %>
          <% end %>
        </div>
        <%= render "reports/question_card", question: corrected, compact: true %>
      </div>
    <% end %>
  </div>
</li>

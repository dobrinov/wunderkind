<% content_for :title, "Wunderkind Design System" %>

<div class="page">
  <header>
    <h1>Дизайн система</h1>
  </header>

  <main>
    <div class="max-w-4xl space-y-10 pb-10">

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Цветове</h2>
        <p class="text-sm text-gray-500">Основен цвят <code class="font-mono">primary</code> — навигация и действия. <code class="font-mono">reward</code> — само за XP, серии и отличия.</p>
        <div class="flex flex-wrap gap-2">
          <% %w[25 50 100 200 300 400 500 600 700 800 900].each do |shade| %>
            <div class="flex flex-col items-center gap-1">
              <div class="size-12 rounded-lg ring-1 ring-black/5" style="background: var(--color-primary-<%= shade %>)"></div>
              <span class="text-xs text-gray-500"><%= shade %></span>
            </div>
          <% end %>
        </div>
        <div class="flex flex-wrap gap-2">
          <% %w[50 100 400 500 600 800].each do |shade| %>
            <div class="flex flex-col items-center gap-1">
              <div class="size-12 rounded-lg ring-1 ring-black/5" style="background: var(--color-reward-<%= shade %>)"></div>
              <span class="text-xs text-gray-500">reward-<%= shade %></span>
            </div>
          <% end %>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Типография</h2>
        <p class="text-sm text-gray-500">Nunito — заглавия и текст. Кирилица + латиница.</p>
        <div class="space-y-1">
          <p class="text-3xl font-extrabold">Заглавие 3xl extrabold</p>
          <p class="text-2xl font-bold">Заглавие 2xl bold</p>
          <p class="text-xl font-bold">Заглавие xl bold</p>
          <p class="text-base">Основен текст — base</p>
          <p class="text-sm text-gray-500">Помощен текст — sm muted</p>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Математическа нотация</h2>
        <p>
          Вградена формула:
          <span data-controller="math" data-math-latex-value="\frac{3}{4} + \frac{1}{4} = 1"></span>
          и още една:
          <span data-controller="math" data-math-latex-value="x^2 + y^2 = z^2"></span>
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Бутони</h2>
        <div class="flex flex-wrap gap-3">
          <button class="button button-primary">Primary</button>
          <button class="button button-secondary">Secondary</button>
          <button class="button button-success">Success</button>
          <button class="button button-danger">Danger</button>
          <button class="button button-primary button-large max-w-56">Large / пълна ширина</button>
          <button class="button button-primary button-hero">Hero</button>
        </div>
        <p class="text-sm text-gray-500">
          <code class="font-mono">.button-hero</code> е една стъпка над <code class="font-mono">.button-large</code>
          и се използва само на публичната страница, където бутонът трябва да надделее над цял герой.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Полета</h2>
        <div class="grid sm:grid-cols-3 gap-4 max-w-2xl">
          <input type="text" placeholder="Текстово поле">
          <input type="number" placeholder="Число">
          <select><option>Избор</option></select>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Съобщения</h2>
        <div class="space-y-2 max-w-2xl">
          <div class="alert-info"><div><div><p>Информация — неутрално съобщение.</p></div></div></div>
          <div class="alert-success"><div><div><p>Успех — операцията мина.</p></div></div></div>
          <div class="alert-warning"><div><div><p>Внимание — нещо изисква преглед.</p></div></div></div>
          <div class="alert-danger"><div><div><p>Грешка — какво се обърка и как се поправя.</p></div></div></div>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Геймификация</h2>
        <div class="flex flex-wrap gap-3 items-center">
          <div class="stat-tile stat-reward">
            <div class="stat-value">🔥 7</div>
            <div class="stat-label">Серия</div>
          </div>
          <div class="stat-tile stat-reward">
            <div class="stat-value">⭐ 480</div>
            <div class="stat-label">Опит</div>
          </div>
          <div class="stat-tile stat-primary">
            <div class="stat-value">4</div>
            <div class="stat-label">Ниво</div>
          </div>
          <span class="xp-pill">⭐ +24 XP</span>
        </div>
        <div class="max-w-md flex items-center gap-3">
          <span class="text-sm font-semibold text-primary-700">Ниво 4</span>
          <div class="level-progress flex-1"><div style="width: 60%"></div></div>
          <span class="text-sm font-semibold text-primary-700">Ниво 5</span>
        </div>
        <%# The medals themselves are a section of their own below; here is just
            the progress bar they sit next to in the home rail. %>
        <div class="flex max-w-md items-center gap-3">
          <%= render "shared/medal", badge: Badges.find("sessions_10"), earned: false, fill: 0.4, size: :s %>
          <span class="badge-bar badge-bar-reward"><span style="width: 40%"></span></span>
          <span class="text-[11px] font-black text-muted">4/10</span>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Отговори</h2>
        <div class="grid grid-cols-2 gap-4 max-w-md">
          <button class="choice-button">12</button>
          <button class="choice-button" aria-pressed="true">14 (избран)</button>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Интерактивни елементи</h2>
        <div class="space-y-8 max-w-xl">
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Числова ос</h3>
            <%= render "widgets/number_line", widget_params: { "min" => 0, "max" => 10, "step" => 1 } %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Подреждане</h3>
            <%= render "widgets/ordering", widget_params: { "items" => [
              { "id" => "i1", "label" => "3/4" }, { "id" => "i2", "label" => "1/4" }, { "id" => "i3", "label" => "1/2" }
            ] } %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Дроби</h3>
            <%= render "widgets/fraction_bars", widget_params: { "segments" => 5 } %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Избор на всички верни</h3>
            <%= render "widgets/multi_select", widget_params: { "options" => [
              { "id" => "a", "label" => "12" }, { "id" => "b", "label" => "17" },
              { "id" => "c", "label" => "24" }, { "id" => "d", "label" => "31" }
            ] } %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Попълване</h3>
            <%= render "widgets/blanks", widget_params: { "prompt" => "x² − 7x + 12 = 0",
              "fields" => [ { "id" => "x1", "label" => "x₁" }, { "id" => "x2", "label" => "x₂" } ] } %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Таблица</h3>
            <%= render "widgets/grid_fill", widget_params: {
              "rows" => [ [ 8, nil, 6 ], [ nil, 5, nil ], [ 4, 9, 2 ] ] } %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Оцветяване на мрежа</h3>
            <%= render "widgets/grid_shade", widget_params: {
              "rows" => 4, "cols" => 8, "given" => [ "0,0", "1,0", "1,1" ] } %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Координатна система</h3>
            <%= render "widgets/coordinate_plot", widget_params: {
              "min_x" => -5, "max_x" => 5, "min_y" => -5, "max_y" => 5, "count" => 2,
              "fixed" => [ [ -3, 2, "A" ] ] } %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Разпределяне</h3>
            <%= render "widgets/categorize", widget_params: {
              "bins" => [ { "id" => "p", "label" => "просто" }, { "id" => "c", "label" => "съставно" } ],
              "items" => [ { "id" => "i1", "label" => "17" }, { "id" => "i2", "label" => "21" }, { "id" => "i3", "label" => "29" } ] } %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Свързване</h3>
            <%= render "widgets/matcher", widget_params: {
              "left" => [ { "id" => "l1", "label" => "1/4" }, { "id" => "l2", "label" => "1/2" } ],
              "right" => [ { "id" => "r1", "label" => "25%" }, { "id" => "r2", "label" => "50%" } ] } %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Ъгломер</h3>
            <%= render "widgets/angle_dial", widget_params: { "step" => 5, "max" => 180 } %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-500 mb-2">Часовник</h3>
            <%= render "widgets/clock_hands", widget_params: { "minute_step" => 5 } %>
          </div>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Дроби</h2>
        <p class="text-sm text-gray-500">
          <code class="font-mono">.frac</code> — една дроб, набрана като в условието. Ползва се и от
          уиджетите, за да не се появява „3/4“ до набрана ¾.
        </p>
        <p class="text-2xl">
          <%= render "shared/frac", numerator: 3, denominator: 4 %>
          <span class="mx-2">+</span>
          <%= render "shared/frac", numerator: 1, denominator: 4 %>
          <span class="mx-2">= 1</span>
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Хоризонт</h2>
        <p class="text-sm text-gray-500">
          <code class="font-mono">.hero-band</code> — единственото действие на страницата, когато трябва
          да надделее над екран, пълен с карти. Индиго, защото е нещо, което можеш да направиш.
        </p>
        <div class="hero-band max-w-2xl">
          <div class="min-w-0 flex-1">
            <div class="hero-kicker">Днес</div>
            <div class="hero-title">Дневна тренировка</div>
            <div class="hero-sub">Задачи, подбрани точно за твоето ниво.</div>
          </div>
          <button class="button">Започни →</button>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Ниво на задачите</h2>
        <p class="text-sm text-gray-500">
          Рейтингът се показва като име на ниво; самото число е второстепенно —
          <code class="font-mono">RatingBand</code>.
        </p>
        <div class="max-w-sm">
          <%= render "shared/rating_band_card", band: RatingBand.new(1356) %>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Обратна връзка</h2>
        <p class="text-sm text-gray-500">
          <code class="font-mono">.fb-card</code> с лента, изскачаща икона и — при грешка — две
          отделни полета („твоят“ / „верният“) и отделен панел „Защо“.
        </p>
        <div class="space-y-4 max-w-xl">
          <div class="fb-card fb-correct">
            <div class="fb-band">
              <span class="fb-icon" aria-hidden="true">✓</span>
              <div class="min-w-0 flex-1">
                <div class="fb-title">Вярно!</div>
                <div class="fb-sub">3 верни отговора подред</div>
              </div>
              <span class="xp-pill px-3.5 py-2 text-[15px] font-black ring-1 ring-reward-400">⭐ +12 XP</span>
            </div>
          </div>

          <div class="fb-card fb-wrong">
            <div class="fb-band">
              <span class="fb-icon" aria-hidden="true">✗</span>
              <div class="min-w-0 flex-1">
                <div class="fb-title">Не е вярно</div>
                <div class="fb-sub">Погледни решението и продължавай.</div>
              </div>
            </div>
            <div class="fb-body">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="fb-chip fb-chip-yours">
                  <div class="fb-chip-label">Твоят отговор</div>
                  <%# No `struck` on a fraction: the line would cross its own bar. %>
                  <div class="fb-chip-value"><%= render "shared/frac", numerator: 7, denominator: 8 %></div>
                </div>
                <div class="fb-chip fb-chip-correct">
                  <div class="fb-chip-label">Верен отговор</div>
                  <div class="fb-chip-value"><%= render "shared/frac", numerator: 3, denominator: 4 %></div>
                </div>
              </div>
              <div class="fb-why mt-3.5">
                <div class="mb-1.5 flex items-center gap-2">
                  <span aria-hidden="true">💡</span>
                  <span class="fb-why-label">Защо</span>
                </div>
                <div class="fb-why-text">Двете дроби се свеждат към общ знаменател.</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Звук при отговор</h2>
        <p class="text-sm text-gray-500">
          Двата тона се синтезират в <code class="font-mono">lib/sounds.js</code> — възходяща чиста
          квинта за вярно, по-тих низходящ триъгълник за грешно. Пропускането и задачата, която чака
          проверка, остават без звук: те не са нито верни, нито грешни. Тонът звучи на страницата,
          на която детето е натиснало бутона — Safari и Firefox не дават на следващата страница да
          пусне звук — затова формата за отговор изпраща отговора с <code class="font-mono">fetch</code>.
        </p>
        <div class="flex flex-wrap items-center gap-3" data-controller="sound-demo">
          <button type="button" class="button button-secondary"
                  data-action="sound-demo#play" data-sound-demo-cue-param="correct">▶ Вярно</button>
          <button type="button" class="button button-secondary"
                  data-action="sound-demo#play" data-sound-demo-cue-param="wrong">▶ Грешно</button>
          <span class="text-sm text-gray-500">
            Копчето вдясно е <code class="font-mono">shared/_sound_toggle</code> — същият превключвател,
            който стои и в „Настройки“:
          </span>
          <%= render "shared/sound_toggle" %>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Сигнал за проблем</h2>
        <p class="text-sm text-gray-500">
          <code class="font-mono">.report-trigger</code> е тих ред под контролите за отговор;
          <code class="font-mono">.report-panel</code> е панелът, който се отваря — сив картон, не
          предупреждение.
        </p>
        <div class="report items-start">
          <span class="report-trigger"><span aria-hidden="true">⚑</span> <span>Има проблем със задачата</span></span>
          <div class="report-panel">
            <p class="report-lede">Какво не е наред?</p>
            <div class="report-reasons">
              <label class="report-reason"><input type="radio" name="ds-report" checked> <span>Верният отговор е грешен</span></label>
              <label class="report-reason"><input type="radio" name="ds-report"> <span>Няма верен отговор сред възможните</span></label>
              <label class="report-reason"><input type="radio" name="ds-report"> <span>Условието е неясно или подвеждащо</span></label>
            </div>
            <textarea rows="2" class="mt-3" placeholder="Разкажи ни повече (по избор)"></textarea>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <button type="button" class="button button-primary">Изпрати</button>
              <span class="text-xs text-muted">Не влияе на рейтинга и опита ти.</span>
            </div>
          </div>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Напредък по дни</h2>
        <p class="text-sm text-gray-500">
          <code class="font-mono">.heat-cell</code> в четири стъпки — заменя месечната решетка от
          квадратни клетки.
        </p>
        <div class="flex items-center gap-1.5 text-[11.5px] font-extrabold text-gray-400">
          <span>по-малко</span>
          <span class="heat-cell"></span>
          <span class="heat-cell heat-1"></span>
          <span class="heat-cell heat-2"></span>
          <span class="heat-cell heat-3"></span>
          <span>повече</span>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Двубой</h2>
        <p class="text-sm text-gray-500">
          Двубоят преизползва картата и <code class="font-mono">.choice-button</code>; ново е само
          таблото. Индиго = ти и всяко действие, gray-700 = противникът, без трети цвят.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <div class="duel-dots">
            <span class="duel-dot-correct"></span><span class="duel-dot-wrong"></span>
            <span class="duel-dot-correct"></span><span></span><span></span>
          </div>
          <div class="duel-clock">1:12</div>
          <div class="duel-clock duel-clock-low">0:04</div>
        </div>
        <p class="text-sm text-muted">
          Горните две са на лендинга. В самия мач таблото е v2: всеки играч е блок,
          часовникът е пръстен, който се изпразва, а лентите заменят точките.
        </p>

        <%# The lobby browser: what a room is about, and how one is chosen. %>
        <p class="pt-2 text-sm text-gray-500">
          Чакалнята: <code class="font-mono">.duel-chip</code> е тема при отварянето на двубой
          (чекбоксът е скрит, целият чип е мишената — палец, не кутийка от 13px),
          <code class="font-mono">.duel-tag</code> е темата на вече отворена стая в списъка.
          Без избрана тема стаята е „всякакви задачи“, което е и най-бързият път.
        </p>
        <div class="flex flex-wrap items-center gap-2 rounded-[18px] bg-primary-900 p-4">
          <% [ [ "Дроби и проценти", true ], [ "Геометрия", false ], [ "Логика", false ] ].each_with_index do |(name, on), index| %>
            <label class="duel-chip">
              <input type="checkbox" class="sr-only" <%= "checked" if on %> disabled
                     id="ds-chip-<%= index %>">
              <span><%= name %></span>
            </label>
          <% end %>
        </div>
        <p class="pt-1 text-sm text-gray-500">
          <code class="font-mono">.format-chip</code> е същото, но на светъл фон — изборът на
          формат при покана към приятел. Контролата е скрито radio/checkbox, целият чип е мишената.
        </p>
        <div class="flex flex-wrap items-center gap-1.5">
          <% [ [ "3 задачи", false ], [ "5 задачи", true ], [ "10 задачи", false ] ].each_with_index do |(name, on), index| %>
            <label class="format-chip">
              <input type="radio" name="ds-format" class="sr-only" <%= "checked" if on %> disabled
                     id="ds-format-<%= index %>">
              <span><%= name %></span>
            </label>
          <% end %>
        </div>

        <div class="flex flex-wrap items-center gap-1.5">
          <span class="duel-tag">Всякакви задачи</span>
          <span class="duel-tag duel-tag-set">Геометрия</span>
          <span class="duel-tag duel-tag-set">Дроби и проценти</span>
        </div>

        <%# The v2 scoreboard, in one row, with both ring states and the meter. %>
        <div class="duel-board max-w-3xl rounded-[18px] border border-ink-150">
          <div class="duel-board-row">
            <div class="duel-side duel-side-mine">
              <div class="min-w-0 flex-1 text-right">
                <div class="duel-name">Ти</div>
                <div class="mt-1.5 flex justify-end">
                  <div class="duel-bars">
                    <span class="is-correct"></span><span></span><span></span><span></span><span></span>
                  </div>
                </div>
              </div>
              <span class="duel-score">146</span>
              <span class="duel-avatar duel-avatar-mine">В</span>
            </div>

            <div class="duel-ring" style="--left: .73">
              <div>
                <span class="duel-ring-time">2:12</span>
                <span class="duel-ring-label">ОСТАВАТ</span>
              </div>
            </div>

            <div class="duel-side duel-side-theirs">
              <div class="min-w-0 flex-1">
                <div class="duel-name">neo_42</div>
                <div class="mt-1.5 flex">
                  <div class="duel-bars">
                    <span class="is-wrong"></span><span class="is-correct"></span><span></span><span></span><span></span>
                  </div>
                </div>
              </div>
              <span class="duel-score">121</span>
              <span class="duel-avatar duel-avatar-theirs">Н</span>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-end gap-6">
          <div>
            <div class="duel-ring is-low" style="--left: .12">
              <div>
                <span class="duel-ring-time">0:08</span>
                <span class="duel-ring-label">ОСТАВАТ</span>
              </div>
            </div>
            <div class="mt-2 text-xs font-bold text-muted">под 10 секунди</div>
          </div>

          <div class="min-w-[280px] flex-1">
            <div class="speed-meter">
              <span class="speed-meter-label">Бонус за бързина</span>
              <span class="speed-meter-track"><span class="speed-meter-fill" style="width: 72%"></span></span>
              <span class="speed-meter-value">+36</span>
            </div>
            <div class="mt-2 text-xs font-bold text-muted">
              Само показва; точките се смятат на сървъра от <code class="font-mono">question_started_at</code>.
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <span class="button-edge button-edge-primary">Нов дуел</span>
          <span class="button-edge button-edge-secondary">Откажи</span>
          <span class="duel-format-pill">5 задачи</span>
          <span class="duel-format-pill">по 30 секунди</span>
        </div>
      </section>

      <section class="space-y-5">
        <h2 class="text-xl font-bold">Отличия</h2>
        <p class="text-sm text-muted max-w-2xl">
          Медалът се чете по три неща: <b>формата</b> казва семейството, <b>металът</b> —
          докъде по стълбата, а <b>гравюрата</b> — за какво е. Заключеният медал се пълни
          отдолу в своя метал, така че сбирката показва колко остава, а не празнота.
          Всичко е CSS — няма картинки за поддържане.
        </p>

        <div class="flex flex-wrap items-end gap-6">
          <% Badges::FAMILIES.each do |family| %>
            <% badge = Badges.all.find { |b| b.family == family } %>
            <div class="text-center">
              <%= render "shared/medal", badge: badge, earned: true, size: :m %>
              <div class="mt-2 text-[13px] font-black"><%= t("badges.families.#{family}") %></div>
            </div>
          <% end %>
        </div>

        <div class="flex flex-wrap items-end gap-6">
          <% { "streak_3" => "Бронз", "streak_7" => "Сребро", "streak_30" => "Злато",
               "streak_100" => "Легенда", "perfect_session" => "Специално" }.each do |key, label| %>
            <div class="text-center">
              <%= render "shared/medal", badge: Badges.find(key), earned: true, size: :m %>
              <div class="mt-2 text-[13px] font-black"><%= label %></div>
            </div>
          <% end %>
        </div>

        <div class="flex flex-wrap items-end gap-6">
          <% [ [ "level_10", 0.0, "Заключено" ], [ "sessions_10", 0.6, "Наближава" ],
               [ "answers_500", 0.82, "Почти" ] ].each do |key, fill, label| %>
            <div class="text-center">
              <%= render "shared/medal", badge: Badges.find(key), earned: false, fill: fill, size: :m %>
              <div class="mt-2 text-[13px] font-black"><%= label %></div>
            </div>
          <% end %>
          <div class="text-center">
            <%= render "shared/medal", badge: Badges.find("upset_win"), earned: false, size: :m %>
            <div class="mt-2 text-[13px] font-black">Тайно</div>
          </div>
          <div class="text-center">
            <%= render "shared/medal", badge: Badges.find("perfect_session"), earned: true, is_new: true, size: :m %>
            <div class="mt-2 text-[13px] font-black">Ново</div>
          </div>
        </div>

        <div class="flex flex-wrap items-end gap-5">
          <% %i[xs s m l].each do |size| %>
            <%= render "shared/medal", badge: Badges.find("streak_7"), earned: true, size: size %>
          <% end %>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Празно състояние</h2>
        <div class="card-quiet max-w-md">
          <div class="text-[15px] font-black">Още няма домашни</div>
          <div class="mt-1 text-sm font-semibold text-muted">
            Щом учителят зададе нещо, ще се появи тук — с краен срок и брой задачи.
          </div>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Карта</h2>
        <div class="card max-w-md">
          <header><strong>Заглавие на карта</strong></header>
          <section>Съдържание на картата.</section>
          <footer class="text-sm text-gray-500">Долен колонтитул</footer>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold">Публична страница</h2>
        <p class="text-sm text-gray-500">
          Третият шел до <code class="font-mono">application</code> и <code class="font-mono">modal</code>:
          <code class="font-mono">landingpage</code>. Илюстрацията там е самият продукт — истинска
          <code class="font-mono">.practice-card</code> и истинска <code class="font-mono">.fb-band</code> в
          <code class="font-mono">.landing-peek</code> — а кехлибареното се появява само вътре в тази снимка,
          където значи същото, каквото значи навсякъде.
        </p>
        <div class="space-y-4">
          <div>
            <div class="landing-eyebrow">Как работи</div>
            <div class="landing-h2">Заглавие на раздел</div>
            <p class="landing-body max-w-xl">Водещ абзац на раздел от публичната страница.</p>
          </div>
          <div class="flex flex-wrap gap-3">
            <span class="landing-pill"><span class="size-1.5 rounded-full bg-primary-700"></span>Значка</span>
            <span class="landing-tag">Етикет</span>
          </div>
          <div class="grid gap-4 sm:grid-cols-3">
            <div class="landing-tile">
              <div class="landing-step-number">1</div>
              <div class="text-[17px] font-black tracking-[-.01em]">.landing-tile</div>
            </div>
            <div class="landing-quiet">
              <div class="text-[15.5px] font-black">.landing-quiet</div>
              <p class="mt-1 text-sm font-semibold text-muted">За въпроси и отговори.</p>
            </div>
            <div class="landing-stat">
              <div class="landing-stat-value">30 секунди</div>
              <div class="landing-stat-label">на задача в двубой</div>
            </div>
          </div>
          <div class="landing-panel">
            <div class="landing-eyebrow">Адаптивна трудност</div>
            <div class="landing-h2 mb-2">.landing-panel</div>
            <p class="landing-body mb-3">Единствената обърната лента, за да има хоризонт в средата на дълга страница.</p>
            <div class="landing-check"><span>✓</span><span>Проверка върху тъмно.</span></div>
          </div>
        </div>
      </section>

    </div>
  </main>
</div>

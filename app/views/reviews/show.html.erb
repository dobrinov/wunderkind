<%# Two lists of the same shape, so one screen with two tabs. The counts sit in
    the tabs rather than in a stat band above them: the number *is* the reason
    to press the tab, and a child reading „Сгреших 12" has already been told
    everything a tile would have said. %>
<% back = review_path(filter: @filter) %>

<div class="mx-auto flex max-w-3xl flex-col gap-5">
  <div>
    <h1 class="text-page font-black tracking-[-.02em]"><%= t("review.title") %></h1>
    <p class="mt-1 text-sm font-semibold text-muted"><%= t("review.subtitle") %></p>
  </div>

  <nav class="segmented" aria-label="<%= t("review.title") %>">
    <% { "wrong" => @wrong_count, "skipped" => @skipped_count }.each do |filter, count| %>
      <%= link_to review_path(filter: filter),
                  class: ("is-active" if @filter == filter), "aria-current": ("page" if @filter == filter) do %>
        <span><%= t("review.tab_#{filter}") %></span>
        <span class="segmented-count"><%= count %></span>
      <% end %>
    <% end %>
  </nav>

  <%# Only on the mistakes tab, and only when there is something in the pool to
      build from: the skips are deliberately not practisable — see
      ReviewsController#practice. %>
  <% if @filter == "wrong" && @practisable_count.positive? %>
    <div class="flex flex-col items-start gap-3.5 rounded-[14px] bg-primary-50 p-4 ring-1 ring-primary-100 sm:flex-row sm:items-center">
      <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-white text-xl" aria-hidden="true">🔁</span>
      <div class="min-w-0 flex-1">
        <div class="text-sm font-black text-primary-900"><%= t("review.practice_title") %></div>
        <div class="mt-0.5 text-caption font-bold text-primary-700">
          <%= t("review.practice_sub", count: [ @practisable_count, MistakePractice::DEFAULT_QUESTION_COUNT ].min) %>
        </div>
      </div>
      <%= button_to t("review.practice_cta"), practice_review_path,
                    class: "button button-primary shrink-0",
                    form_class: "shrink-0" %>
    </div>
  <% end %>

  <div class="card">
    <section>
      <% if @answers.any? %>
        <ul class="divide-y divide-ink-100">
          <% @answers.each do |answer| %>
            <% question = answer.assignment_question.question %>
            <%# The whole row opens the answer: the open link used to be a
                52×36 target at the end of a row a finger aims at anywhere. %>
            <li>
              <%= link_to question_answer_path(answer.assignment_question, back_path: back, close_path: back),
                          class: "-mx-2 flex items-start gap-3 rounded-[12px] px-2 py-3.5 hover:bg-ink-50" do %>
                <span class="mt-0.5 shrink-0 text-ui" aria-hidden="true">
                  <%= answer.skipped? ? "🤷" : "❌" %>
                </span>

                <span class="min-w-0 flex-1">
                  <span class="block text-ui font-bold text-ink-900"><%= truncate(question.body_text, length: 140) %></span>
                  <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-caption font-bold text-muted">
                    <% question.topics.each do |topic| %>
                      <span class="rounded-full bg-ink-100 px-2 py-0.5"><%= topic.name %></span>
                    <% end %>
                    <span><%= l answer.created_at.to_date, format: :short %></span>
                  </span>
                </span>

                <span class="mt-0.5 shrink-0 text-sm font-extrabold text-primary-700"><%= t("review.open") %> ›</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="card-quiet text-center text-sm font-bold text-muted">
          <%= t("review.empty_#{@filter}") %>
        </div>
      <% end %>
    </section>

    <% if @answers.respond_to?(:total_pages) && @answers.total_pages > 1 %>
      <footer><%= paginate @answers %></footer>
    <% end %>
  </div>
</div>

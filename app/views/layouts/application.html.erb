<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "shared/head" %>
  </head>

  <%# The document scrolls, not a panel inside it. With html, body and the
      wrapper pinned to the viewport and <main> scrolling on its own, iPad
      Safari never collapsed its toolbars (about 70px of a landscape screen,
      for good), a tap on the status bar never scrolled to the top, and a
      full-page screenshot came out one screen tall. The header and the tab
      bar stay put with `sticky` instead. %>
  <body class="bg-ink-50">
    <%= render "shared/impersonation_frame" if impersonating? %>
    <div class="flex min-h-dvh flex-col">
      <header class="sticky top-0 z-30 border-b border-ink-200 bg-white px-4">
        <div class="mx-auto flex min-h-16 max-w-7xl items-center gap-3 sm:gap-6">
          <%= logo %>

          <%= render "shared/main_nav", items: nav_items.reject { |item| item[:key] == :home } %>

          <div class="ml-auto flex items-center gap-2 sm:gap-3">
            <%= render "shared/child_switcher", children: switchable_children %>
            <% if current_user.student? %>
              <%= render "shared/player_stats", user: current_user %>
            <% end %>
            <%= render "shared/account_menu", items: nav_items %>
          </div>
        </div>
      </header>

      <% if acting_as_child? %>
        <%= render "shared/child_session_bar" %>
      <% end %>

      <main class="flex-grow p-4 pb-10">
        <div class="mx-auto max-w-7xl">
          <%= yield %>
        </div>
      </main>

      <% if current_user.student? %>
        <%= render "shared/tabbar", items: nav_items %>
      <% end %>
    </div>

    <%= render "shared/changelog_dialog", entries: unseen_changelog if unseen_changelog.any? %>
    <%= render "shared/flash" %>
  </body>
</html>

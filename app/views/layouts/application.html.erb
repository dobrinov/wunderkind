<!DOCTYPE html>
<html class="h-full" lang="<%= I18n.locale %>">
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="h-full bg-gray-50">
    <%= render "shared/impersonation_frame" if impersonating? %>
    <div class="flex flex-col h-full">
      <header class="border-b border-gray-200 bg-white px-4">
        <div class="mx-auto flex min-h-16 max-w-7xl items-center gap-3 sm:gap-6">
          <%= logo %>

          <%= render "shared/main_nav", items: nav_items.reject { |item| item[:key] == :home } %>

          <div class="ml-auto flex items-center gap-2 sm:gap-3">
            <%= render "shared/child_switcher", children: switchable_children %>
            <% if current_user.student? %>
              <%= render "shared/player_stats", user: current_user %>
            <% end %>
            <%= render "shared/account_menu", items: nav_items %>
          </div>
        </div>
      </header>

      <% if acting_as_child? %>
        <%= render "shared/child_session_bar" %>
      <% end %>

      <main class="overflow-y-auto flex-grow p-4 pb-10">
        <%# min-h-full, not h-full: a page taller than the viewport must grow
            the wrapper, or it overflows past it and main's bottom padding
            lands behind the content instead of below it. %>
        <div class="mx-auto max-w-7xl min-h-full">
          <%= yield %>
        </div>
      </main>

      <% if current_user.student? %>
        <%= render "shared/tabbar", items: nav_items %>
      <% end %>
    </div>

    <%= render "shared/changelog_dialog", entries: unseen_changelog if unseen_changelog.any? %>
    <%= render "shared/flash" %>
  </body>
</html>

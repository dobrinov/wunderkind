<!DOCTYPE html>
<html class="h-full" lang="<%= I18n.locale %>">
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="h-full bg-gray-50">
    <div class="flex flex-col h-full" data-controller="menu" data-action="keydown@document->menu#keydown">
      <header class="border-b border-gray-200 bg-white h-16 px-4">
        <div class="mx-auto max-w-7xl">
          <div class="flex gap-6 h-16 justify-between items-center">
            <%= logo %>

            <div class="max-sm:hidden flex flex-1 justify-between gap-1 items-center">
              <div>
                <% main_menu_items.each do |item| %>
                  <%= item %>
                <% end %>
              </div>
              <div class="flex items-center gap-3">
                <%= render "shared/player_stats", user: current_user %>
                <%= link_to current_user.name, profile_path, class: "inline-flex items-center px-3 py-1 text-sm font-medium text-gray-500 hover:bg-gray-100 rounded-md" %>
                <%= button_to t("nav.sign_out"), sign_out_path, method: :delete, form_class: "inline", class: "inline-flex items-center px-3 py-1 text-sm font-medium text-gray-500 hover:bg-gray-100 rounded-md cursor-pointer" %>
              </div>
            </div>

            <div class="sm:hidden flex items-center gap-3">
              <%= render "shared/player_stats", user: current_user %>
              <button type="button" data-menu-target="button" data-action="menu#toggle" class="relative inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500" aria-controls="mobile-menu" aria-expanded="false">
                <span class="sr-only"><%= t("nav.open_menu") %></span>
                <svg data-menu-target="openIcon" class="block size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
                <svg data-menu-target="closeIcon" class="hidden size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </header>

      <div id="mobile-menu" data-menu-target="panel" class="sm:hidden hidden border-b border-gray-200 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-3 space-y-1">
          <% main_menu_items(mobile: true).each do |item| %>
            <%= item %>
          <% end %>
          <%= link_to current_user.name, profile_path, class: "block w-full text-left text-base font-medium text-gray-700 hover:bg-gray-50 px-3 py-2 rounded-md" %>
          <%= button_to t("nav.sign_out"), sign_out_path, method: :delete, form_class: "block w-full", class: "block w-full text-left text-base font-medium text-gray-700 hover:bg-gray-50 px-3 py-2 rounded-md cursor-pointer" %>
        </div>
      </div>

      <main class="overflow-y-auto flex-grow p-4">
        <div class="mx-auto max-w-7xl h-full">
          <%= yield %>
        </div>
      </main>
    </div>

    <%= render "shared/flash" %>
  </body>
</html>

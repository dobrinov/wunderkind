<!DOCTYPE html>
<html class="h-full bg-gray-100" lang="<%= I18n.locale %>">
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="h-full lg:p-5">
    <main class="bg-white h-full relative flex flex-col rounded-xl">
      <header class="flex items-center px-5 py-3 border-b border-gray-200">
        <div class="flex-1 flex">
          <%= yield :header_left %>
        </div>
        <div class="flex-1 flex justify-center">
          <%= yield :header_middle %>
        </div>
        <div class="flex-1 flex justify-end">
          <%= link_to internal_path(params[:close_path], root_path), class: "rounded-md px-2 py-2 text-gray-900 hover:bg-gray-100 shrink-0" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="4" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          <% end %>
        </div>
      </header>
      <section class="flex-grow p-5 overflow-y-auto">
        <%= yield %>
      </section>
    </main>

    <%= render "shared/flash" %>
  </body>
</html>

<%# Two shapes of the same shell. A page that declares itself :bare owns all of
    its own chrome and gets the full bleed — the answering flow and the duel need
    their own progress headers and a gray page they can centre a column on, not
    a white card nested inside another white card. Everything else keeps the
    original dialog: back arrow, middle slot, close ✕. %>
<% bare = content_for?(:bare) %>
<!DOCTYPE html>
<html class="h-full <%= bare ? 'bg-gray-50' : 'bg-gray-100' %>" lang="<%= I18n.locale %>">
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="h-full <%= 'lg:p-5' unless bare %>">
    <main class="h-full relative flex flex-col <%= 'bg-white rounded-xl' unless bare %>">
      <% unless bare %>
        <header class="flex items-center px-5 py-3 border-b border-gray-200">
          <div class="flex-1 flex">
            <%= yield :header_left %>
          </div>
          <div class="flex-1 flex justify-center">
            <%= yield :header_middle %>
          </div>
          <div class="flex-1 flex justify-end">
            <%= link_to internal_path(params[:close_path], root_path), class: "rounded-md px-2 py-2 text-gray-900 hover:bg-gray-100 shrink-0" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="4" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            <% end %>
          </div>
        </header>
      <% end %>

      <section class="flex-grow overflow-y-auto <%= 'p-5' unless bare %>">
        <%= yield %>
      </section>
    </main>

    <%= render "shared/flash" %>
  </body>
</html>

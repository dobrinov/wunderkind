<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "shared/head" %>
  </head>

  <%# The same header as the application layout (shared/_app_header): an admin
      who is also a parent moves between „Семейство" and „Администрация"
      without the chrome changing under them. Wider than the app's pages, for
      the browsers and queues that want three columns. %>
  <body class="bg-ink-50">
    <%= render "shared/impersonation_frame" if impersonating? %>
    <div class="flex min-h-dvh flex-col">
      <%= render "shared/app_header" %>

      <main class="flex-grow p-4 pb-10">
        <div class="mx-auto max-w-[96rem]">
          <%= yield %>
        </div>
      </main>
    </div>

    <%= render "shared/changelog_dialog", entries: unseen_changelog if unseen_changelog.any? %>
    <%= render "shared/flash" %>
  </body>
</html>

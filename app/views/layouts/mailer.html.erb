<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%# Inline styles only: most mail clients drop <style> blocks and every
        class with them. One column, 560px at most, so a phone shows it whole. %>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2133;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f8;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
            <tr>
              <td style="padding:0 4px 14px;font-size:20px;font-weight:900;color:#3730a3;letter-spacing:-.02em;">Wunderkind</td>
            </tr>
            <tr>
              <td style="background:#ffffff;border:1px solid #e4e4ee;border-radius:16px;padding:24px;font-size:15px;line-height:1.55;">
                <%= yield %>
              </td>
            </tr>
            <% if content_for?(:footer) %>
              <tr>
                <td style="padding:16px 4px 0;font-size:12px;line-height:1.5;color:#7a7c94;"><%= yield :footer %></td>
              </tr>
            <% end %>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

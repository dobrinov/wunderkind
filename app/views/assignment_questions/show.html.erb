<% content_for :header_middle do %>
  <div class="relative grow overflow-hidden rounded-full bg-gray-200 max-w-lg mx-auto">
    <div class="h-2 rounded-full bg-primary-600" style="width: <%= @assignment.answered_questions.count.to_f / @assignment.questions.count * 100 %>%"></div>
  </div>
<% end %>

<% if params[:back_path] %>
  <% content_for :header_left do %>
    <%= link_to internal_path(params[:back_path], root_path), class: "rounded-md px-2 py-2 text-gray-900 hover:bg-gray-100 shrink-0" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="4" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
    <% end %>
  <% end %>
<% end %>

<div class="h-full flex flex-col gap-4 items-center">
  <div class="w-full flex-1 overflow-y-auto" data-controller="scroll-shadows">
    <div class="w-full max-w-xl flex flex-col gap-6 mx-auto h-full <%= 'justify-center' unless @question.image %>">
      <% if @question.image %>
        <div class="rounded-xl overflow-hidden w-full flex justify-center">
          <%= image_tag @question.image.file, alt: "" %>
        </div>
      <% end %>
      <%= question_body(@question, large: @question.image.nil? && @question.body_text.size < 60) %>
    </div>
  </div>

  <% if @answer.present? %>
    <%= render "answers/feedback", answer: @answer, question: @question, next_assignment_question: @next_assignment_question %>
  <% else %>
    <div class="shrink-0 max-w-xl w-full">
      <%= form_with url: question_answer_path(@assignment_question), method: :post,
                    data: { controller: "answer-form", action: "submit->answer-form#submit", turbo: false } do |f| %>
        <%= hidden_field_tag :started_at, Time.current.iso8601 %>

        <% case @question.answer_type %>
        <% when "multiple_choice" %>
          <% if @question.correct_possible_answers.size == 1 %>
            <div class="grid grid-cols-2 gap-4">
              <% @question.possible_answers.shuffle.each_with_index do |option, index| %>
                <%= button_tag option.value, type: :submit, name: "selected_ids[]", value: option.id,
                               class: "choice-button", autofocus: index.zero? %>
              <% end %>
            </div>
          <% else %>
            <div class="grid grid-cols-2 gap-4 mb-4">
              <% @question.possible_answers.shuffle.each do |option| %>
                <label class="choice-button flex items-center gap-3 has-checked:border-primary-500 has-checked:bg-primary-50">
                  <%= check_box_tag "selected_ids[]", option.id, false, class: "size-4 accent-primary-600" %>
                  <span><%= option.value %></span>
                </label>
              <% end %>
            </div>
            <%= f.submit t("answers.submit"), class: "button button-primary button-large", data: { answer_form_target: "submit" } %>
          <% end %>
        <% when "exact_value" %>
          <div class="space-y-4">
            <% if @numeric_answer %>
              <div data-controller="math-input" class="w-full">
                <div data-math-input-target="field" class="rounded-lg bg-white outline outline-1 -outline-offset-1 outline-gray-300 focus-within:outline-2 focus-within:outline-primary-600 p-2 text-xl"></div>
                <%= hidden_field_tag :value, "", data: { math_input_target: "hidden" }, required: true %>
              </div>
            <% else %>
              <%= text_field_tag :value, "", placeholder: t("answers.placeholder"), autocomplete: "off", required: true, autofocus: true, class: "py-3 px-4 text-base" %>
            <% end %>
            <%= f.submit t("answers.submit"), class: "button button-primary button-large", data: { answer_form_target: "submit" } %>
          </div>
        <% when "interactive" %>
          <div class="space-y-4">
            <%= render "widgets/#{Widgets.find(@question.widget_type).key}", widget_params: @question.grading.fetch("params", {}) %>
            <%= f.submit t("answers.check"), class: "button button-primary button-large", data: { answer_form_target: "submit" } %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

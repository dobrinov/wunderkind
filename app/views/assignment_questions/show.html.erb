<% close_path = internal_path(params[:close_path], home_path) %>

<% content_for :bare, true %>

<%# One column, top-anchored. The question, the thing you answer it with and the
    feedback are one unit at a comfortable reading distance — the old layout
    centred the question and pinned the control to the bottom of a full-height
    flex column, which on a laptop put half a screen of nothing between the
    number-line prompt and the number line. %>
<div class="practice-shell" data-controller="scratchpad" data-scratchpad-key-value="scratchpad-<%= @assignment_question.id %>">
  <%= render "shared/practice_header", assignment: @assignment, current: @assignment_question,
                                      close_path: close_path, back_path: params[:back_path], scratchpad: true %>
  <%= render "shared/scratchpad" %>

  <%# Side by side on a landscape tablet or wider (see .practice-layout): once
      answered, the problem on the left and the feedback beside it, so „Защо"
      is read next to the problem it explains instead of after it has
      scrolled away; before answering, only a problem with a picture or a tall
      widget splits, so the controls are on screen without scrolling past the
      figure. Everything else keeps the one comfortable column. %>
  <% layout = @answer.present? ? "is-answered" : ("is-split" if split_prompt?(@question)) %>
  <div class="practice-column <%= "is-wide" if layout %>">
    <div class="practice-layout <%= layout %>">
      <div class="practice-card">
        <div class="practice-prompt">
          <div class="practice-meta">
            <% if (topic = @question.topics.first) %>
              <span class="topic-pill"><%= topic.name %></span>
            <% end %>
            <%# No „Ниво Уверен": the band names are words about children, and on the
                problem in front of one they read as a verdict on them — see RatingBand. %>
            <%= render "shared/suggested_by", question: @question %>
          </div>

          <% if @question.image %>
            <div class="mb-6 flex justify-center overflow-hidden rounded-xl">
              <%= image_tag @question.image.file, alt: "" %>
            </div>
          <% end %>

          <%= question_body(@question, large: @question.image.nil? && @question.body_text.size < 60) %>
        </div>

        <% if @answer.blank? %>
          <div class="practice-respond">
            <%= form_with url: question_answer_path(@assignment_question), method: :post,
                          data: { controller: "answer-form", action: "submit->answer-form#submit keydown->answer-form#keydown:capture", turbo: false, trace_event: "problem_answered" } do %>
              <%= hidden_field_tag :started_at, Time.current.iso8601 %>

              <%= render "answers/inputs", question: @question, numeric_answer: @numeric_answer %>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if @answer.present? %>
        <div class="practice-feedback">
          <%= render "answers/feedback", answer: @answer, question: @question,
                                        assignment: @assignment, next_assignment_question: @next_assignment_question %>
        </div>
      <% end %>
    </div>

    <% unless @answer.present? %>
      <% if @hint %>
        <%# The ladder itself stays on the server — only the rungs already paid
            for are on the page, and each click fetches the next one. The rung
            markup below must match what hints_controller.js appends. %>
        <div class="mt-4 flex flex-col gap-2" data-controller="hints"
             data-hints-url-value="<%= question_hint_reveal_path(@assignment_question) %>"
             data-hints-total-value="<%= @hint.ladder.size %>"
             data-hints-revealed-value="<%= @assignment_question.hints_revealed %>">
          <div data-hints-target="list" class="flex flex-col gap-2">
            <% @hint.ladder.first(@assignment_question.hints_revealed).each do |rung| %>
              <div class="rounded-lg bg-reward-100 text-reward-800 px-4 py-2 text-sm"><%= rung %></div>
            <% end %>
          </div>
          <div class="flex items-center gap-3">
            <button type="button" data-hints-target="button" data-action="hints#reveal" class="button button-secondary"><%= t("hints.show") %></button>
            <span class="text-xs text-muted"><%= t("hints.xp_note") %></span>
          </div>
        </div>
      <% end %>

      <%# Absent in a mistakes session: see Assignment#skippable?. %>
      <div class="mt-4 flex justify-center <%= "hidden" unless @assignment.skippable? %>">
        <%= button_to question_skip_path(@assignment_question), form: { data: { turbo: false, trace_event: "problem_skipped" } },
                      class: "button button-quiet",
                      title: t("answers.not_taught_tooltip") do %>
          <span aria-hidden="true">🤷</span>
          <span><%= t("answers.not_taught") %></span>
        <% end %>
      </div>
    <% end %>

    <%# Below everything else, in both states: a wrong answer we accept is
        usually only discovered after answering. %>
    <%= render "shared/report_problem", question: @question, url: question_report_path(@assignment_question) %>
  </div>
</div>

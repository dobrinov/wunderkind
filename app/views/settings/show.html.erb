<%# Settings, behind the avatar. These forms were the bottom half of the
    profile — folded away on a phone, open on a desktop — so a child came to
    look at their medals and scrolled past a password form to do it. The
    profile („Аз") is now about the child; this page is about the account. %>
<div class="mx-auto flex max-w-5xl flex-col gap-5" data-trace-mask>
  <div class="flex flex-wrap items-baseline gap-2.5">
    <h1 class="text-2xl font-black tracking-[-.02em]"><%= t("nav.settings") %></h1>
  </div>

  <%= render "shared/verification_notice" %>

    <div class="grid-halves">
      <div class="card">
        <header><strong><%= t("profile.personal_data") %></strong></header>
        <section>
          <%= form_with model: @user, url: profile_path, method: :put, class: "space-y-4" do |f| %>
            <% if @user.email.present? %>
              <div>
                <%= f.label :email, t("auth.email") %>
                <%= f.text_field :email, disabled: true %>
              </div>
            <% else %>
              <%# A managed child has no address and no password of their own,
                  so an empty, disabled email box would only puzzle them. %>
              <p class="text-xs text-muted"><%= t("profile.managed_account") %></p>
            <% end %>

            <div>
              <%= f.label :name, t("auth.name") %>
              <%= f.text_field :name %>
            </div>

            <div>
              <%= f.label :nickname, t("auth.nickname") %>
              <%= f.text_field :nickname %>
              <p class="mt-1 text-xs text-muted"><%= t("auth.nickname_hint") %></p>
            </div>

            <% if @user.student? %>
              <%= render "shared/school_fields", scope: "user", birth_year: @user.birth_year, grade_offset: @user.grade_offset %>
            <% end %>

            <div>
              <%= f.submit t("profile.save"), class: "button button-primary" %>
            </div>
          <% end %>

          <%# Not while a child's profile is open: current_user is the child
              there, and neither their password nor the parent's is what a
              form on the child's own screen would mean. %>
          <% unless acting_as_child? %>
            <div class="mt-4 border-t border-gray-100 pt-4">
              <div class="text-sm font-extrabold"><%= t("profile_password.title") %></div>
              <% unless Mailing.enabled? %>
                <%# Said out loud because it is true and because the sign-in
                    page no longer offers a way back in. %>
                <p class="mb-3 mt-0.5 text-xs text-muted"><%= t("profile_password.no_recovery") %></p>
              <% end %>

              <%= form_with url: password_profile_path, method: :patch, class: "mt-3 space-y-4" do %>
                <div>
                  <%= label_tag :current_password, t("profile_password.current") %>
                  <%= password_field_tag :current_password, nil, autocomplete: "current-password" %>
                </div>

                <div>
                  <%= label_tag :password, t("profile_password.new") %>
                  <%= password_field_tag :password, nil, autocomplete: "new-password" %>
                  <p class="mt-1 text-xs text-muted"><%= t("profile_password.length_hint", count: User::MINIMUM_PASSWORD_LENGTH) %></p>
                </div>

                <div>
                  <%= label_tag :password_confirmation, t("profile_password.confirm") %>
                  <%= password_field_tag :password_confirmation, nil, autocomplete: "new-password" %>
                </div>

                <div>
                  <%= submit_tag t("profile_password.submit"), class: "button button-primary" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </section>
      </div>

      <div class="card">
        <header><strong><%= t("profile.practice_settings") %></strong></header>
        <section>
          <%= form_with model: @user, url: profile_path, method: :put, class: "space-y-4" do |f| %>
            <div class="flex items-center gap-3">
              <div class="group relative inline-flex w-11 shrink-0 rounded-full bg-gray-200 p-0.5 inset-ring inset-ring-gray-900/5 outline-offset-2 outline-primary-600 transition-colors duration-200 ease-in-out has-checked:bg-primary-600 has-focus-visible:outline-2">
                <span class="size-5 rounded-full bg-white shadow-xs ring-1 ring-gray-900/5 transition-transform duration-200 ease-in-out group-has-checked:translate-x-5"></span>
                <%= f.check_box :feedback_after_answer, class: "absolute inset-0 appearance-none focus:outline-hidden" %>
              </div>

              <label class="text-sm font-medium text-gray-900"><%= t("profile.feedback_after_answer") %></label>
            </div>

            <%# The same switch as the speaker button on the practice screen —
                this is where you look for it when you are not mid-question. %>
            <div class="flex items-center gap-3">
              <div class="group relative inline-flex w-11 shrink-0 rounded-full bg-gray-200 p-0.5 inset-ring inset-ring-gray-900/5 outline-offset-2 outline-primary-600 transition-colors duration-200 ease-in-out has-checked:bg-primary-600 has-focus-visible:outline-2">
                <span class="size-5 rounded-full bg-white shadow-xs ring-1 ring-gray-900/5 transition-transform duration-200 ease-in-out group-has-checked:translate-x-5"></span>
                <%= f.check_box :sound_effects, class: "absolute inset-0 appearance-none focus:outline-hidden" %>
              </div>

              <label class="text-sm font-medium text-gray-900"><%= t("profile.sound_effects") %></label>
            </div>

            <div>
              <%= f.label :daily_minutes_target, t("profile.daily_minutes_target") %>
              <%= f.number_field :daily_minutes_target, min: 5, max: 120, step: 5 %>
              <p class="mt-1 text-xs text-muted"><%= t("profile.daily_minutes_hint") %></p>
            </div>

            <div>
              <%= f.submit t("profile.save"), class: "button button-primary" %>
            </div>
          <% end %>

          <%# The dialog is answered once and then gone; this is the way back to
              what it said. %>
          <div class="mt-4 border-t border-gray-100 pt-4">
            <%= link_to t("changelog.page_title"), changelog_path, class: "text-sm font-extrabold text-primary-700 hover:underline" %>
            <p class="mt-0.5 text-xs text-muted"><%= t("changelog.page_subtitle") %></p>
          </div>

          <% if @user.student? %>
            <div class="mt-4 border-t border-gray-100 pt-4">
              <div class="text-sm font-extrabold"><%= t("profile_link_code.title") %></div>
              <p class="mb-3 mt-0.5 text-xs text-muted"><%= t("profile_link_code.hint") %></p>
              <div class="code-row">
                <% if @user.link_code.present? %>
                  <span class="code-chip"><%= @user.link_code %></span>
                <% else %>
                  <%= button_to t("profile_link_code.generate"), link_code_profile_path, class: "button button-secondary" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </section>
      </div>

      <%# Which emails to receive — the same switches as the page linked from
          every email. Only while there is mail at all, and only for an account
          with an address of its own (a managed child has none). %>
      <% if Mailing.enabled? && @user.email.present? %>
        <div class="card" id="emails">
          <header><strong><%= t("email_preferences.title") %></strong></header>
          <section>
            <%= form_with model: @user, url: profile_path, method: :put do |f| %>
              <%= render "shared/email_switches", user: @user, scope: "user" %>
              <% if EmailPreferences.for(@user).any? %>
                <div class="mt-4"><%= f.submit t("profile.save"), class: "button button-primary" %></div>
              <% end %>
            <% end %>
          </section>
        </div>
      <% end %>
    </div>
</div>

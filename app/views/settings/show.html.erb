<%# Settings, behind the avatar: the account, where the profile („Аз") is
    about the child. Grouped rows rather than cards of forms — the page used
    to be three cards with three save buttons, so a switch flipped and left
    was a switch never saved. Now the switches save themselves
    (settings-switches), and only what is typed keeps a button: one per group
    that has text in it, the profile and the password. %>
<div class="mx-auto flex max-w-2xl flex-col gap-6" data-trace-mask>
  <h1 class="text-page font-black tracking-[-.02em]"><%= t("nav.settings") %></h1>

  <%= render "shared/verification_notice" %>

  <section class="settings-group" aria-labelledby="settings-profile">
    <h2 class="settings-group-title" id="settings-profile"><%= t("settings.groups.profile") %></h2>
    <%= form_with model: @user, url: profile_path, method: :put, class: "settings-rows" do |f| %>
      <% if @user.email.present? %>
        <div class="settings-row">
          <span class="settings-row-label"><%= t("auth.email") %></span>
          <span class="settings-row-value min-w-0 truncate"><%= @user.email %></span>
        </div>
      <% else %>
        <%# A managed child has no address and no password of their own, so an
            empty email row would only puzzle them. %>
        <div class="settings-row">
          <span class="settings-row-sub"><%= t("profile.managed_account") %></span>
        </div>
      <% end %>

      <div class="flex flex-col gap-4 px-4 py-4">
        <div class="field">
          <%= f.label :name, t("auth.name") %>
          <%= f.text_field :name, autocomplete: "name" %>
        </div>

        <div class="field">
          <%= f.label :nickname, t("auth.nickname") %>
          <%= f.text_field :nickname, autocomplete: "nickname" %>
          <p class="field-hint"><%= t("auth.nickname_hint") %></p>
        </div>

        <% if @user.student? %>
          <%= render "shared/school_fields", scope: "user", birth_year: @user.birth_year, grade_offset: @user.grade_offset %>
        <% end %>

        <div><%= f.submit t("profile.save"), class: "button button-primary" %></div>
      </div>
    <% end %>
  </section>

  <%# Switches, so they save as they are flipped. The minutes are a strip of
      buttons rather than a select for the same reason: one tap is the whole
      choice. Once a parent is linked the length is theirs to set
      (Parents::DailyMinutesController) and this only says what it is. %>
  <%# The outcome of an instant save is said beside the group's heading, so the
      line it needs is always there and nothing moves when it appears. %>
  <% switches = { controller: "settings-switches",
                  settings_switches_url_value: profile_path,
                  settings_switches_saved_value: t("settings.saved"),
                  settings_switches_failed_value: t("settings.failed") } %>
  <%= tag.section class: "settings-group", aria: { labelledby: "settings-practice" }, data: switches do %>
    <div class="flex items-baseline justify-between gap-3">
      <h2 class="settings-group-title" id="settings-practice"><%= t("settings.groups.practice") %></h2>
      <p class="settings-status" role="status" data-settings-switches-target="status"></p>
    </div>
    <%= form_with model: @user, url: profile_path, method: :put do |f| %>
      <div class="settings-rows">
        <label class="settings-row" for="user_feedback_after_answer">
          <span class="settings-row-label">
            <%= t("profile.feedback_after_answer") %>
            <span class="settings-row-sub"><%= t("settings.feedback_hint") %></span>
          </span>
          <%= f.check_box :feedback_after_answer, class: "switch", role: "switch", data: { action: "settings-switches#toggle" } %>
        </label>

        <%# The same switch as the speaker button on the practice screen —
            this is where you look for it when you are not mid-question. %>
        <label class="settings-row" for="user_sound_effects">
          <span class="settings-row-label"><%= t("profile.sound_effects") %></span>
          <%= f.check_box :sound_effects, class: "switch", role: "switch", data: { action: "settings-switches#toggle" } %>
        </label>

        <% minutes = current_user.daily_minutes_target.presence || DailyPractice::DEFAULT_MINUTES %>
        <%# Only a student has a daily session. A parent sets a child's on the
            child's page, and their own would size nothing. %>
        <% if @user.student? && current_user.parents.exists? %>
          <div class="settings-row">
            <span class="settings-row-label">
              <%= t("settings.daily_goal") %>
              <span class="settings-row-sub"><%= t("profile.daily_minutes_by_parent", count: minutes) %></span>
            </span>
          </div>
        <% elsif @user.student? %>
          <%# Bare numbers under a label that says „minutes": five „N минути"
              wrapped onto three lines at phone width. Each still reads out in
              full. %>
          <div class="settings-row flex-wrap">
            <span class="settings-row-label min-w-56">
              <%= t("profile.daily_minutes_target") %>
              <span class="settings-row-sub"><%= t("profile.daily_minutes_hint") %></span>
            </span>
            <div class="segmented" role="group" aria-label="<%= t("profile.daily_minutes_target") %>">
              <% DailyPractice::MINUTES_OPTIONS.each do |option| %>
                <%= f.button option, type: "submit", "aria-label": t("profile.minutes_option", count: option),
                             name: "user[daily_minutes_target]", value: option,
                             class: ("is-active" if option == minutes),
                             "aria-pressed": (option == minutes),
                             data: { action: "settings-switches#choose" } %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="mt-3 px-4" data-settings-switches-target="fallback">
        <%= f.submit t("profile.save"), class: "button button-secondary" %>
      </div>
    <% end %>
  <% end %>

  <%# Which emails to receive — the same list as the page linked from every
      email. Only while there is mail at all, and only for an account with an
      address of its own (a managed child has none). %>
  <% kinds = EmailPreferences.for(@user) %>
  <% if Mailing.enabled? && @user.email.present? %>
    <%= tag.section class: "settings-group scroll-mt-20", id: "emails", aria: { labelledby: "settings-emails" }, data: switches do %>
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="settings-group-title" id="settings-emails"><%= t("email_preferences.title") %></h2>
        <p class="settings-status" role="status" data-settings-switches-target="status"></p>
      </div>
      <%= form_with model: @user, url: profile_path, method: :put do |f| %>
        <div class="settings-rows">
          <% kinds.each do |kind| %>
            <label class="settings-row" for="user_<%= kind.key %>">
              <span class="settings-row-label">
                <%= t("email_preferences.kinds.#{kind.key}.title") %>
                <span class="settings-row-sub"><%= t("email_preferences.kinds.#{kind.key}.body") %></span>
              </span>
              <%= f.check_box kind.key, class: "switch", role: "switch", data: { action: "settings-switches#toggle" } %>
            </label>
          <% end %>
          <%# The account emails have no switch — they are only sent because
              the person just asked — but saying so is what makes the list
              above read as complete. %>
          <div class="settings-row">
            <span class="settings-row-label">
              <%= t("email_preferences.always.title") %>
              <span class="settings-row-sub"><%= t("email_preferences.always.body") %></span>
            </span>
          </div>
        </div>
        <% if kinds.any? %>
          <div class="mt-3 px-4" data-settings-switches-target="fallback">
            <%= f.submit t("profile.save"), class: "button button-secondary" %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# Not while a child's profile is open: current_user is the child there,
      and neither their password nor the parent's is what a form on the
      child's own screen would mean. Folded into a row, because it is the one
      form here that is opened twice a year. %>
  <% unless acting_as_child? %>
    <section class="settings-group" aria-labelledby="settings-security">
      <h2 class="settings-group-title" id="settings-security"><%= t("settings.groups.security") %></h2>
      <div class="settings-rows">
        <details class="settings-disclosure">
          <summary class="settings-row">
            <span class="settings-row-label"><%= t("profile_password.title") %></span>
            <%= render "shared/icon", name: :chevron, size: 20, class: "settings-row-chevron" %>
          </summary>
          <div class="settings-disclosure-body">
            <% unless Mailing.enabled? %>
              <%# Said out loud because it is true and because the sign-in page
                  no longer offers a way back in. %>
              <p class="mb-4 text-meta font-semibold text-ink-500"><%= t("profile_password.no_recovery") %></p>
            <% end %>

            <%= form_with url: password_profile_path, method: :patch, class: "flex flex-col gap-4" do %>
              <div class="field">
                <%= label_tag :current_password, t("profile_password.current") %>
                <%= password_field_tag :current_password, nil, autocomplete: "current-password" %>
              </div>

              <div class="field">
                <%= label_tag :password, t("profile_password.new") %>
                <%= password_field_tag :password, nil, autocomplete: "new-password" %>
                <p class="field-hint"><%= t("profile_password.length_hint", count: User::MINIMUM_PASSWORD_LENGTH) %></p>
              </div>

              <div class="field">
                <%= label_tag :password_confirmation, t("profile_password.confirm") %>
                <%= password_field_tag :password_confirmation, nil, autocomplete: "new-password" %>
              </div>

              <div><%= submit_tag t("profile_password.submit"), class: "button button-secondary" %></div>
            <% end %>
          </div>
        </details>
      </div>
    </section>
  <% end %>

  <section class="settings-group" aria-labelledby="settings-about">
    <h2 class="settings-group-title" id="settings-about"><%= t("settings.groups.about") %></h2>
    <div class="settings-rows">
      <% if @user.student? %>
        <div class="settings-row flex-wrap">
          <span class="settings-row-label min-w-48">
            <%= t("profile_link_code.title") %>
            <span class="settings-row-sub"><%= t("profile_link_code.hint") %></span>
          </span>
          <% if @user.link_code.present? %>
            <span class="code-chip"><%= @user.link_code %></span>
          <% else %>
            <%= button_to t("profile_link_code.generate"), link_code_profile_path, class: "button button-secondary" %>
          <% end %>
        </div>
      <% end %>

      <%# The dialog is answered once and then gone; this is the way back to
          what it said. %>
      <%= link_to changelog_path, class: "settings-row" do %>
        <span class="settings-row-label">
          <%= t("changelog.page_title") %>
          <span class="settings-row-sub"><%= t("changelog.page_subtitle") %></span>
        </span>
        <% if (version = Changelog.current_version) %>
          <span class="settings-row-value"><%= t("settings.version", version: version) %></span>
        <% end %>
        <%= render "shared/icon", name: :chevron, size: 20, class: "settings-row-chevron" %>
      <% end %>

      <%= button_to sign_out_path, method: :delete, class: "settings-row is-danger", form_class: "block" do %>
        <span class="settings-row-label"><%= t("nav.sign_out") %></span>
      <% end %>
    </div>
  </section>
</div>

<div class="page">
  <header>
    <h1><%= t("teachers.classrooms.title") %></h1>
    <%= link_to t("teachers.classrooms.new"), new_teachers_classroom_path, class: "button button-primary" %>
  </header>

  <main>
    <%= render "shared/verification_notice" %>

    <% if @classrooms.empty? %>
      <div class="alert-info"><div><div><p><%= t("teachers.classrooms.empty") %></p></div></div></div>
    <% else %>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% @classrooms.each do |classroom| %>
          <%= link_to teachers_classroom_path(classroom), class: "card hover:ring-primary-300 transition-shadow" do %>
            <header class="flex justify-between items-center">
              <strong><%= classroom.name %></strong>
              <span class="text-sm text-gray-500"><%= classroom.students.size %> 👧👦</span>
            </header>
            <section class="text-sm text-gray-500">
              <%= t("teachers.classrooms.invite_code") %>:
              <span class="font-mono font-bold tracking-widest text-primary-700"><%= classroom.invite_code %></span>
            </section>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </main>
</div>

<div class="page">
  <header>
    <h1><%= @homework.title %></h1>
    <%= link_to @homework.classroom.name, teachers_classroom_path(@homework.classroom), class: "button button-secondary" %>
  </header>

  <main>
    <div class="flex flex-col gap-4">
      <p class="text-sm text-gray-500">
        <%= t("homework.due", date: l(@homework.due_at, format: :short)) %>
        · <%= @homework.questions.size %> <%= t("overseer.nav.questions").downcase %>
      </p>

      <div class="card">
        <header><strong><%= t("teachers.homeworks.results") %></strong></header>
        <section>
          <div class="overflow-x-auto">
            <table>
              <thead>
                <tr>
                  <th><%= t("teachers.homeworks.student") %></th>
                  <th><%= t("teachers.homeworks.status") %></th>
                  <th><%= t("teachers.homeworks.score") %></th>
                </tr>
              </thead>
              <tbody>
                <% @students.each do |student| %>
                  <% completion = @homework.completion_for(student) %>
                  <tr>
                    <td><%= student.name %></td>
                    <td>
                      <% if completion.nil? || (completion[:correct].zero? && !completion[:completed] && completion[:assignment].user_answers.empty?) %>
                        <span class="text-gray-400"><%= t("teachers.homeworks.not_started") %></span>
                      <% elsif completion[:completed] && completion[:on_time] %>
                        <span class="text-green-600 font-semibold">✓ <%= t("teachers.homeworks.done_on_time") %></span>
                      <% elsif completion[:completed] %>
                        <span class="text-yellow-600 font-semibold">✓ <%= t("teachers.homeworks.done_late") %></span>
                      <% else %>
                        <span class="text-primary-600"><%= t("teachers.homeworks.in_progress") %></span>
                      <% end %>
                    </td>
                    <td>
                      <% if completion && completion[:completed] %>
                        <%= completion[:correct] %>/<%= completion[:total] %>
                      <% else %>
                        —
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <% free_text_answers = @homework.assignments.flat_map { |a| a.user_answers.select { |ua| ua.response.key?("verdict") } } %>
      <% if free_text_answers.any? %>
        <div class="card">
          <header><strong><%= t("overrides.pending_title") %></strong></header>
          <section class="space-y-3">
            <% free_text_answers.each do |answer| %>
              <div class="rounded-xl border border-gray-200 p-3">
                <div class="text-xs text-gray-500 mb-1">
                  <%= answer.user.name %> · <%= answer.assignment_question.question.body_text.truncate(80) %>
                </div>
                <div class="flex items-center gap-3 flex-wrap">
                  <p class="flex-1 text-sm">„<%= answer.value %>“</p>
                  <% verdict = answer.response["verdict"] %>
                  <span class="text-xs font-semibold <%= { 'correct' => 'text-green-600', 'partial' => 'text-yellow-600', 'pending_review' => 'text-yellow-600' }.fetch(verdict, 'text-red-600') %>">
                    <%= verdict == "pending_review" ? "⏳ #{t('free_text.pending')}" : verdict %>
                    <%= "✎" if answer.response["overridden"] %>
                  </span>
                  <div class="flex gap-2">
                    <% unless answer.correct? %>
                      <%= button_to t("overrides.mark_correct"), answer_override_path(answer, correct: 1), method: :patch, class: "button button-success" %>
                    <% end %>
                    <% if answer.correct? %>
                      <%= button_to t("overrides.mark_incorrect"), answer_override_path(answer, correct: 0), method: :patch, class: "button button-secondary" %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </section>
        </div>
      <% end %>

      <div class="card">
        <header><strong><%= t("overseer.questions.title") %></strong></header>
        <section class="space-y-2">
          <% @homework.questions.each_with_index do |question, index| %>
            <div class="flex gap-3 items-baseline">
              <span class="font-bold text-gray-400"><%= index + 1 %>.</span>
              <span class="text-sm"><%= question.body_text.truncate(120) %></span>
            </div>
          <% end %>
        </section>
      </div>
    </div>
  </main>
</div>

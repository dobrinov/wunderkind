<%# „Типови задачи" — see ProblemTypes. Every type with enough problems, the
    biggest first, each one press from its page. %>
<div class="flex w-full max-w-2xl flex-col gap-4">
  <div>
    <h1 class="text-page font-black tracking-[-.02em]"><%= t("problem_types.title") %></h1>
    <p class="mt-1 text-ui font-semibold text-muted"><%= t("problem_types.lead") %></p>
  </div>

  <% if @offered.empty? %>
    <div class="card-quiet text-center text-sm font-bold text-muted"><%= t("problem_types.empty") %></div>
  <% else %>
    <div class="flex flex-col gap-2">
      <% @offered.each do |type, count| %>
        <%= link_to problem_type_path(type.slug), class: "list-row" do %>
          <span class="min-w-0 flex-1">
            <span class="list-row-title"><%= type.name %></span>
            <span class="list-row-sub"><%= type.short %> · <%= t("problem_types.count", count: count) %></span>
          </span>
          <%= render "shared/icon", name: :chevron, size: 20, class: "list-row-chevron" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

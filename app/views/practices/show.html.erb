<%# Every way to practise, one row each — see PracticesController. The daily
    session leads, in the brand colour, because it is the one a child is here
    for most days; the rest are rows of the same shape so the page reads as a
    list of choices rather than a page of cards. %>
<div class="mx-auto flex max-w-2xl flex-col gap-3" data-trace-mask>
  <h1 class="mb-2 text-[28px] font-black tracking-[-.02em]"><%= t("nav.practice") %></h1>

  <%= button_to daily_assignment_path, class: "list-row is-primary w-full text-left", form_class: "contents" do %>
    <span class="list-row-icon"><%= render "shared/icon", name: :clock, size: 24 %></span>
    <span class="min-w-0 flex-1">
      <span class="list-row-title"><%= @practised_today ? t("practice_page.daily_again") : t("practice_page.daily") %></span>
      <span class="list-row-sub"><%= t("practice_page.daily_sub", count: @minutes) %></span>
    </span>
    <%= render "shared/icon", name: :chevron, size: 20, class: "list-row-chevron" %>
  <% end %>

  <%= link_to review_path, class: "list-row" do %>
    <span class="list-row-icon"><%= render "shared/icon", name: :review, size: 24 %></span>
    <span class="min-w-0 flex-1">
      <span class="list-row-title"><%= t("review.title") %></span>
      <span class="list-row-sub">
        <%= @review_count.positive? ? t("practice_page.review_sub", count: @review_count) : t("review.empty_wrong") %>
      </span>
    </span>
    <%= render "shared/icon", name: :chevron, size: 20, class: "list-row-chevron" %>
  <% end %>

  <% @entries.each do |entry| %>
    <% round = entry.next_round %>
    <%= button_to competition_practice_path(entry.slug), class: "list-row w-full text-left", form_class: "contents" do %>
      <span class="list-row-icon"><%= render "shared/icon", name: :trophy, size: 24 %></span>
      <span class="min-w-0 flex-1">
        <span class="list-row-title"><%= t("practice_page.competition", name: entry.short.presence || entry.name.to_s, when: days_until(round)) %></span>
        <span class="list-row-sub"><%= t("practice_page.competition_sub") %></span>
      </span>
      <%= render "shared/icon", name: :chevron, size: 20, class: "list-row-chevron" %>
    <% end %>
  <% end %>

  <%# Once a child has some practice behind them, duels are offered here — a
      row, not yet a tab: „Двубой" joins the menu when they play
      (FeatureVisibility). %>
  <% if visibility.state(:duel) == :presented %>
    <%= link_to challenges_path, class: "list-row" do %>
      <span class="list-row-icon"><%= render "shared/icon", name: :duel, size: 24 %></span>
      <span class="min-w-0 flex-1">
        <span class="list-row-title"><%= t("nav.duel") %></span>
        <span class="list-row-sub"><%= t("practice_page.duel_sub") %></span>
      </span>
      <%= render "shared/icon", name: :chevron, size: 20, class: "list-row-chevron" %>
    <% end %>
  <% end %>

  <%= link_to competitions_path, class: "list-row is-quiet" do %>
    <span class="list-row-icon"><%= render "shared/icon", name: :trophy, size: 22 %></span>
    <span class="min-w-0 flex-1">
      <span class="list-row-title"><%= t("practice_page.competitions_all") %></span>
    </span>
    <%= render "shared/icon", name: :chevron, size: 20, class: "list-row-chevron" %>
  <% end %>
</div>

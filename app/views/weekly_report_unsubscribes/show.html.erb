<div class="flex min-h-full flex-col justify-center py-12 px-6">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="text-center text-2xl/9 font-bold tracking-tight text-gray-900"><%= t("weekly_report.title") %></h2>
  </div>

  <div class="mt-5 sm:mx-auto sm:w-full sm:max-w-[480px]">
    <div class="bg-white px-6 py-10 shadow sm:rounded-lg sm:px-12">
      <% if @user.weekly_report? %>
        <p class="mb-6 text-sm text-gray-700"><%= t("weekly_report.confirm", email: @user.email) %></p>
        <%= button_to t("weekly_report.stop"), weekly_report_unsubscribe_path(@token), class: "button button-primary button-large" %>
      <% else %>
        <p class="text-sm text-gray-700"><%= t("weekly_report.off", email: @user.email) %></p>
      <% end %>
      <p class="mt-6 text-xs text-muted"><%= t("weekly_report.settings_hint") %></p>
    </div>
  </div>
</div>

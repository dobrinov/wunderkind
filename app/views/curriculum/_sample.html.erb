<%# One worked problem on a public page: the question, its answer, and the
    explanation that goes with it.

    Answer and explanation are on the page rather than behind a sign-up: the
    answer in sight, the explanation one tap under it (a <details>, so it is
    in the HTML). "с отговори" is the commonest thing a parent adds to the
    query, and a page that makes them sign up to see whether 9 + 3 is 12 has
    answered nobody's search. It is also the only honest demonstration of
    the thing being sold: every problem in the bank carries a worked
    explanation. %>
<li class="landing-quiet">
  <div class="practice-meta mb-3">
    <% if (topic = sample.topics.first) %>
      <%= link_to topic.name, curriculum_topic_path(topic.slug), class: "topic-pill hover:underline" %>
    <% end %>
    <span class="level-label"><%= t("practice.level_label", name: RatingBand.new(sample.elo).name) %></span>
  </div>

  <% if sample.image %>
    <div class="mb-4 flex justify-center overflow-hidden rounded-xl">
      <%= image_tag sample.image.file, alt: "", loading: "lazy" %>
    </div>
  <% end %>

  <%= question_body(sample) %>

  <%# The options look like the app's answer buttons, so they behave like them:
      a tap marks the pick right or wrong (sample_choice_controller) and offers
      more. They used to be inert <li>s that visitors tapped to no effect. %>
  <% if sample.multiple_choice? && sample.possible_answers.any? %>
    <div data-controller="sample-choice">
      <ul class="mt-3.5 flex flex-wrap gap-2">
        <% sample.possible_answers.each do |option| %>
          <li>
            <button type="button" class="choice-button min-h-11 px-3.5 py-2 text-[15px]" aria-pressed="false"
                    data-sample-choice-target="option" data-action="sample-choice#pick"
                    data-correct="<%= option.correct? %>" data-trace="sample-choice"><%= math_value(option.value) %></button>
          </li>
        <% end %>
      </ul>
      <p class="mt-3" hidden data-sample-choice-target="more">
        <% if current_user %>
          <%= link_to "#{t("curriculum.sample_more_signed_in")} →", home_path_for(current_user), class: "link-cta" %>
        <% else %>
          <%= link_to "#{t("curriculum.sample_more")} →", sign_up_path(competition: local_assigns[:event]&.slug), class: "link-cta" %>
        <% end %>
      </p>
    </div>
  <% end %>

  <p class="mt-4 text-[14.5px] font-extrabold text-green-700">
    <%= t("curriculum.answer_label") %>
    <span class="font-black"><%= math_value(curriculum_answer(sample)) %></span>
  </p>

  <%# The solution is folded to one line, and in the HTML: the answer is
      what „с отговори" asks for and stays in sight; six worked solutions in
      a row made a page nobody read to the end. %>
  <% if sample.explanation.present? %>
    <details class="sample-fold">
      <summary><%= t("curriculum.solution") %></summary>
      <p class="pb-3 whitespace-pre-line text-[14px] font-semibold leading-relaxed text-ink-600">
        <%= math_text(sample.explanation) %>
      </p>
    </details>
  <% end %>
</li>

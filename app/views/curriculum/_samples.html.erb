<%# The worked-problem block, shared by the grade and topic pages. %>
<section class="landing-section scroll-mt-20" id="zadachi">
  <div class="mb-6 max-w-[60ch]">
    <h2 class="landing-h2"><%= heading %></h2>
    <% if local_assigns[:blurb].present? %><p class="landing-body mt-3"><%= blurb %></p><% end %>
  </div>

  <% if samples.any? %>
    <ol class="grid grid-cols-1 gap-4 lg:grid-cols-2"><%= render partial: "curriculum/sample", collection: samples, as: :sample, locals: { event: local_assigns[:event] } %></ol>
  <% else %>
    <p class="landing-body"><%= t("curriculum.no_samples") %></p>
  <% end %>
</section>

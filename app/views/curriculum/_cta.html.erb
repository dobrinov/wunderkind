<%# The same closing band on every public content page. A parent who read a
    worked explanation and liked it is the one worth asking. %>
<section class="landing-section">
  <div class="landing-cta-band">
    <h2 class="landing-h2 mb-3 text-primary-900"><%= t("curriculum.cta.title", minutes: DailyPractice::DEFAULT_MINUTES) %></h2>
    <p class="landing-body mx-auto mb-6 max-w-[52ch] text-primary-800">
      <%= t("curriculum.cta.body", minutes: DailyPractice::DEFAULT_MINUTES) %>
    </p>
    <div class="flex flex-wrap justify-center gap-3 max-sm:flex-col">
      <%= link_to sign_up_path, class: "button button-primary button-hero" do %>
        <%= t("landing.sign_up") %> →
      <% end %>
      <%= link_to t("curriculum.cta.secondary"), root_path,
                  class: "button button-hero border border-primary-200 bg-white text-primary-900 hover:bg-primary-25" %>
    </div>
  </div>
</section>

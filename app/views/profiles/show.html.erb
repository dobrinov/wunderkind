<%# Reordered: who you are, what you have won, and only then the account forms.
    The parent-linking code used to be the first and widest card on a child's
    own profile — a one-time setup step outranking their level, XP and streak —
    so it moved into Настройки as a row. %>
<% coin_awards = @user.badge_awards.order(created_at: :desc, rung: :desc).to_a %>

<%# Capped rather than full-bleed, like /review and the parent's child page.
    A four-rung ladder floating in 1280px reads as a page that failed to load
    the rest of itself. %>
<%# One screen on a phone: who you are with your level and streak in one card,
    the next step, the weak spots, and the collection and the charts each one
    row that opens. The page used to be four phone screens — two charts and
    fourteen rows of mostly empty coin slots before anything below them. %>
<div class="flex w-full max-w-5xl flex-col gap-4" data-trace-mask>
  <section class="flex flex-col gap-4 rounded-[20px] bg-white p-5 ring-1 ring-ink-200">
    <div class="flex items-center gap-4">
      <div class="avatar size-14 shrink-0 text-2xl"><%= @user.name.first %></div>
      <div class="min-w-0 flex-1">
        <div class="truncate text-xl font-black tracking-[-.02em]"><%= @user.name %></div>
        <% if @user.nickname.present? %><div class="truncate text-sm font-bold text-muted"><%= @user.nickname %></div><% end %>
      </div>
    </div>
    <%# Level and streak, once each, side by side. %>
    <div class="grid grid-cols-2 gap-2.5">
      <div class="rounded-[14px] bg-primary-50 px-3.5 py-3">
        <div class="text-lg font-black text-primary-800"><%= t("profile.level_n", level: @user.level) %></div>
        <span class="mt-1.5 block h-2 overflow-hidden rounded-full bg-white">
          <span class="block h-full rounded-full bg-primary-500" style="width: <%= (Levels.progress(@user.total_xp) * 100).round %>%"></span>
        </span>
        <div class="mt-1.5 text-caption font-bold text-primary-900/70"><%= t("profile.xp_to_next", count: Levels.threshold_for(@user.level + 1) - @user.total_xp) %></div>
      </div>
      <div class="rounded-[14px] bg-reward-50 px-3.5 py-3">
        <div class="flex items-center gap-1.5 text-lg font-black text-reward-800"><%= render "shared/icon", name: :flame, size: 20 %><%= t("profile.streak_days", count: @user.live_streak) %></div>
        <div class="mt-1.5 text-caption font-bold text-reward-900/70"><%= t("profile.longest_streak") %>: <%= t("profile.streak_days", count: @user.longest_streak) %></div>
      </div>
    </div>
  </section>

  <%= render "shared/progress_card", progress: StudentProgress.new(@user, @trend) if @trend %>

  <%# „Слаби места": the topics furthest behind, each one press from a session
      of ten (TopicPractice). Only once there are some — a new student has
      not played enough of anything to have a weak spot. %>
  <% if @weakest.present? %>
    <section class="card" aria-labelledby="weak-spots">
      <header class="flex items-center justify-between gap-3">
        <h2 id="weak-spots" class="text-ui font-black"><%= t("topic_practice.weak_title") %></h2>
        <%= link_to t("topic_practice.all_title"), topic_practices_path, class: "link-cta" %>
      </header>
      <section class="flex flex-col gap-2">
        <% @weakest.each do |entry| %>
          <%= button_to topic_practice_path(entry.topic), class: "list-row w-full text-left", form_class: "contents" do %>
            <span class="list-row-icon"><%= render "shared/icon", name: :target, size: 22 %></span>
            <span class="min-w-0 flex-1">
              <span class="list-row-title"><%= entry.topic.name %></span>
              <span class="list-row-sub"><%= t("topic_practice.practise_ten") %></span>
            </span>
            <%= render "shared/icon", name: :chevron, size: 20, class: "list-row-chevron" %>
          <% end %>
        <% end %>
      </section>
    </section>
  <% end %>

  <%# „Колекция": folded to one row with the newest coins and the count; opens
      in place. %>
  <% standings = Coins.standings(@user) %>
  <details class="fold" id="collection">
    <summary class="list-row">
      <span class="flex shrink-0 -space-x-2">
        <% recent = coin_awards.first(3).filter_map { |award| (track = Coins.find(award.badge_key)) && [ track, award.rung ] } %>
        <% if recent.any? %>
          <% recent.each do |track, rung| %>
            <%= render "shared/coin", symbol: track.symbol, material: track.material(rung), size: 32, label: coin_label(track, rung) %>
          <% end %>
        <% else %>
          <span class="list-row-icon"><%= render "shared/icon", name: :star, size: 22 %></span>
        <% end %>
      </span>
      <span class="min-w-0 flex-1">
        <span class="list-row-title"><%= t("coins.title") %></span>
        <span class="list-row-sub"><%= t("coins.count", earned: standings.sum(&:rungs_earned), total: standings.sum { |standing| standing.track.rungs }) %></span>
      </span>
      <%= render "shared/icon", name: :chevron_down, size: 20, class: "list-row-chevron fold-chevron" %>
    </summary>
    <div class="mt-3"><%= render "coins", standings: standings, awards: coin_awards %></div>
  </details>

  <%# How they are doing: the difficulty they can get right, then the answers
      by day (each day links to its misses). Folded; open when the page was
      reached by changing its range or by its anchor. %>
  <% if @trend %>
    <details class="fold" id="progress" <%= "open" if params[:days].present? || params[:stats].present? %>>
      <summary class="list-row">
        <span class="list-row-icon"><%= render "shared/icon", name: :chart, size: 22 %></span>
        <span class="min-w-0 flex-1">
          <span class="list-row-title"><%= t("profile.stats_title") %></span>
          <span class="list-row-sub"><%= t("profile.stats_sub", count: @stats.total_solved, days: @stats.days.size) %></span>
        </span>
        <%= render "shared/icon", name: :chevron_down, size: 20, class: "list-row-chevron fold-chevron" %>
      </summary>
      <div class="mt-3 flex flex-col gap-5">
        <%= render "home/trend", trend: @trend, labelled: false %>
        <div id="stats" class="scroll-mt-20">
          <%= render "shared/answer_stats", stats: @stats, always: true,
                     goal_minutes: @user.daily_minutes_target.presence || DailyPractice::DEFAULT_MINUTES,
                     range_path: ->(days) { profile_path(days: days, anchor: "stats") },
                     review_path: review_path,
                     day_path: ->(date) { stats_day_path(date: date.iso8601) } %>
        </div>
      </div>
    </details>
  <% end %>

  <%# „Още в Wunderkind": everything that is there to be found but has not
      been pushed forward yet (FeatureVisibility). Quiet rows at the foot of the
      page — a curious child finds duels on day one; a child who never looks
      is not asked to. Gone once each feature has a place of its own. %>
  <% more = [
       ([ :duel, challenges_path, t("profile.more.duel"), t("profile.more.duel_sub") ] unless visibility.prominent?(:duel)),
       ([ :family, friends_path, t("profile.more.friends"), t("profile.more.friends_sub") ] unless visibility.prominent?(:friends)),
       ([ :trophy, competitions_path, t("profile.more.competitions"), t("profile.more.competitions_sub") ] unless visibility.prominent?(:competitions)),
       [ :practice, new_suggestion_path, t("nav.suggestions"), t("profile.more.suggest_sub") ],
       # Only while there is something current on it: a child who never
       # reported anything, or has archived everything they did, has no use
       # for the row. A new reply unarchives its report, so it brings the row
       # back with it.
       ([ :flag, reports_path, t("my_reports.title"),
          unseen_report_replies_count.positive? ? t("my_reports.unseen", count: unseen_report_replies_count) : t("my_reports.row_sub") ] if current_user.question_reports.unarchived.exists?)
     ].compact %>
  <% if @user == current_user && current_user.student? %>
    <section aria-labelledby="more-title" class="mt-4 flex flex-col gap-1">
      <h2 id="more-title" class="mb-1 px-1 text-meta font-black uppercase tracking-[.08em] text-ink-500"><%= t("profile.more.title") %></h2>
      <% more.each do |icon, path, title, sub| %>
        <%= link_to path, class: "list-row is-quiet" do %>
          <span class="list-row-icon"><%= render "shared/icon", name: icon, size: 22 %></span>
          <span class="min-w-0 flex-1">
            <span class="list-row-title"><%= title %></span>
            <span class="list-row-sub"><%= sub %></span>
          </span>
          <%= render "shared/icon", name: :chevron, size: 20, class: "list-row-chevron" %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>

<%# Reordered: who you are, what you have won, and only then the account forms.
    The parent-linking code used to be the first and widest card on a child's
    own profile — a one-time setup step outranking their level, XP and streak —
    so it moved into Настройки as a row. %>
<% stats = Badges.stats_for(@user) %>
<% awarded = @user.badge_awards.pluck(:badge_key) %>

<%# Capped rather than full-bleed, like /review and the parent's child page.
    A four-rung ladder floating in 1280px reads as a page that failed to load
    the rest of itself. %>
<div class="mx-auto flex max-w-5xl flex-col gap-5" data-trace-mask>
  <div class="flex flex-col items-center gap-5 rounded-[18px] bg-white p-6 ring-1 ring-ink-200 sm:flex-row sm:items-center">
    <div class="avatar size-[72px] shrink-0 text-3xl"><%= @user.name.first %></div>

    <div class="min-w-0 flex-1 text-center sm:text-left">
      <div class="text-2xl font-black tracking-[-.02em]"><%= @user.name %></div>
      <div class="text-sm font-bold text-muted">
        <%= @user.nickname %>
      </div>
      <%# The three most recently earned, at a glance — the collection's own
          headline, before the ladders underneath. %>
      <% recent = @user.badge_awards.order(created_at: :desc).limit(3).filter_map { |award| Badges.find(award.badge_key) } %>
      <% if recent.any? %>
        <div class="mt-3 flex items-center justify-center gap-2.5 sm:justify-start">
          <% recent.each do |badge| %>
            <%= render "shared/medal", badge: badge, earned: true, size: :xs %>
          <% end %>
          <% if awarded.size > recent.size %>
            <span class="text-[13px] font-bold text-ink-500">
              <%= t("badges_page.and_more", count: awarded.size - recent.size) %>
            </span>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>

  <%# Level and streak, once each. The header card used to give the level, the
      XP and the streak as three tiles beside an XP bar that said the same
      thing, while the home page drew all three again in four more cards. %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="rounded-[20px] bg-white p-5 ring-1 ring-ink-150">
      <div class="flex items-baseline justify-between gap-3">
        <span class="text-[22px] font-black text-primary-700"><%= t("profile.level_n", level: @user.level) %></span>
        <span class="text-[13px] font-extrabold text-muted"><%= @user.total_xp %> XP</span>
      </div>
      <span class="mt-3 block h-2.5 overflow-hidden rounded-full bg-ink-100">
        <span class="block h-full rounded-full bg-primary-500" style="width: <%= (Levels.progress(@user.total_xp) * 100).round %>%"></span>
      </span>
      <p class="mt-2 text-[13.5px] font-bold text-muted">
        <%= t("profile.xp_to_next", count: Levels.threshold_for(@user.level + 1) - @user.total_xp) %>
      </p>
    </div>

    <div class="rounded-[20px] bg-white p-5 ring-1 ring-ink-150">
      <div class="flex items-center gap-2 text-[22px] font-black text-reward-700">
        <%= render "shared/icon", name: :flame, size: 24 %>
        <%= t("profile.streak_days", count: @user.live_streak) %>
      </div>
      <p class="mt-2 text-[13.5px] font-bold text-muted">
        <%= t("profile.longest_streak") %>: <%= t("profile.streak_days", count: @user.longest_streak) %>
        · <%= t("profile.freezes") %>: <%= @user.streak_freezes %>
      </p>
    </div>
  </div>

  <%= render "shared/progress_card", progress: StudentProgress.new(@user, @trend) if @trend %>

  <%# How they are doing, moved from the home page: the difficulty they can
      get right, then the answers by day (each day links to its misses). %>
  <% if @trend %>
    <div id="progress" class="flex scroll-mt-20 flex-col gap-5">
      <%= render "home/trend", trend: @trend, labelled: false %>
      <div id="stats" class="scroll-mt-20">
        <%= render "shared/answer_stats", stats: @stats, always: true,
                   goal_minutes: @user.daily_minutes_target.presence || DailyPractice::DEFAULT_MINUTES,
                   range_path: ->(days) { profile_path(days: days, anchor: "stats") },
                   review_path: review_path,
                   day_path: ->(date) { stats_day_path(date: date.iso8601) } %>
      </div>
    </div>
  <% end %>

  <%# Full width, and not beside a rail: a ladder per family needs the room.
      The account forms that used to sit under it are on /settings now. %>
  <div data-controller="medal">
    <%= render "badge_collection", stats: stats, awarded: awarded %>
  </div>
</div>

<%# This week's place on every board the student is on — see
    LeaderboardSummary. The boards themselves are under the duel's „Класация"
    tab; this card is how a child finds out they are worth opening. %>
<div class="rounded-[14px] bg-white p-5 ring-1 ring-ink-200" data-trace-mask>
  <div class="mb-3 flex items-center gap-2">
    <span class="text-[13px] font-black text-ink-900">🏆 <%= t("home.leaderboards.title") %></span>
    <span class="ml-auto text-xs font-bold text-muted"><%= t("home.leaderboards.week") %></span>
  </div>

  <ul class="flex flex-col">
    <% summary.rows.each do |row| %>
      <li class="border-t border-ink-100 first:border-t-0">
        <%= link_to (row.league ? league_path(row.league) : leaderboard_path),
                    class: "flex items-center gap-3 py-2.5 hover:text-primary-700" do %>
          <span class="min-w-0 flex-1 truncate text-[14px] font-black">
            <%= row.name || t("home.leaderboards.everyone") %>
          </span>
          <span class="shrink-0 text-[13px] font-extrabold <%= row.place ? "text-primary-700" : "text-muted" %>">
            <%= row.place ? t("home.leaderboards.place", place: row.place, of: row.of) : t("home.leaderboards.no_points") %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if summary.nickname_missing? %>
    <p class="mt-2 text-[13px] font-bold text-muted">
      <%= link_to t("home.leaderboards.set_nickname"), settings_path, class: "text-primary-700 hover:underline" %>
    </p>
  <% end %>

  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-ink-100 pt-3">
    <%= link_to t("home.leaderboards.open"), (summary.leagues? ? leagues_path : leaderboard_path),
                class: "link-cta" %>
    <% if !summary.leagues? && current_user.may_join_leagues? %>
      <%= link_to "+ #{t("home.leaderboards.start_league")}", new_league_path,
                  class: "link-cta" %>
    <% end %>
  </div>
</div>

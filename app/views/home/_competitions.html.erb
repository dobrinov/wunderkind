<%# The home page's word about competitions. A child who said „ще участвам"
    sees the nearest one counting down, with the button that prepares for it;
    a child who has not sees the next few dates, because nobody enters a
    competition they never heard was on. locals: joined, upcoming %>
<% if joined %>
  <% round = joined.next_round %>
  <div class="flex flex-col gap-3 rounded-[14px] bg-white p-4 ring-1 ring-gray-200">
    <div class="flex items-center gap-3.5">
      <%= render "competitions/date", round: round %>
      <div class="min-w-0 flex-1">
        <div class="text-[12.5px] font-extrabold text-muted"><%= t("home.competition_kicker") %></div>
        <div class="text-[15px] font-black"><%= t("home.competition_countdown", name: joined.name, when: days_until(round)) %></div>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= button_to t("competitions.practice", name: joined.short.presence || joined.name.to_s), competition_practice_path(joined.slug),
                    class: "button button-primary", form_class: "inline" %>
      <%= link_to t("home.competitions_all"), competitions_path, class: "px-2 text-[13.5px] font-extrabold text-primary-700 hover:underline" %>
    </div>
  </div>
<% elsif upcoming.any? %>
  <div class="flex flex-col gap-3 rounded-[14px] bg-white p-4 ring-1 ring-gray-200">
    <div class="flex items-center gap-3">
      <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-primary-50 text-xl" aria-hidden="true">🏆</span>
      <div class="min-w-0 flex-1">
        <div class="text-[12.5px] font-extrabold text-muted"><%= t("home.competitions_title") %></div>
        <div class="text-[15px] font-black"><%= t("home.competitions_sub") %></div>
      </div>
    </div>
    <ul class="flex flex-col divide-y divide-gray-100">
      <% upcoming.each do |event| %>
        <% round = event.next_round %>
        <li class="flex items-center gap-3 py-2">
          <span class="w-14 shrink-0 text-[12.5px] font-black tabular-nums text-primary-700"><%= l(round.date, format: :short) %></span>
          <span class="min-w-0 flex-1 truncate text-[14px] font-bold"><%= event.name %></span>
          <span class="shrink-0 text-[12px] font-bold text-muted"><%= event_grades(event) %></span>
        </li>
      <% end %>
    </ul>
    <%= link_to t("home.competitions_cta"), competitions_path, class: "button button-secondary self-start" %>
  </div>
<% end %>

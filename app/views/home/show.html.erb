<%# What do I do now, and what is waiting for me — nothing else. The hero is
    today (the session, the minutes, the streak's week); then what a grown-up
    asked for; then only what is actually waiting on the child — a friend's
    duel invitation, mistakes ready to practise, a competition they entered.
    It used to run to ten blocks with eight to eleven competing calls to
    action and a rail of level, progress, leaderboard and badge cards; level
    and streak now live in the header chip and on „Аз", the leaderboards under
    „Двубой", every way to practise under „Упражнения". A card that has
    nothing to say is not drawn, so a quiet day is a short page. %>
<% goal_total = current_user.daily_minutes_target.presence || DailyPractice::DEFAULT_MINUTES %>

<div class="mx-auto flex max-w-3xl flex-col gap-5">
  <div class="flex flex-wrap items-baseline gap-2.5">
    <h1 class="text-page font-black tracking-[-.02em]"><%= t("home.greeting", name: current_user.name) %></h1>
    <span class="text-sm font-semibold text-muted"><%= l Time.zone.today, format: :long %></span>
  </div>

  <div class="hero-band" data-tour="hero">
    <div class="flex min-w-0 flex-1 flex-col gap-5">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
        <div class="min-w-0 flex-1">
          <div class="hero-kicker">
            <%= @practised_today ? t("home.daily_done_kicker") : t("home.daily_kicker") %>
          </div>
          <div class="hero-title">
            <%= @practised_today ? t("home.daily_done_title") : t("home.daily_title") %>
          </div>
          <div class="hero-sub">
            <%= @practised_today ? t("home.daily_done_sub") : t("home.daily_sub") %>
          </div>
        </div>
        <%= button_to daily_assignment_path, class: "button button-white button-large shrink-0 sm:w-auto" do %>
          <%= @practised_today ? t("home.daily_again") : t("home.daily_start") %> →
        <% end %>
      </div>

      <div class="grid gap-4 border-t border-white/15 pt-4 sm:grid-cols-2">
        <div>
          <div class="mb-2 flex justify-between text-caption font-extrabold text-primary-200">
            <span><%= t("profile.daily_minutes_target") %></span>
            <span class="text-white"><%= goal_total %></span>
          </div>
          <div class="h-2.5 overflow-hidden rounded-full bg-white/20">
            <div class="h-full rounded-full bg-reward-400" style="width: <%= @minutes_progress %>%"></div>
          </div>
        </div>

        <div>
          <div class="mb-2 flex justify-between text-caption font-extrabold text-primary-200">
            <span><%= t("profile.streak") %></span>
            <span class="inline-flex items-center gap-1 text-reward-200"><%= render "shared/icon", name: :flame, size: 15 %><%= t("profile.streak_days", count: current_user.live_streak) %></span>
          </div>
          <div class="flex gap-1.5">
            <% @history.week.each do |day| %>
              <div class="flex-1 text-center">
                <div class="grid h-6 place-items-center rounded-md text-micro font-black
                            <%= day.active? ? 'bg-reward-400 text-reward-800' : (day.future? ? 'bg-white/5 text-primary-400' : 'bg-white/12 text-primary-300') %>">
                  <%= day.active? ? "✓" : "·" %>
                </div>
                <div class="mt-1 text-micro font-extrabold <%= day.today? ? 'text-white' : 'text-primary-300' %>">
                  <%= t("home.day_names")[day.date.cwday - 1] %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if @needs_placement %>
    <%= render "placement" %>
  <% end %>

  <%= render "focus", focus: @focus, finished: @finished_focus, celebrate: @celebrate %>

  <%= render "goals", standings: @standings, rewards: @rewards %>

  <%# The mistakes card is for when there is a real pile to clear
      (FeatureVisibility::REVIEW_CARD_AT); a mistake or two waits under
      „Упражнения" without asking for the home page. %>
  <% show_review = visibility.prominent?(:review) %>
  <% if @invite_host || show_review %>
    <div class="grid gap-4 <%= "sm:grid-cols-2" if @invite_host && show_review %>">
      <% if @invite_host %>
        <%= link_to challenges_path, class: "list-row" do %>
          <span class="list-row-icon"><%= render "shared/icon", name: :duel, size: 24 %></span>
          <span class="min-w-0 flex-1">
            <span class="list-row-sub"><%= t("home.duel_title") %></span>
            <span class="list-row-title"><%= t("duel.invited_you", name: opponent_name(@invite_host)) %></span>
          </span>
          <%= render "shared/icon", name: :chevron, size: 20, class: "list-row-chevron" %>
        <% end %>
      <% end %>
      <% if show_review %>
        <%= link_to review_path, class: "list-row" do %>
          <span class="list-row-icon"><%= render "shared/icon", name: :review, size: 24 %></span>
          <span class="min-w-0 flex-1">
            <span class="list-row-sub"><%= t("review.title") %></span>
            <span class="list-row-title"><%= t("home.review_waiting", count: @review_count) %></span>
          </span>
          <%= render "shared/icon", name: :chevron, size: 20, class: "list-row-chevron" %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @next_competition %>
    <%= render "competitions", joined: @next_competition, upcoming: [] %>
  <% end %>
</div>

<%# One thing at a time, and never over the release notes: the tour first, for
    a child who has just been placed; later, one „Ново за теб" sheet per visit. %>
<% unless impersonating? || unseen_changelog.any? %>
  <% if @show_tour %>
    <%= render "tour" %>
  <% elsif @introduction %>
    <%= render "introduction", feature: @introduction %>
  <% end %>
<% end %>

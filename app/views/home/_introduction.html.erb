<%# „Ново за теб" — one feature, once, when it becomes worth knowing about
    (FeatureVisibility#pending_introduction). A <dialog> opened with
    showModal, like the changelog's: Esc and the backdrop answer „по-късно"
    rather than closing silently, so the sheet does not come back on the next
    page. „Опитай" goes straight to the feature. locals: feature %>
<dialog class="intro-dialog"
        aria-labelledby="intro-title"
        data-controller="introduction"
        data-action="cancel->introduction#acknowledge click->introduction#backdrop">
  <%= form_with url: introduction_path(feature), method: :patch, class: "flex flex-col gap-5",
                data: { introduction_target: "form" } do %>
    <span class="intro-icon"><%= render "shared/icon", name: t("introductions.#{feature}.icon"), size: 40, stroke: 2 %></span>

    <div class="flex flex-col gap-2 text-center">
      <span class="text-meta font-black uppercase tracking-[.08em] text-primary-700"><%= t("introductions.kicker") %></span>
      <h2 id="intro-title" class="text-page font-black leading-tight tracking-[-.02em]"><%= t("introductions.#{feature}.title") %></h2>
      <p class="text-base font-semibold leading-relaxed text-ink-700"><%= t("introductions.#{feature}.body") %></p>
    </div>

    <% if feature.to_s == "duel" && current_user.nickname.blank? %>
      <div class="flex flex-col gap-1.5">
        <%= label_tag :nickname, t("introductions.duel.nickname"), class: "text-sm font-extrabold text-ink-700" %>
        <%= text_field_tag :nickname, nil, maxlength: 30, autocomplete: "off" %>
      </div>
    <% end %>

    <div class="flex flex-col gap-2">
      <%= button_tag t("introductions.#{feature}.cta"), name: "go", value: "1", class: "button button-primary button-large" %>
      <%= button_tag t("introductions.later"), class: "button button-quiet", formnovalidate: true %>
    </div>
  <% end %>
</dialog>

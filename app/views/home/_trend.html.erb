<%# The one chart on the page. It plots difficulty, not accuracy, because the
    dispatcher keeps accuracy flat on purpose — see PerformanceTrend. The
    gridlines are the rating bands. On the parent's page they carry the band
    names, so the axis reads in the same words as the band card beside it; on
    the child's own page they are bare lines (`labelled: false`), because the
    band names are not shown to children — see RatingBand. The raw Elo stays in
    the tooltip either way. %>
<% labelled = local_assigns.fetch(:labelled, true) %>
<% if trend.enough? %>
  <% plotted = trend.weeks.each_with_index.filter_map { |week, index|
       [ (trend.x_for(index) * 100).round(2), ((1 - trend.y_for(week.rating)) * 100).round(2), week ] if week.solved?
     } %>
  <% line = plotted.map { |x, y, _| "#{x},#{y}" }.join(" ") %>
  <%# Green climbing, grey holding, amber slipping — amber rather than red,
      because the line dips for reasons that are not the child getting worse
      (a new topic starts at its easy end), and an arrow besides the colour
      so it does not rest on colour alone. %>
  <% direction = trend.direction %>

  <div class="card">
    <header class="flex flex-wrap items-center gap-2.5">
      <span class="text-[15px] font-black"><%= t("home.trend") %></span>
      <span class="text-[13px] font-bold text-muted"><%= t("home.trend_sub") %></span>
      <span class="ml-auto whitespace-nowrap rounded-full px-2.5 py-1 text-[12px] font-black
                   <%= { up: 'bg-green-50 text-green-700', steady: 'bg-ink-100 text-ink-500', down: 'bg-amber-50 text-amber-700' }[direction] %>"
            title="<%= t("home.trend_direction_hint", count: PerformanceTrend::RECENT_POINTS) %>">
        <span aria-hidden="true"><%= { up: "↑", steady: "→", down: "↓" }[direction] %></span>
        <%= t("home.trend_direction.#{direction}") %>
      </span>
    </header>

    <section>
      <%# A 56px gutter for the band names, so a data point can never land on
          top of one — the labels used to be chips laid over the plot itself.
          No names, no gutter. %>
      <% gutter = labelled ? "ml-14" : "" %>
      <div class="relative h-40">
        <% trend.band_lines.each do |threshold, name| %>
          <div class="pointer-events-none absolute inset-x-0" style="bottom: <%= (trend.y_for(threshold) * 100).round(2) %>%">
            <div class="<%= gutter %> border-t border-ink-200"></div>
            <% if labelled %>
              <span class="absolute left-0 top-0 -translate-y-1/2 text-[10.5px] font-extrabold text-ink-400">
                <%= name %>
              </span>
            <% end %>
          </div>
        <% end %>

        <div class="absolute inset-y-0 <%= labelled ? "left-14" : "left-0" %> right-0">
          <svg class="size-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <polygon points="<%= plotted.first[0] %>,100 <%= line %> <%= plotted.last[0] %>,100"
                     fill="var(--color-primary-500)" fill-opacity="0.1" />
            <polyline points="<%= line %>" fill="none" stroke="var(--color-primary-600)" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          </svg>

          <% plotted.each_with_index do |(x, y, week), index| %>
            <% tip = t("home.trend_point",
                       week: l(week.starts_on, format: :short),
                       rating: week.rating,
                       answers: week.answers,
                       accuracy: week.accuracy) %>
            <span class="chart-point <%= 'chart-tip-start' if x < 20 %> <%= 'chart-tip-end' if x > 80 %>"
                  style="left: <%= x %>%; bottom: <%= (100 - y).round(2) %>%"
                  tabindex="0" aria-label="<%= tip %>">
              <span class="rounded-full bg-primary-600 ring-2 ring-white
                           <%= index == plotted.size - 1 ? 'size-3.5' : 'size-2.5' %>"></span>
              <span class="chart-tip"><%= tip %></span>
            </span>
          <% end %>
        </div>
      </div>

      <div class="mt-3 flex items-baseline justify-between <%= "pl-14" if labelled %> text-[11.5px] font-extrabold text-ink-400">
        <span><%= t("home.trend_start", count: trend.weeks.size - 1) %></span>
        <span class="text-primary-700"><%= t("home.trend_now") %></span>
      </div>
    </section>
  </div>
<% end %>

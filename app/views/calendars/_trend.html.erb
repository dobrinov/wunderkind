<%# The one chart on the page. It plots difficulty, not accuracy, because the
    dispatcher keeps accuracy flat on purpose — see PerformanceTrend. The
    gridlines are the rating bands, so the axis reads in the same words as the
    band card in the rail and the raw Elo stays in the tooltip, where the
    grown-ups who do read it can still find it. %>
<% if trend.enough? %>
  <% plotted = trend.weeks.each_with_index.filter_map { |week, index|
       [ (trend.x_for(index) * 100).round(2), ((1 - trend.y_for(week.rating)) * 100).round(2), week ] if week.solved?
     } %>
  <% line = plotted.map { |x, y, _| "#{x},#{y}" }.join(" ") %>
  <% delta = trend.delta %>

  <div class="card">
    <header class="flex flex-wrap items-center gap-2.5">
      <span class="text-[15px] font-black"><%= t("home.trend") %></span>
      <span class="text-[13px] font-bold text-muted"><%= t("home.trend_sub") %></span>
      <span class="ml-auto whitespace-nowrap rounded-full px-2.5 py-1 text-[12px] font-black
                   <%= delta.positive? ? 'bg-primary-50 text-primary-700' : 'bg-gray-100 text-gray-500' %>">
        <%= t("home.trend_delta", delta: "#{delta.positive? ? '+' : ''}#{delta}") %>
      </span>
    </header>

    <section>
      <%# A 56px gutter for the band names, so a data point can never land on
          top of one — the labels used to be chips laid over the plot itself. %>
      <div class="relative h-40">
        <% trend.band_lines.each do |threshold, name| %>
          <div class="pointer-events-none absolute inset-x-0" style="bottom: <%= (trend.y_for(threshold) * 100).round(2) %>%">
            <div class="ml-14 border-t border-gray-200"></div>
            <span class="absolute left-0 top-0 -translate-y-1/2 text-[10.5px] font-extrabold text-gray-400">
              <%= name %>
            </span>
          </div>
        <% end %>

        <div class="absolute inset-y-0 left-14 right-0">
          <svg class="size-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <polygon points="<%= plotted.first[0] %>,100 <%= line %> <%= plotted.last[0] %>,100"
                     fill="var(--color-primary-500)" fill-opacity="0.1" />
            <polyline points="<%= line %>" fill="none" stroke="var(--color-primary-600)" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          </svg>

          <% plotted.each_with_index do |(x, y, week), index| %>
            <span class="absolute -translate-x-1/2 translate-y-1/2 rounded-full bg-primary-600 ring-2 ring-white
                         <%= index == plotted.size - 1 ? 'size-3.5' : 'size-2.5' %>"
                  style="left: <%= x %>%; bottom: <%= (100 - y).round(2) %>%"
                  title="<%= t("home.trend_point",
                               week: l(week.starts_on, format: :short),
                               rating: week.rating,
                               answers: week.answers,
                               accuracy: week.accuracy) %>"></span>
          <% end %>
        </div>
      </div>

      <div class="mt-3 flex items-baseline justify-between pl-14 text-[11.5px] font-extrabold text-gray-400">
        <span><%= t("home.trend_start", count: trend.weeks.size - 1) %></span>
        <span class="text-primary-700"><%= t("home.trend_now") %></span>
      </div>
    </section>
  </div>
<% end %>

<%# min-h-full, not h-full: the calendar grid is built from aspect-square cells,
    so on a wide window it is intrinsically taller than the viewport. With a fixed
    height the flex children had to shrink to fit, and because .card is
    overflow-hidden (which gives it an automatic min-height of 0) the homework
    card absorbed all of it and collapsed to zero. min-h-full still lets
    .calendar's flex-grow fill a short page, but lets the page scroll instead. %>
<div class="flex flex-col gap-4 min-h-full">
  <% if @pending_homework.any? %>
    <div class="card">
      <header class="flex items-center gap-2">
        <strong>📌 <%= t("homework.title") %></strong>
      </header>
      <section class="space-y-2">
        <% @pending_homework.each do |assignment| %>
          <% answered = assignment.assignment_questions.count { |aq| aq.user_answer.present? } %>
          <div class="flex items-center gap-3 flex-wrap">
            <div class="flex-1 min-w-40">
              <div class="font-semibold"><%= assignment.homework.title %></div>
              <div class="text-sm <%= assignment.homework.overdue? ? 'text-red-600 font-semibold' : 'text-gray-500' %>">
                <%= t("homework.due", date: l(assignment.homework.due_at, format: :short)) %>
                · <%= t("homework.progress", done: answered, total: assignment.assignment_questions.size) %>
              </div>
            </div>
            <%= link_to answered.zero? ? t("homework.start") : t("homework.continue"),
                        question_path(assignment.next_assignment_question, close_path: calendar_path),
                        class: "button button-primary" %>
          </div>
        <% end %>
      </section>
    </div>
  <% end %>

  <div class="flex gap-3 flex-wrap justify-center sm:justify-start">
    <div class="stat-tile stat-reward">
      <div class="stat-value">🔥 <%= current_user.current_streak %></div>
      <div class="stat-label"><%= t("profile.streak") %></div>
    </div>
    <div class="stat-tile stat-reward">
      <div class="stat-value">⭐ <%= current_user.total_xp %></div>
      <div class="stat-label"><%= t("profile.xp") %></div>
    </div>
    <div class="stat-tile stat-primary">
      <div class="stat-value"><%= current_user.level %></div>
      <div class="stat-label"><%= t("profile.level") %></div>
    </div>
    <div class="stat-tile">
      <div class="stat-value"><%= current_user.elo %></div>
      <div class="stat-label"><%= t("profile.rating") %></div>
    </div>
    <%= button_to daily_assignment_path, class: "stat-tile stat-primary cursor-pointer hover:bg-primary-50 transition-colors" do %>
      <div class="stat-value">⏱️</div>
      <div class="stat-label"><%= t("daily.start") %></div>
    <% end %>
  </div>

  <div class="calendar">
    <div class="days-of-week">
      <% t("calendar.day_names").each_with_index do |day, index| %>
        <div><%= day %></div>
      <% end %>
    </div>

    <div class="days-of-month">
      <% @calendar.each do |date| %>
        <% if date.today? && date.completed? %>
          <%= link_to daily_assignments_calendar_path(date: date), class: "day today-completed" do %>
            <%= date.day %>
            <div><%= render 'shared/svg/checkmark' %></div>
          <% end %>
        <% elsif date.today? && date.assignments? %>
          <%= link_to daily_assignments_calendar_path(date: date), class: "day today-incompleted" do %>
            <%= date.day %>
            <div><%= render 'shared/svg/academic_hat' %></div>
          <% end %>
        <% elsif date.today? %>
          <%= button_to assignments_path, class: "day today" do %>
            <%= date.day %>
            <div><%= render 'shared/svg/academic_hat' %></div>
          <% end %>
        <% elsif date.past? && date.completed? %>
          <%= link_to daily_assignments_calendar_path(date: date), class: "day past-completed" do %>
            <%= date.day %>
            <div><%= render 'shared/svg/checkmark' %></div>
          <% end %>
        <% elsif date.past? && date.after_user_creation? %>
          <div class="day past-incompleted">
            <%= date.day %>
            <div><%= render 'shared/svg/cross' %></div>
          </div>
        <% elsif date.past? && date.assignments? %>
          <%= link_to daily_assignments_calendar_path(date: date), class: "day past-incompleted" do %>
            <%= date.day %>
            <div><%= render 'shared/svg/cross' %></div>
          <% end %>
        <% elsif date.past? %>
          <div class="day past"><%= date.day %></div>
        <% elsif date.future? %>
          <div class="day future"><%= date.day %></div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

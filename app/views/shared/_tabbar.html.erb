<%# Phone navigation for a student, because phone is where a lot of the practice
    actually happens: the same four places as the header's menu, from the same
    items (ApplicationHelper#nav_items), at 44px each. Everything else is
    behind the avatar. %>
<nav class="tabbar" aria-label="<%= t("nav.main") %>" data-tour="nav-tabbar">
  <% items.each do |item| %>
    <% label = capture do %>
      <%= render "shared/icon", name: item[:icon], size: 24, class: "tabbar-icon" %>
      <span><%= item[:name] %></span>
      <% if item[:count].to_i.positive? %>
        <span class="nav-count tabbar-count"><%= item[:count] %></span>
      <% end %>
    <% end %>
    <% if item[:post] %>
      <%= button_to item[:path], class: item[:active] ? "active" : "" do %><%= label %><% end %>
    <% else %>
      <%= link_to item[:path], class: item[:active] ? "active" : "", "aria-current": (item[:active] ? "page" : nil) do %><%= label %><% end %>
    <% end %>
  <% end %>
</nav>

<%# "РЕЙТИНГ 1114" is a raw Elo number: nobody outside the app knows whether it
    is good, or what would move it. The band name leads, the distance to the
    next band says what progress looks like, and the number itself drops to a
    secondary line.

    For grown-ups only — the parent's page, the landing page and the design
    system. A child sees StudentProgress instead: one scale for all of school
    tells a strong young child they are average. The grade line is what a
    parent needs to read the band, and what the band cannot say to a child
    without knowing their age. %>
<div class="rounded-[14px] bg-white p-5 ring-1 ring-ink-200">
  <div class="flex items-baseline gap-2">
    <span class="text-meta font-extrabold text-ink-700"><%= t("rating_band.title") %></span>
  </div>
  <div class="mb-0.5 mt-1.5 text-title font-black tracking-[-.02em]"><%= band.name %></div>
  <div class="mb-1 text-meta font-extrabold text-primary-700"><%= band.grades_label %></div>
  <div class="mb-3.5 text-meta font-bold text-muted">
    <% if band.top? %>
      <%= t("rating_band.top") %>
    <% else %>
      <%= t("rating_band.to_next", count: band.points_to_next, name: band.next_band.name) %>
    <% end %>
  </div>

  <%# The bar and the names are the same five segments, laid out from the same
      numbers — see RatingBand.segments for what went wrong when they weren't. %>
  <% segments = RatingBand.segments %>

  <div class="rating-scale mb-1.5">
    <% segments.each do |segment| %>
      <span class="rating-segment <%= "is-current" if segment.key == band.key %>"
            style="width: <%= (segment.width * 100).round(2) %>%"></span>
    <% end %>
    <div class="rating-marker" style="left: <%= (band.position * 100).round(2) %>%"></div>
  </div>

  <div class="flex">
    <% segments.each do |segment| %>
      <%# 10px and tight: „Състезател" has to fit a fifth of a 336px rail, and a
          band name that truncates is a band name nobody can read. %>
      <span class="truncate text-center text-micro font-extrabold tracking-[-.01em] <%= segment.key == band.key ? "text-primary-700" : "text-ink-400" %>"
            style="width: <%= (segment.width * 100).round(2) %>%">
        <%= segment.name %>
      </span>
    <% end %>
  </div>

  <div class="mt-3.5 flex flex-wrap items-center gap-2 border-t border-ink-100 pt-3.5">
    <span class="whitespace-nowrap rounded-full bg-ink-100 px-2 py-0.5 text-xs font-black text-ink-600">
      <%= t("rating_band.raw", value: band.rating) %>
    </span>
    <span class="text-caption font-bold text-muted"><%= t("rating_band.hint") %></span>
  </div>
</div>

<%# Answers per day, as one stacked bar: right, wrong and „не съм го учил".
    One card rather than a chart of shares above a chart of counts — the
    height is how much was done and the split is how it went, so both are read
    off the same bar and cannot be read against different days. The shares are
    exact in the hover label, and for the whole range in the legend. Drawn
    like the time-spent card beside it on the home page: same bars, same foot.

    Clicking a day with something wrong or skipped in it opens that day's
    list, via `day_path` (a lambda taking a date, or nil where there is no list
    to open). `range_path` takes a number of days and keeps whatever else the
    page's URL needs; without it the range picker is left out.

    The card waits until two days carry answers, the same "one point is not a
    trend" stance the other charts take — unless `always` is set, which a page
    passes once the reader has picked a range, so that picking an empty one
    does not take the picker away with the card. %>
<% day_path = local_assigns[:day_path] %>
<% range_path = local_assigns[:range_path] %>
<% days = stats.days %>
<% if stats.enough? || local_assigns[:always] %>
  <% edge = ->(index) { index < days.size * 0.2 ? "chart-tip-start" : ("chart-tip-end" if index > days.size * 0.8) } %>
  <% percent = ->(value) { number_with_precision(value, precision: 1, strip_insignificant_zeros: true) } %>
  <% tip = ->(day) {
       next t("stats.point_empty", date: l(day.date, format: :short)) unless day.any?

       t("stats.point", date: l(day.date, format: :short), solved: day.solved,
                        wrong: percent.(day.wrong_rate), skipped: percent.(day.skipped_rate))
     } %>
  <%# Headroom above the busiest day, as on the time chart. %>
  <% scale = [ days.map(&:total).max.to_i, 1 ].max * 1.15 %>
  <% height = ->(count) { (count / scale * 100).round(2) } %>
  <%# Only a day with something on its list is worth a click: a day of nothing
      but right answers would open an empty page. %>
  <% column = ->(day, index, &block) {
       href = day_path.(day.date) if day_path && (day.wrong + day.skipped).positive?
       options = { class: "chart-col group flex flex-col justify-end #{edge.(index)}", aria: { label: tip.(day) } }
       href ? link_to(href, **options, &block) : tag.span(**options, tabindex: 0, &block)
     } %>

  <div class="card">
    <header class="flex flex-wrap items-center gap-2.5">
      <span class="text-[15px] font-black"><%= t("stats.title") %></span>
      <span class="text-[13px] font-bold text-muted"><%= t("stats.subtitle") %></span>
      <% if range_path %>
        <nav class="ml-auto flex gap-0.5 rounded-full bg-gray-100 p-0.5">
          <% AnswerStats::RANGES.each do |range| %>
            <%= link_to t("stats.range", count: range), range_path.(range),
                        class: "whitespace-nowrap rounded-full px-2.5 py-1 text-[12px] font-black #{days.size == range ? 'bg-white text-primary-700 shadow-xs' : 'text-gray-500 hover:text-gray-700'}" %>
          <% end %>
        </nav>
      <% end %>
    </header>

    <section>
      <% if stats.enough? %>
        <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[12px] font-black">
          <span class="flex items-center gap-1.5 text-primary-700">
            <span class="size-2.5 rounded-[3px] bg-primary-500"></span><%= t("stats.solved_total", count: stats.total_solved) %>
          </span>
          <span class="flex items-center gap-1.5 text-red-600">
            <span class="size-2.5 rounded-[3px] bg-red-400"></span><%= t("stats.wrong", rate: percent.(stats.wrong_rate)) %>
          </span>
          <span class="flex items-center gap-1.5 text-amber-700">
            <span class="size-2.5 rounded-[3px] bg-amber-400"></span><%= t("stats.skipped", rate: percent.(stats.skipped_rate)) %>
          </span>
          <% if day_path %>
            <span class="ml-auto font-bold text-gray-400"><%= t("stats.click_hint") %></span>
          <% end %>
        </div>

        <div class="relative h-36">
          <div class="absolute inset-0 flex items-end gap-px border-b border-gray-200">
            <% days.each_with_index do |day, index| %>
              <%= column.(day, index) do %>
                <%# Top to bottom: skipped, wrong, right — so the right answers
                    stand on the axis and the bar reads up from what went well. %>
                <% if day.any? %>
                  <span class="block w-full rounded-t-[2px] bg-amber-400 group-hover:bg-amber-500" style="height: <%= height.(day.skipped) %>%"></span>
                  <span class="block w-full bg-red-400 group-hover:bg-red-500 <%= 'rounded-t-[2px]' if day.skipped.zero? %>" style="height: <%= height.(day.wrong) %>%"></span>
                  <span class="block w-full bg-primary-500 group-hover:bg-primary-700 <%= 'rounded-t-[2px]' if (day.skipped + day.wrong).zero? %>" style="height: <%= height.(day.solved - day.wrong) %>%"></span>
                <% end %>
                <span class="chart-tip"><%= tip.(day) %></span>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="mt-3 flex items-baseline justify-between text-[11.5px] font-extrabold text-gray-400">
          <span><%= l days.first.date, format: :short %></span>
          <span class="text-primary-700"><%= t("home.time_today") %></span>
        </div>
      <% else %>
        <div class="card-quiet text-center text-sm font-bold text-muted"><%= t("stats.empty") %></div>
      <% end %>
    </section>
  </div>
<% end %>

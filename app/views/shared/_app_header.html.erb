<%# The one header, shared by the `application` and `admin` layouts so that an
    admin who is also a parent moves between „Семейство" and „Администрация"
    without the chrome changing under them (it used to be two different
    headers). For everybody else it is what it always was. %>
<% workspace = admin_workspace %>
<% switch = current_user && workspace_switch? %>
<% items = nav_items %>
<header class="sticky top-0 z-30 border-b border-ink-200 bg-white px-4">
  <%# One width for an admin on both sides of the switch: it used to be the
      family side's 80rem and the admin side's 96rem, so pressing the switch
      moved the switch itself out from under the pointer. %>
  <div class="mx-auto flex min-h-16 <%= workspace ? "max-w-[96rem]" : "max-w-7xl" %> items-center gap-3 sm:gap-5">
    <%= logo %>

    <% if switch %>
      <%= render "shared/workspace_switch", class: "#{"is-compact" if workspace == :admin} max-sm:hidden" %>
    <% end %>

    <%= render "shared/main_nav", items: items, hidden_below: (workspace == :admin ? "xl" : "sm") %>

    <% if current_user %>
      <div class="ml-auto flex items-center gap-2 sm:gap-3">
        <%= render "shared/child_switcher", children: switchable_children, wide: workspace == :admin %>
        <% if current_user.student? %>
          <%= render "shared/player_stats", user: current_user %>
        <% end %>
        <%= render "shared/account_menu", items: items %>
      </div>
    <% end %>
  </div>

  <%# Below the header row where it has no room: the switch on a phone, and the
      admin menu as a row of chips until `xl`. %>
  <% if workspace && (switch || workspace == :admin) %>
    <div class="-mx-4 flex flex-col gap-2 border-t border-ink-100 px-4 py-2 <%= workspace == :admin ? "xl:hidden" : "sm:hidden" %>">
      <% if switch %><%= render "shared/workspace_switch", class: "sm:hidden" %><% end %>
      <% if workspace == :admin %>
        <nav class="admin-subnav" aria-label="<%= t("nav.administration") %>">
          <% items.each do |item| %>
            <%= link_to item[:path], class: "admin-subnav-link #{"is-active" if item[:active]}", "aria-current": (item[:active] ? "page" : nil) do %>
              <span><%= item[:name] %></span>
              <% if item[:count].to_i.positive? %><span class="nav-count"><%= item[:count] %></span><% end %>
            <% end %>
          <% end %>
        </nav>
      <% end %>
    </div>
  <% end %>
</header>

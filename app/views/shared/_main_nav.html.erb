<%# The header's half of the one menu — the tab bar is the other half, from
    the same items (ApplicationHelper#nav_items). Hidden on a phone: a student
    has the tab bar there, and anybody else's one or two places are in the
    account menu. %>
<% if items.any? %>
  <nav class="main-nav <%= local_assigns.fetch(:hidden_below, "sm") == "xl" ? "max-xl:hidden is-admin" : "max-sm:hidden" %>" aria-label="<%= t("nav.main") %>" data-tour="nav-header">
    <% items.each do |item| %>
      <% classes = "main-nav-link #{"is-active" if item[:active]}" %>
      <% label = capture do %>
        <%= render "shared/icon", name: item[:icon], size: 20, class: "main-nav-icon" %>
        <span><%= item[:name] %></span>
        <% if item[:count].to_i.positive? %>
          <span class="nav-count"><%= item[:count] %></span>
        <% end %>
      <% end %>
      <% if item[:post] %>
        <%= button_to item[:path], class: classes, form_class: "contents" do %><%= label %><% end %>
      <% else %>
        <%= link_to item[:path], class: classes, "aria-current": (item[:active] ? "page" : nil) do %><%= label %><% end %>
      <% end %>
    <% end %>
  </nav>
<% end %>

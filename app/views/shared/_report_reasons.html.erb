<%# The body of every report form: what is wrong, optionally in the student's own
    words. Shared so the practice flow and a duel ask the same question in the
    same words — only the way the problem is identified differs. %>
<p class="report-lede"><%= t("reports.lede") %></p>

<div class="report-reasons">
  <% QuestionReport.reasons.each_key do |reason| %>
    <label class="report-reason">
      <%= radio_button_tag :reason, reason, false, required: true %>
      <span><%= t("reports.reasons.#{reason}") %></span>
    </label>
  <% end %>
</div>

<%= text_area_tag :note, nil, rows: 2, maxlength: QuestionReport::NOTE_LIMIT,
                  class: "mt-3", placeholder: t("reports.note_placeholder") %>

<div class="mt-3 flex flex-wrap items-center gap-3">
  <%= submit_tag t("reports.submit"), name: nil, class: "button button-primary" %>
  <span class="text-xs text-muted"><%= local_assigns[:hint] || t("reports.note_hint") %></span>
</div>

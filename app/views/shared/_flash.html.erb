<% if flash[:notice].present? || flash[:alert].present? %>
  <div aria-live="assertive" class="pointer-events-none fixed inset-0 z-50 flex items-end px-4 py-6 sm:items-start sm:p-6">
    <div class="flex w-full flex-col items-center space-y-4 sm:items-end">
      <% { notice: flash[:notice], alert: flash[:alert] }.compact.each do |kind, message| %>
        <div data-controller="flash" class="pointer-events-auto w-full max-w-sm rounded-xl bg-white shadow-lg ring-1 ring-black/5">
          <div class="flex items-start gap-3 p-4">
            <% if kind == :notice %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 shrink-0 text-green-500" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            <% else %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 shrink-0 text-red-500" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12v-.008ZM21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            <% end %>
            <p class="flex-1 pt-0.5 text-sm font-medium text-gray-900"><%= message %></p>
            <button type="button" data-action="flash#dismiss" class="rounded-md text-gray-400 hover:text-gray-500 cursor-pointer">
              <span class="sr-only"><%= t("nav.open_menu") %></span>
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
              </svg>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

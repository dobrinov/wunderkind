<%# The child's card about their own level, in the rail where the band card used
    to be. It compares the student with nobody but themselves — see
    StudentProgress, and RatingBand for why the band left this screen. %>
<% gain = progress.gain %>
<div class="rounded-[14px] bg-white p-5 ring-1 ring-gray-200">
  <div class="text-[13px] font-extrabold text-gray-700"><%= t("progress_card.title") %></div>

  <% if gain %>
    <% points, weeks = gain %>
    <div class="mb-0.5 mt-1.5 flex items-baseline gap-1.5">
      <span class="text-[26px] font-black tracking-[-.02em] text-green-700">+<%= points %></span>
      <span class="text-[13px] font-extrabold text-green-700"><%= t("progress_card.points") %></span>
    </div>
    <div class="text-[13px] font-bold text-muted"><%= t("progress_card.gain", count: weeks) %></div>
  <% else %>
    <div class="mb-0.5 mt-1.5 text-[22px] font-black tracking-[-.02em]"><%= t("progress_card.keep_going_title") %></div>
    <div class="text-[13px] font-bold text-muted"><%= t("progress_card.#{progress.mood}") %></div>
  <% end %>

  <div class="mt-4 flex items-baseline justify-between text-[12.5px] font-extrabold">
    <span class="text-gray-700"><%= t("progress_card.next_step") %></span>
    <span class="text-primary-700"><%= t("progress_card.to_next_step", count: progress.to_next_step) %></span>
  </div>
  <div class="mt-1.5 h-2.5 overflow-hidden rounded-full bg-primary-100"
       role="progressbar" aria-valuemin="0" aria-valuemax="100"
       aria-valuenow="<%= (progress.step_fraction * 100).round %>">
    <div class="h-full rounded-full bg-primary-600" style="width: <%= (progress.step_fraction * 100).round(1) %>%"></div>
  </div>

  <div class="mt-3.5 border-t border-gray-100 pt-3.5 text-[12.5px] font-bold text-muted">
    <%= t("rating_band.hint") %>
  </div>
</div>

<%# Everything that is not a place you go to practise: settings, suggesting a
    problem, the changelog and signing out, behind the avatar on every width.
    They used to be a row of grey text links in the header (and a hamburger on
    a phone), which put „Изход" at the same weight as the duel. On a phone it
    also carries what the header has no room for — a parent's menu items and
    the child switcher — since only a student has a tab bar. %>
<div class="relative" data-trace-mask data-controller="menu" data-action="keydown@document->menu#keydown">
  <button type="button" class="account-button" data-menu-target="button" data-action="menu#toggle"
          aria-controls="account-menu" aria-expanded="false">
    <span class="avatar size-9 shrink-0 text-sm" aria-hidden="true"><%= current_user.name.first %></span>
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
    <span class="sr-only"><%= t("nav.open_menu") %></span>
  </button>

  <div id="account-menu" class="account-menu hidden" data-menu-target="panel">
    <div class="account-menu-head">
      <div class="truncate text-ui font-black"><%= current_user.name %></div>
      <div class="truncate text-xs font-bold text-muted"><%= current_user.nickname.presence || current_user.email %></div>
      <% if admin_workspace %>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <% if current_user.children.exists? %>
            <span class="rounded-full bg-reward-100 px-2 py-0.5 text-micro font-black text-reward-800"><%= t("nav.parent_of", count: current_user.children.count) %></span>
          <% end %>
          <span class="rounded-full bg-primary-50 px-2 py-0.5 text-micro font-black text-primary-700"><%= t("nav.admin_role") %></span>
        </div>
      <% end %>
    </div>

    <% unless current_user.student? || admin_workspace %>
      <div class="sm:hidden">
        <% items.each do |item| %>
          <%= link_to item[:path], class: "account-menu-item" do %>
            <%= render "shared/icon", name: item[:icon], size: 20 %><%= item[:name] %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% children = switchable_children %>
    <% if children.any? %>
      <div class="md:hidden">
        <div class="account-menu-label"><%= t("nav.who_practises") %></div>
        <% children.each do |child| %>
          <%= button_to switch_child_path(child), class: "account-menu-item", form_class: "block" do %>
            <span class="avatar size-6 shrink-0 text-micro" aria-hidden="true"><%= child.name.first %></span><%= child.name %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# An admin who is also a parent chooses which of their two places the
        app opens on (ApplicationController#admin_home_path). Three buttons,
        not a radio group, so it needs no script and says what it saved. %>
    <% if workspace_switch? %>
      <div class="account-menu-label"><%= t("admin_landing.title") %></div>
      <% User.admin_landings.each_key do |landing| %>
        <% chosen = current_user.admin_landing == landing %>
        <%= button_to admin_landing_path, method: :patch, params: { admin_landing: landing },
                      class: "account-menu-item #{"is-chosen" if chosen}", form_class: "block",
                      "aria-pressed": chosen do %>
          <span class="account-menu-radio" aria-hidden="true"></span><%= t("admin_landing.options.#{landing}") %>
        <% end %>
      <% end %>
      <div class="account-menu-divider"></div>
    <% end %>

    <%= link_to settings_path, class: "account-menu-item" do %>
      <%= render "shared/icon", name: :settings, size: 20 %><%= t("nav.settings") %>
    <% end %>
    <%= link_to suggestions_path, class: "account-menu-item" do %>
      <%= render "shared/icon", name: :idea, size: 20 %><%= t("nav.suggestions") %>
    <% end %>
    <%= link_to changelog_path, class: "account-menu-item" do %>
      <%= render "shared/icon", name: :sparkles, size: 20 %><%= t("changelog.page_title") %>
    <% end %>
    <% if admin_workspace %>
      <%= link_to design_system_path, class: "account-menu-item" do %>
        <%= render "shared/icon", name: :palette, size: 20 %><%= t("overseer.nav.design_system") %>
      <% end %>
    <% end %>
    <div class="account-menu-divider"></div>
    <%= button_to sign_out_path, method: :delete, class: "account-menu-item", form_class: "block" do %>
      <%= render "shared/icon", name: :sign_out, size: 20 %><%= t("nav.sign_out") %>
    <% end %>
  </div>
</div>

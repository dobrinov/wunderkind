<%# One switch per optional email this person can be sent (EmailPreferences),
    then the account emails, which have no switch. Shared by Настройки
    (scope "user", posting to the profile) and the page linked from every
    email (scope "emails"). %>
<% kinds = EmailPreferences.for(user) %>
<% if kinds.any? %>
  <ul class="flex flex-col gap-4">
    <% kinds.each do |kind| %>
      <li class="flex items-start gap-3">
        <div class="group relative mt-0.5 inline-flex w-11 shrink-0 rounded-full bg-ink-200 p-0.5 inset-ring inset-ring-ink-900/5 outline-offset-2 outline-primary-600 transition-colors duration-200 ease-in-out has-checked:bg-primary-600 has-focus-visible:outline-2">
          <span class="size-5 rounded-full bg-white shadow-xs ring-1 ring-ink-900/5 transition-transform duration-200 ease-in-out group-has-checked:translate-x-5"></span>
          <%= hidden_field_tag "#{scope}[#{kind.key}]", "0", id: nil %>
          <%= check_box_tag "#{scope}[#{kind.key}]", "1", user.public_send(kind.key),
                            id: "#{scope}_#{kind.key}", class: "absolute inset-0 appearance-none focus:outline-hidden" %>
        </div>
        <label for="<%= "#{scope}_#{kind.key}" %>" class="text-sm">
          <span class="block font-medium text-ink-900"><%= t("email_preferences.kinds.#{kind.key}.title") %></span>
          <span class="block text-muted"><%= t("email_preferences.kinds.#{kind.key}.body") %></span>
        </label>
      </li>
    <% end %>
  </ul>
<% end %>
<div class="mt-4 rounded-md bg-ink-50 px-4 py-3 text-sm text-ink-700">
  <p class="font-medium text-ink-900"><%= t("email_preferences.always.title") %></p>
  <p class="mt-1 text-muted"><%= t("email_preferences.always.body") %></p>
</div>

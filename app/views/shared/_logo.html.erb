<%# The wordmark goes home, but it is no longer the only way there: the menu
    has a „Начало" item for a student, the same as the phone's tab bar, so the
    two read alike — see ApplicationHelper#nav_items. %>
<% home = "text-xl font-bold text-gray-700 hover:text-gray-900" %>

<% if current_user&.admin? %>
  <div class="flex items-center gap-2">
    <%= link_to t("app_name"), root_path, class: home %>
    <%= link_to t("nav.administration"), overseer_root_path, class: "text-xs font-semibold text-primary-600 hover:text-primary-800 rounded-md bg-primary-50 px-2 py-1" %>
  </div>
<% else %>
  <%= link_to t("app_name"), root_path, class: home %>
<% end %>

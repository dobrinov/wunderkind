<%# One coin (CoinsHelper for the palettes and symbols). An earned coin is its
    material; an empty slot is the same coin in greys with a dashed rim; the
    next slot (`progress` between 0 and 1) gets a ring that fills towards it.
    locals: symbol, material ("empty" for a slot), size (px), label (nil:
    decorative), progress %>
<% palette = CoinsHelper::PALETTES.fetch(material) %>
<% paths = CoinsHelper::SYMBOLS.fetch(symbol) %>
<% empty = material == "empty" %>
<% clip = coin_clip_id %>
<% progress = local_assigns[:progress].to_f %>
<% ring = empty && progress.positive? %>
<span class="coin <%= "is-empty" if empty %>" style="--coin-size: <%= size %>px;<%= " --coin-progress: #{(progress * 360).round}deg;" if ring %>" <% if ring %>data-progress<% end %>>
  <svg viewBox="0 0 100 100" width="<%= size %>" height="<%= size %>" <% if local_assigns[:label] %>role="img" aria-label="<%= label %>"<% else %>aria-hidden="true"<% end %>>
    <defs><clipPath id="<%= clip %>"><circle cx="50" cy="50" r="37"/></clipPath></defs>
    <circle cx="50" cy="52" r="47" fill="<%= palette[:edge] %>"/>
    <circle cx="50" cy="50" r="47" fill="<%= palette[:rim] %>"<% if empty %> stroke="#c5c5d6" stroke-width="3" stroke-dasharray="6 5"<% end %>/>
    <% unless empty %><path d="M74 10 A47 47 0 0 1 90 26 L80 34 A37 37 0 0 0 68 20 Z" fill="#ffffff" opacity=".28"/><% end %>
    <circle cx="50" cy="50" r="38.5" fill="<%= palette[:edge] %>"/>
    <g clip-path="url(#<%= clip %>)">
      <rect x="0" y="0" width="100" height="100" fill="<%= palette[:face] %>"/>
      <circle cx="64" cy="66" r="42" fill="<%= palette[:face_dark] %>"/>
      <% unless empty %><circle cx="50" cy="54" r="38" fill="none" stroke="<%= palette[:shadow] %>" stroke-width="7" opacity=".35"/><% end %>
    </g>
    <% unless empty %>
      <g transform="translate(28 28) scale(1.84)" fill="none" stroke="<%= palette[:shadow] %>" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><% paths.each do |d| %><path d="<%= d %>"/><% end %></g>
    <% end %>
    <g transform="translate(28 25) scale(1.84)" fill="none" stroke="<%= palette[:icon] %>" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><% paths.each do |d| %><path d="<%= d %>"/><% end %></g>
    <% unless empty %><path d="M20 44 Q23 26 40 17" fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round" opacity=".55"/><% end %>
  </svg>
</span>

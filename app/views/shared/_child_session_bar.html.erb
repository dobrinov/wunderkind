<%# The parent is signed in, the child is the one working. This strip is the only
    seam between the two identities — it names whose profile is open, switches
    straight to a sibling's, and is the only way back to the parent's own
    account. %>
<% siblings = other_child_profiles %>
<div class="border-b border-primary-100 bg-primary-50">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-3 gap-y-1.5 px-4 py-2">
    <span class="truncate text-[13px] font-bold text-primary-700">
      <%= t("child_session.acting_as", name: current_user.name) %>
    </span>

    <% if siblings.any? %>
      <span class="text-[13px] font-bold text-primary-600/70"><%= t("child_session.switch_to") %></span>
      <div class="flex flex-wrap items-center gap-1.5">
        <% siblings.each do |sibling| %>
          <%= button_to sibling.name, switch_child_path(sibling),
                form_class: "inline-flex",
                class: "min-h-9 cursor-pointer rounded-full bg-white px-3 py-1 text-[13px] font-extrabold text-primary-700 ring-1 ring-primary-200 hover:bg-primary-25",
                aria: { label: t("child_session.switch_to_name", name: sibling.name) } %>
        <% end %>
      </div>
    <% end %>

    <%= button_to t("child_session.switch_back"), switch_back_path, method: :delete,
          form_class: "ml-auto shrink-0",
          class: "cursor-pointer text-[13px] font-extrabold text-primary-700 underline" %>
  </div>
</div>

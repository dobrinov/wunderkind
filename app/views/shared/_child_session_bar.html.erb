<%# The parent is signed in, the child is the one working. This strip is the only
    seam between the two identities — it names whose profile is open, switches
    straight to a sibling's, and is the only way back to the parent's own
    account. %>
<% siblings = other_child_profiles %>
<div class="border-b border-primary-100 bg-primary-50" data-trace-mask>
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-3 gap-y-1.5 px-4 py-2">
    <span class="truncate text-meta font-bold text-primary-700">
      <%= t("child_session.acting_as", name: current_user.name) %>
    </span>

    <% if siblings.any? %>
      <span class="text-meta font-bold text-primary-600/70"><%= t("child_session.switch_to") %></span>
      <div class="flex flex-wrap items-center gap-1.5">
        <% siblings.each do |sibling| %>
          <%= button_to sibling.name, switch_child_path(sibling),
                form_class: "inline-flex",
                class: "min-h-11 cursor-pointer rounded-full bg-white px-3.5 text-sm font-extrabold text-primary-700 ring-1 ring-primary-200 hover:bg-primary-25",
                aria: { label: t("child_session.switch_to_name", name: sibling.name) } %>
        <% end %>
      </div>
    <% end %>

    <%# An admin who is also a parent goes back to either of their two places
        — „Администрация" to the very page they handed the device over from. %>
    <% if signed_in_user.admin? %>
      <div class="ml-auto flex shrink-0 flex-wrap items-center gap-1.5">
        <span class="text-meta font-bold text-primary-600/70"><%= t("child_session.back_to") %></span>
        <%= button_to t("nav.children"), switch_back_path, method: :delete, form_class: "inline-flex",
              class: "button button-secondary" %>
        <%= button_to t("nav.administration"), switch_back_path(to: "admin"), method: :delete, form_class: "inline-flex",
              class: "button button-secondary" %>
      </div>
    <% else %>
      <%= button_to t("child_session.switch_back"), switch_back_path, method: :delete,
            form_class: "ml-auto shrink-0",
            class: "button button-secondary" %>
    <% end %>
  </div>
</div>

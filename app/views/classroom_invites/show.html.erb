<div class="flex min-h-full flex-col justify-center px-6 py-12">
  <div class="mx-auto w-full max-w-md">
    <div class="card">
      <section class="text-center">
        <div class="text-sm font-extrabold text-muted"><%= t("classroom_invites.title") %></div>
        <h1 class="mt-1 text-2xl font-black"><%= @classroom.name %></h1>
        <p class="mt-1 text-sm text-muted"><%= t("classroom_invites.teacher", name: @classroom.teacher.name) %></p>

        <div class="mt-6">
          <% if current_user.nil? %>
            <p class="mb-4 text-sm"><%= t("classroom_invites.sign_in_prompt") %></p>
            <div class="flex flex-col gap-2">
              <%= link_to t("classroom_invites.sign_up"), sign_up_path(invite: @classroom.invite_code), class: "button button-primary button-large" %>
              <%= link_to t("classroom_invites.sign_in"), sign_in_path(invite: @classroom.invite_code), class: "button button-secondary" %>
            </div>
          <% elsif @member %>
            <p class="mb-4 text-sm"><%= t("classroom_invites.already_member") %></p>
            <%= link_to t("classroom_invites.open_classrooms"), classrooms_path, class: "button button-secondary" %>
          <% elsif current_user.student? %>
            <%= button_to t("classroom_invites.join"), classroom_invite_path(@classroom.invite_code),
                          class: "button button-primary button-large w-full" %>
          <% else %>
            <%# A parent or teacher is signed in. Only a student joins a class —
                and a parent who manages the child's profile can become one by
                switching into it, so say that rather than just refusing. %>
            <p class="text-sm"><%= t("classroom_invites.students_only") %></p>
            <p class="mt-2 text-sm text-muted"><%= t("classroom_invites.switch_child_hint") %></p>
          <% end %>
        </div>
      </section>
    </div>
  </div>
</div>

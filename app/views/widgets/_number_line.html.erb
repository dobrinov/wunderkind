<div
  data-controller="widget-number-line"
  data-widget-number-line-min-value="<%= widget_params.fetch('min', 0) %>"
  data-widget-number-line-max-value="<%= widget_params.fetch('max', 10) %>"
  data-widget-number-line-step-value="<%= widget_params.fetch('step', 1) %>"
  class="flex w-full flex-col items-center gap-2"
>
  <p class="text-[12.5px] font-bold text-muted"><%= t("widgets.number_line_hint") %></p>
  <div data-slot="canvas" class="flex w-full justify-center text-gray-700"></div>
  <div class="min-h-8 text-2xl font-black text-primary-700" data-widget-number-line-target="readout"></div>
  <input type="hidden" name="state" data-widget-number-line-target="hidden" required>
</div>

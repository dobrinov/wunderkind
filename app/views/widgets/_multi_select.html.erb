<%# Options are shuffled here so their order in the seed file cannot hint at the
    answer. %>
<div
  data-controller="widget-multi-select"
  data-widget-multi-select-options-value="<%= Array(widget_params['options']).shuffle.to_json %>"
  class="mx-auto flex w-full max-w-md flex-col gap-2.5"
>
  <p class="text-[12.5px] font-bold text-muted"><%= t("widgets.multi_select_hint") %></p>
  <div data-widget-multi-select-target="list" class="grid grid-cols-1 gap-2 sm:grid-cols-2"></div>
  <input type="hidden" name="state" data-widget-multi-select-target="hidden" required>
</div>

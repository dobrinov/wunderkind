<%# The phrases carry a literal %{angle} / %{number} for the controller to fill
    in. With `degrees` off ("отбележи 210°"), nothing on the page may name the
    selected angle — the readout, the button, the chips and the pegs' labels
    would all turn the question into tapping until it says 210. %>
<% degrees = widget_params.fetch("degrees", true) %>
<div
  data-controller="widget-unit-circle"
  data-widget-unit-circle-step-value="<%= widget_params.fetch('step', 15) %>"
  data-widget-unit-circle-values-value="<%= widget_params.fetch('values', false) %>"
  data-widget-unit-circle-degrees-value="<%= degrees %>"
  data-widget-unit-circle-labels-value="<%= {
    add: t("widgets.unit_circle_add", angle: "%{angle}"),
    add_hidden: t("widgets.unit_circle_add_hidden"),
    marker: t("widgets.unit_circle_marker", number: "%{number}"),
    remove_marker: t("widgets.unit_circle_remove_marker", number: "%{number}"),
    remove: t("widgets.unit_circle_remove", angle: "%{angle}"),
    point: t("widgets.unit_circle_point", angle: "%{angle}"),
    angle: t("widgets.unit_circle_angle")
  }.to_json %>"
  class="mx-auto flex w-full max-w-md flex-col items-center gap-3"
>
  <p class="text-[12.5px] font-bold text-muted"><%= t("widgets.unit_circle_hint") %></p>
  <div data-widget-unit-circle-target="canvas" class="w-full max-w-[340px]"></div>
  <div class="flex w-full flex-wrap items-center justify-center gap-2.5">
    <% if degrees %>
      <div class="rounded-[12px] bg-primary-50 px-3 py-1.5 text-center">
        <div class="text-[11px] font-black tracking-[.05em] text-primary-700 uppercase"><%= t("widgets.unit_circle_angle") %></div>
        <div class="min-w-[3ch] text-xl font-black text-primary-800" data-widget-unit-circle-target="readout">—</div>
      </div>
    <% end %>
    <% if widget_params.fetch("values", false) %>
      <div class="rounded-[12px] bg-orange-50 px-3 py-1.5 text-center">
        <div class="text-[11px] font-black tracking-[.05em] text-orange-800">SIN</div>
        <div class="min-w-[4ch] text-xl font-black text-orange-700" data-widget-unit-circle-target="sine">—</div>
      </div>
      <div class="rounded-[12px] bg-teal-50 px-3 py-1.5 text-center">
        <div class="text-[11px] font-black tracking-[.05em] text-teal-800">COS</div>
        <div class="min-w-[4ch] text-xl font-black text-teal-700" data-widget-unit-circle-target="cosine">—</div>
      </div>
    <% end %>
    <button type="button" data-widget-unit-circle-target="add" data-action="widget-unit-circle#add" disabled
            class="min-h-11 rounded-[14px] border-2 border-primary-300 bg-white px-4 text-base font-black text-primary-700 disabled:opacity-40"></button>
  </div>
  <div data-widget-unit-circle-target="chips" class="flex min-h-11 flex-wrap justify-center gap-2"></div>
  <input type="hidden" name="state" data-widget-unit-circle-target="hidden" required>
</div>

<div
  data-controller="widget-find-mistake"
  data-widget-find-mistake-lines-value="<%= Array(widget_params['lines']).to_json %>"
  data-widget-find-mistake-given-value="<%= t('widgets.find_mistake_given') %>"
  class="mx-auto flex w-full max-w-md flex-col gap-2.5"
>
  <p class="text-[12.5px] font-bold text-muted"><%= t("widgets.find_mistake_hint") %></p>
  <div data-widget-find-mistake-target="list" class="flex flex-col gap-2"></div>
  <input type="hidden" name="state" data-widget-find-mistake-target="hidden" required>
</div>

<div class="page">
  <header>
    <h1><%= @date.strftime("%d.%m.%Y") %></h1>
    <%= button_to t("assignments.new_practice"), assignments_path, class: "button button-primary" %>
  </header>

  <main>
    <% if @assignments.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("assignments.date") %></th>
            <th><%= t("assignments.time") %></th>
            <th><%= t("assignments.result") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @assignments.each do |assignment| %>
            <tr>
              <td><%= assignment.created_at.strftime("%d.%m.%Y %H:%M") %></td>
              <td>
                <% if assignment.completed_at? %>
                  <%= distance_in_time(assignment.created_at, assignment.completed_at) %>
                <% else %>
                  ⧗
                <% end %>
              </td>
              <td>
                <% if assignment.completed_at? %>
                  <% score = ((assignment.correct_answers.count * 1.00 / assignment.questions.count * 100).round) %>
                  <%= emoji_for_score(score) %> <%= score %>%
                <% else %>
                  ⧗
                <% end %>
              </td>
              <td class="actions">
                <% close_path = daily_assignments_calendar_path(date: assignment.created_at.to_date) %>
                <% if assignment.completed_at? %>
                  <%= link_to t("assignments.view_result"), assignment_path(assignment, close_path:), class: "text-primary-600 hover:text-primary-800" %>
                <% else %>
                  <%= link_to t("assignments.continue"),
                              question_path(assignment.next_assignment_question, close_path:, back_path: assignment_path(assignment, close_path:)),
                              class: "text-primary-600 hover:text-primary-800" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="alert-info">
        <div>
          <div>
            <p><%= t("assignments.empty_hint") %></p>
          </div>
        </div>
      </div>
    <% end %>
  </main>
</div>

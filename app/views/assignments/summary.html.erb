<div class="flex-grow mx-auto flex items-center justify-center flex-col">
  <div>
    <% percentage = @assignment.score_percentage %>
    <div class="text-center text-6xl mb-5">
      <%= percentage ? emoji_for_score(percentage) : "🤷" %>
    </div>
    <h2 class="text-center text-3xl font-extrabold text-gray-900">
      <%= percentage ? t("summary.score", percentage: percentage) : t("summary.all_skipped") %>
    </h2>
    <% if percentage %>
      <p class="mt-2 text-center text-sm text-gray-600">
        <%= t("summary.correct_of", correct: @assignment.correct_answers.count, total: @assignment.graded_questions_count) %>
      </p>
    <% end %>
    <% if @assignment.skipped_questions.count.positive? %>
      <p class="mt-1 text-center text-sm text-gray-500">
        🤷 <%= t("summary.skipped", count: @assignment.skipped_questions.count) %>
      </p>
    <% end %>
    <p class="mt-1 text-center text-sm text-gray-600">
      <%= t("summary.time", time: distance_in_time(@assignment.created_at, @assignment.completed_at)) %>
    </p>
    <% if flash[:xp_earned].present? %>
      <p class="mt-3 text-center">
        <span class="xp-pill text-base">⭐ <%= t("summary.xp_earned", count: flash[:xp_earned]) %></span>
      </p>
    <% end %>
    <% Array(flash[:new_badges]).filter_map { |key| Badges.find(key) }.each do |badge| %>
      <p class="mt-2 text-center text-sm font-semibold text-reward-600">
        <%= badge.icon %> <%= t("gamification.new_badge", name: badge.name) %>
      </p>
    <% end %>
    <% Array(flash[:mastered_topics]).each do |topic_name| %>
      <p class="mt-2 text-center text-sm font-semibold text-reward-600">
        <%= t("mastery.mastered", name: topic_name) %>
      </p>
    <% end %>
  </div>

  <div class="mt-8 w-full max-w-lg">
    <div class="space-y-6">
      <div class="text-center">
        <p class="text-lg text-gray-900"><%= percentage ? message_for_score(percentage) : t("summary.all_skipped_hint") %></p>
      </div>

      <%= render "answers", assignment: @assignment, expanded: false %>

      <div class="flex gap-3">
        <%= button_to t("summary.new_practice"), assignments_path, form_class: "flex-1", class: "button button-primary button-large" %>
        <%= link_to t("summary.back"), daily_assignments_calendar_path(date: @assignment.created_at.to_date), class: "button button-secondary button-large flex-1", autofocus: true %>
      </div>
    </div>
  </div>
</div>

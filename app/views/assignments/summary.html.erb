<%# The end of a session: how it went, what it paid, and where to go next.

    The score leads, then the two things amber is for — the XP this session
    earned and the streak, ticked for today — then a new badge struck at full
    size, the one moment in the app worth a medal that big. The full answer
    list follows, and under it at most two buttons: the mistakes just made, as
    a secondary, while there are any to practise, and one primary — back to
    „Днес", or another round for a competition session, since that child chose
    what to work on.

    The XP is read off the session (Assignment#xp_earned) and the streak off
    the user, so a summary reopened from the history next week says the same
    — except that the streak tile only shows on the day itself, being about
    today, and the badges come from the flash, being news. %>
<% close_path = internal_path(params[:close_path], daily_assignments_home_path(date: @assignment.created_at.to_date)) %>
<% percentage = @assignment.score_percentage %>
<% skipped = @assignment.skipped_questions.count %>
<% streak = current_user.live_streak if @assignment.completed_at.in_time_zone.to_date == Time.zone.today %>
<% earned = Array(flash[:new_badges]).filter_map { |key| Badges.find(key) } %>
<% event = @assignment.competition_event %>

<% content_for :bare, true %>

<div class="practice-shell">
  <%= render "shared/practice_header", assignment: @assignment, current: nil, close_path: close_path %>

  <div class="practice-column flex flex-col gap-4">
    <div class="animate-rise flex flex-col gap-1.5 px-1">
      <span class="text-meta font-black uppercase tracking-[.06em] text-primary-700">
        <%= event ? (event.short.presence || event.name.to_s) : t("summary.kicker") %>
      </span>
      <h1 class="text-[32px] font-black leading-[1.15] tracking-[-.02em] text-ink-900 max-sm:text-page">
        <%= percentage ? message_for_score(percentage) : t("summary.all_skipped") %>
      </h1>
      <p class="text-base font-semibold leading-normal text-ink-700">
        <% if percentage %>
          <%= distance_in_time(@assignment.created_at, @assignment.completed_at) %><% if skipped.positive? %> · <%= t("summary.skipped", count: skipped) %><% end %>
        <% else %>
          <%= t("summary.all_skipped_hint") %>
        <% end %>
      </p>
    </div>

    <div class="grid auto-cols-fr grid-flow-col gap-2">
      <% if percentage %>
        <div class="stat-tile">
          <span class="stat-value"><%= @assignment.correct_answers.count %>/<%= @assignment.graded_questions_count %></span>
          <span class="stat-label"><%= t("summary.correct_label") %></span>
        </div>
      <% end %>
      <% if @xp_earned.positive? %>
        <div class="stat-tile stat-reward">
          <span class="stat-value">+<%= @xp_earned %></span>
          <span class="stat-label"><%= t("summary.xp_label") %></span>
        </div>
      <% end %>
      <% if streak&.positive? %>
        <div class="stat-tile stat-reward">
          <span class="stat-value inline-flex items-center gap-1">
            <%= render "shared/icon", name: :flame, size: 20 %><%= streak %>
          </span>
          <span class="stat-label"><%= t("summary.streak_label", count: streak) %></span>
          <%# Today's day, ticked: the session that just ended is what kept it. %>
          <span class="absolute top-2.5 right-2.5 grid size-6 place-items-center rounded-full bg-reward-500 text-white">
            <%= render "shared/icon", name: :check, size: 14, stroke: 3.2, label: t("summary.streak_today") %>
          </span>
        </div>
      <% end %>
    </div>

    <% if earned.any? || Array(flash[:mastered_topics]).any? %>
      <section class="flex flex-col gap-3 rounded-[20px] bg-reward-50 p-4 ring-1 ring-reward-200">
        <% earned.each do |badge| %>
          <div class="flex items-center gap-3.5">
            <%= render "shared/medal", badge: badge, earned: true, is_new: true, size: :s %>
            <div class="min-w-0 flex-1">
              <div class="text-meta font-extrabold text-reward-800">
                <%= t("gamification.new_badge_kicker") %> · <%= t("badges.tiers.#{badge.tier}") %>
              </div>
              <div class="text-lead font-black text-reward-800"><%= badge.name %></div>
            </div>
          </div>
        <% end %>
        <% Array(flash[:mastered_topics]).each do |topic_name| %>
          <div class="text-ui font-black text-reward-800">🎓 <%= t("mastery.mastered", name: topic_name) %></div>
        <% end %>
      </section>
    <% end %>

    <div class="overflow-hidden rounded-[20px] bg-white ring-1 ring-ink-150">
      <%= render "answers", assignment: @assignment, expanded: false %>
    </div>

    <div class="flex flex-col gap-2.5">
      <% if @mistakes_count.positive? %>
        <%= button_to t("summary.practise_mistakes", count: @mistakes_count), practice_review_path,
                      params: { assignment_id: @assignment.id }, class: "button button-secondary button-large" %>
      <% end %>
      <% if @retried_report %>
        <%= link_to t("summary.back_to_report"), report_path(@retried_report), class: "button button-primary button-large" %>
        <%= link_to t("summary.home"), home_path, class: "button button-quiet button-large" %>
      <% elsif event %>
        <%= button_to t("competitions.practice_again", name: event.short.presence || event.name.to_s),
                      competition_practice_path(event.slug), class: "button button-primary button-large" %>
        <%= link_to t("summary.home"), home_path, class: "button button-quiet button-large" %>
      <% else %>
        <%= link_to t("summary.home"), home_path, class: "button button-primary button-large" %>
      <% end %>
    </div>
  </div>
</div>

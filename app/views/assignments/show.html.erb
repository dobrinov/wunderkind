<%# Looking back at a finished session, reached from the calendar. Deliberately
    quieter than the summary: the XP and the badges were celebrated once, when
    they were earned, and re-celebrating them every time a child opens their
    history would cheapen both. %>
<% percentage = @assignment.score_percentage %>

<div class="mx-auto w-full max-w-[660px]">
  <div class="card">
    <header class="flex items-center gap-4">
      <span class="text-3xl" aria-hidden="true"><%= percentage ? emoji_for_score(percentage) : "🤷" %></span>
      <div class="min-w-0 flex-1">
        <div class="text-lg font-black">
          <%= percentage ? t("summary.score", percentage: percentage) : t("summary.all_skipped") %>
        </div>
        <div class="text-sm font-bold text-muted">
          <% if percentage %>
            <%= t("summary.correct_of", correct: @assignment.correct_answers.count, total: @assignment.graded_questions_count) %>
          <% end %>
          <% if @assignment.completed_at? %>
            · <%= distance_in_time(@assignment.created_at, @assignment.completed_at) %>
          <% end %>
        </div>
      </div>
    </header>

    <%= render "answers", assignment: @assignment, expanded: true %>
  </div>
</div>

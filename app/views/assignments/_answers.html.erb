<%# One row per question in a finished session. Shared by the summary (just
    finished) and by the history view (looking back), so the row treatment is
    the same in both and only the surrounding page differs.

    Four outcomes, not two: right, wrong, skipped, and — for free text — waiting
    on a reviewer. A pending answer shown in red would be telling a child they
    got it wrong before anyone has read it. %>
<% close_path = daily_assignments_home_path(date: assignment.created_at.to_date) %>

<%# Folded only when the list is long enough to push the buttons under it off
    a phone screen; a ten-question session cut off after four and a half rows,
    with a tablet's worth of empty space below, read as a missing answer. %>
<% folded = !expanded && assignment.assignment_questions.size > 8 %>
<div class="<%= folded ? 'relative max-h-[30rem] overflow-hidden' : '' %>">
  <% assignment.assignment_questions.each do |assignment_question| %>
    <% answer = assignment_question.user_answer %>
    <% path =
         if answer.present?
           question_answer_path(assignment_question, close_path:, back_path: assignment_path(assignment, close_path:))
         else
           question_path(assignment_question, close_path:, back_path: assignment_path(assignment, close_path:))
         end %>
    <%= link_to path, class: "flex items-center gap-3 border-b border-ink-50 px-5 py-3 hover:bg-ink-50" do %>
      <% if answer.nil? %>
        <span class="grid size-7 shrink-0 place-items-center rounded-full bg-ink-100 text-xs font-black text-ink-500" aria-hidden="true">—</span>
      <% elsif answer.skipped? %>
        <span class="grid size-7 shrink-0 place-items-center rounded-full bg-ink-100 text-sm" aria-hidden="true">🤷</span>
      <% elsif answer.pending_review? %>
        <span class="grid size-7 shrink-0 place-items-center rounded-full bg-ink-100 text-sm" aria-hidden="true">⏳</span>
      <% elsif answer.correct? %>
        <span class="grid size-7 shrink-0 place-items-center rounded-full bg-green-100 text-sm font-black text-green-700" aria-hidden="true">✓</span>
      <% else %>
        <span class="grid size-7 shrink-0 place-items-center rounded-full bg-red-100 text-sm font-black text-red-700" aria-hidden="true">✗</span>
      <% end %>

      <div class="min-w-0 flex-1">
        <div class="line-clamp-2 text-sm font-extrabold text-ink-900">
          <%= assignment_question.question.body_text %>
        </div>
        <div class="truncate text-xs font-bold text-muted">
          <% if answer.nil? %>
            <%= t("assignments.continue") %>
          <% elsif answer.skipped? %>
            <%= t("answers.not_taught") %>
          <% elsif answer.pending_review? %>
            <%= t("free_text.pending") %>
          <% else %>
            <%= assignment_question.question.topics.first&.name %>
          <% end %>
        </div>
      </div>

      <% if answer.present? && !answer.skipped? %>
        <% wrong_style = fraction_value?(answer.value) ? "text-red-700" : "text-red-700 line-through decoration-red-700/45" %>
        <%# Wraps instead of truncating: a widget's answer („дължина: мм, м |
            маса: кг") cut to „дължина: мм, м | ма…" told the child nothing. %>
        <span class="max-w-[45%] shrink-0 text-right text-sm font-black break-words
                     <%= answer.pending_review? ? 'text-ink-600' : (answer.correct? ? 'text-green-700' : wrong_style) %>">
          <%= math_value(answer.value) %>
        </span>
      <% end %>
    <% end %>
  <% end %>

  <% if folded %>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-b from-transparent to-white"></div>
  <% end %>
</div>

<%# Outside the clipped box on purpose: overlaid on it, the link landed on top of
    whichever row the clip happened to cut through. %>
<% if folded %>
  <div class="border-b border-ink-50 py-1 text-center">
    <%= link_to t("summary.view_all"), assignment_path(assignment), class: "link-cta" %>
  </div>
<% end %>

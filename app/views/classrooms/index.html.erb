<div class="page">
  <header>
    <h1><%= t("classrooms.title") %></h1>
  </header>

  <main>
    <div class="flex flex-col gap-4 max-w-2xl">
      <div class="card">
        <header><strong><%= t("classrooms.join_title") %></strong></header>
        <section>
          <%= form_with url: join_classrooms_path, method: :post, class: "flex gap-3 items-end" do |f| %>
            <div class="flex-1">
              <%= label_tag :invite_code, t("classrooms.invite_code"), class: "block text-sm font-medium mb-1" %>
              <%= text_field_tag :invite_code, "", required: true, autocomplete: "off", class: "uppercase tracking-widest font-mono" %>
            </div>
            <%= f.submit t("classrooms.join"), class: "button button-primary" %>
          <% end %>
        </section>
      </div>

      <% if @classrooms.empty? %>
        <div class="alert-info"><div><div><p><%= t("classrooms.empty") %></p></div></div></div>
      <% end %>

      <% @classrooms.each do |classroom| %>
        <div class="card">
          <header class="flex justify-between items-center">
            <strong><%= classroom.name %></strong>
            <span class="text-sm text-gray-500"><%= t("classrooms.teacher") %>: <%= classroom.teacher.name %></span>
          </header>
          <% if classroom.leaderboard_enabled? %>
            <section>
              <h3 class="text-sm font-semibold text-gray-500 mb-3"><%= t("classrooms.weekly_leaderboard") %></h3>
              <ol class="space-y-1.5">
                <% Leaderboards.weekly_xp(classroom.students).each do |entry| %>
                  <li class="flex items-center gap-3 rounded-lg px-3 py-1.5 <%= 'bg-primary-50 font-semibold' if entry.user == current_user %>">
                    <span class="w-6 text-right font-bold text-gray-400"><%= entry.rank %></span>
                    <span class="flex-1"><%= entry.user.name %><%= " (#{t('classrooms.you')})" if entry.user == current_user %></span>
                    <span class="xp-pill">⭐ <%= entry.xp %></span>
                  </li>
                <% end %>
              </ol>
            </section>
          <% end %>
        </div>
      <% end %>
    </div>
  </main>
</div>

    "public": {
      "name": "Public pages",
      "description": "What a stranger can read before signing up",
      "features": {
        "landing": {
          "name": "Landing page",
          "match": [
            {
              "pageview": "/"
            }
          ]
        },
        "curriculum": {
          "name": "Curriculum",
          "match": [
            {
              "pageview": "/matematika*"
            }
          ]
        },
        "changelog": {
          "name": "What's new",
          "match": [
            {
              "pageview": "/changelog"
            }
          ]
        }
      }
    },

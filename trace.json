          "pageview": "/"
        },
        {
          "pageview": "/sign-up"
        },
        {
          "event": "signup"
        },
        {
          "pageview": "/placements/new"
        },
        {
          "pageview": "/placements/:id"
        }
      ]
    },
    "practice": {
      "name": "Home to a finished session",
      "description": "The student home page, a session started, problems answered, the session finished",
      "steps": [
        {
          "pageview": "/home"
        },
        {
          "event": "session_started"
        },
        {
          "event": "problem_answered"
        },
        {
          "event": "session_completed"
        }
      ]
    },
    "duel": {
      "name": "Home to a finished duel",
      "description": "The student home page, the duels page, a duel started, a result",
      "steps": [
        {
          "pageview": "/home"
        },
        {
          "pageview": "/challenges*"
        },
        {
          "event": "duel_started"
        },
        {
          "event": "duel_finished"
        }
      ]
    },
    "parent_goal": {
      "name": "Parent sets a goal",
      "description": "A parent's children pages, the new goal form, a goal set",
      "steps": [

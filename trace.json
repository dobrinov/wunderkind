              "pageview": "/review*"
            }
          ]
        },
        "placement": {
          "name": "Placement",
          "match": [
            {
              "pageview": "/placements*"
            }
          ]
        },
        "progress": {
          "name": "Calendar and stats",
          "match": [
            {
              "pageview": "/calendar*"
            },
            {
              "pageview": "/stats/*"
            },
            {
              "pageview": "/home/*"
            }
          ]
        }
      }
    },
    "battles": {

      "name": "Account",
      "features": {
        "signing_in": {
          "name": "Signing up and in",
          "match": [
            {
              "pageview": "/sign-up"
            },
            {
              "pageview": "/sign-in"
            },
            {
              "pageview": "/password_resets*"
            },
            {
              "pageview": "/verify-email*"
            }
          ]
        },
        "profile": {
          "name": "Profile and settings",
          "match": [
            {
              "pageview": "/profile*"
            },
            {
              "pageview": "/settings"
            }
          ]
        },
        "suggestions": {
          "name": "Suggesting problems",
          "match": [
            {
              "pageview": "/suggestions*"
            },
            {
              "event": "problem_suggested"
            }
          ]
        }
      }
    }
  },
  "audience": {
    "marketing": [
      "/",
      "/matematika*",
      "/sastezaniya*"
    ],
    "engaged": [

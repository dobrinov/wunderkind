          "match": [
            {
              "pageview": "/parents/children"
            },
            {
              "pageview": "/parents/children/new"
            },
            {
              "pageview": "/parents/children/:id"
            },
            {
              "pageview": "/parents/children/:id/stats/*"
            }
          ]
